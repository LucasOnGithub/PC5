 tests/test_pw_wine_sink.c                     |  6 +-
 .../patches/0911-win32u-ps5-dialog-keys.patch | 83 +++++++++++++++++++
 wine/ps5/pw_wine_sink.c                       |  3 +-
 wine/ps5/pw_wine_sink.h                       |  7 +-
 9 files changed, 152 insertions(+), 5 deletions(-)
 create mode 100644 wine/patches/0911-win32u-ps5-dialog-keys.patch

