diff --git a/native/pw_wine_display.c b/native/pw_wine_display.c
index 6113ac6..58fab4d 100644
--- a/native/pw_wine_display.c
+++ b/native/pw_wine_display.c
@@ -95,6 +95,23 @@ size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t
     return add_edges(input, pressed, 1, out, used, max);
 }
 
+/* Cross: Enter; the D-pad: the arrows (Windows virtual keys). */
+static const struct { uint32_t button, vk; } dialog_buttons[] = {
+    { 0x4000u, 0x0du }, { 0x10u, 0x26u }, { 0x40u, 0x28u }, { 0x80u, 0x25u }, { 0x20u, 0x27u },
+};
+
+size_t pw_wine_dialog_inputs(uint32_t pressed, uint32_t released, PwWineInput *out, size_t max)
+{
+    size_t used = 0;
+
+    if (!out) return 0;
+    for (uint32_t down = 0; down <= 1; down++)
+        for (size_t i = 0; i < sizeof(dialog_buttons) / sizeof(dialog_buttons[0]) && used < max; i++)
+            if ((down ? pressed : released) & dialog_buttons[i].button)
+                out[used++] = (PwWineInput){ PW_WINE_INPUT_DIALOG_KEY, dialog_buttons[i].vk, 0, 0, down };
+    return used;
+}
+
 static const struct { uint32_t dualsense; uint16_t xinput; } pad_buttons[] = {
     { 0x4000u, 0x1000u }, { 0x2000u, 0x2000u }, { 0x8000u, 0x4000u }, { 0x1000u, 0x8000u },
     { 0x400u, 0x0100u }, { 0x800u, 0x0200u }, { 0x2u, 0x0040u }, { 0x4u, 0x0080u },
diff --git a/native/pw_wine_display.h b/native/pw_wine_display.h
index d2aa275..a80671f 100644
--- a/native/pw_wine_display.h
+++ b/native/pw_wine_display.h
@@ -52,6 +52,13 @@ int pw_wine_frame_box_take(PwWineFrameBox *box, uint64_t *seen, uint8_t *out,
 size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t released,
                            PwWineInput *out, size_t max);
 
+/* xinput and dualsense modes, where the controller is no keyboard: Cross
+ * and the D-pad also answer a game's pop-up, as Enter and the arrow keys.
+ * They go as dialog keys, which Wine's driver sends only while a dialog box
+ * is in front, so the game never sees them as keys. Releases first, then
+ * presses; returns how many were written (at most max). */
+size_t pw_wine_dialog_inputs(uint32_t pressed, uint32_t released, PwWineInput *out, size_t max);
+
 /* The DualSense as an XInput gamepad: its held buttons (Cross A, Circle B,
  * Square X, Triangle Y, L1/R1 shoulders, L3/R3 thumbs, Options Start,
  * Create Back, the touchpad Guide), the analog triggers, and the sticks
diff --git a/native/wine64_main.c b/native/wine64_main.c
index 3a8bcdb..f9cc3bf 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -1678,6 +1678,17 @@ int main(int argc, char **argv)
                 if (post_input(&events[i]) == 0) posted++;
                 else refused++;
             }
+            /* The controller as the game's controller: Cross and the D-pad
+             * answer its pop-ups too (a dialog box only). */
+            if (game_input.mode != PW_GAME_INPUT_KEYBOARD) {
+                PwWineInput dialog[10];
+                size_t keys = pw_wine_dialog_inputs(pad.core.pressed_edges, pad.core.released_edges, dialog,
+                                                    sizeof(dialog) / sizeof(dialog[0]));
+                for (size_t i = 0; i < keys; i++) {
+                    if (post_input(&dialog[i]) == 0) posted++;
+                    else refused++;
+                }
+            }
             /* The rumble the game asked for: XInput's left motor is the
              * DualSense's large one, speeds 0..65535 become 0..255. */
             uint32_t left, right;
diff --git a/tests/test_pw_wine_display.c b/tests/test_pw_wine_display.c
index f195db0..dcce4d8 100644
--- a/tests/test_pw_wine_display.c
+++ b/tests/test_pw_wine_display.c
@@ -115,6 +115,24 @@ static void test_inputs(void)
     assert(pw_wine_game_inputs(NULL, L1, 0, events, 8) == 0 && pw_wine_game_inputs(&input, L1, 0, NULL, 8) == 0);
 }
 
+/* Cross and the D-pad as dialog keys: Enter and the arrows, releases first;
+ * other buttons send none. */
+static void test_dialog_inputs(void)
+{
+    enum { UP = 0x10u, RIGHT = 0x20u, DOWN = 0x40u, LEFT = 0x80u };
+    PwWineInput events[10];
+
+    assert(pw_wine_dialog_inputs(CROSS, 0, events, 10) == 1);
+    assert(events[0].type == PW_WINE_INPUT_DIALOG_KEY && events[0].code == 0x0d && events[0].down == 1);
+    assert(pw_wine_dialog_inputs(LEFT | UP, CROSS, events, 10) == 3);
+    assert(events[0].code == 0x0d && !events[0].down);
+    assert(events[1].code == 0x26 && events[1].down && events[2].code == 0x25 && events[2].down);
+    assert(pw_wine_dialog_inputs(RIGHT | DOWN, 0, events, 10) == 2 && events[0].code == 0x28 && events[1].code == 0x27);
+    assert(pw_wine_dialog_inputs(L1 | CIRCLE | SQUARE | R2, 0, events, 10) == 0);
+    assert(pw_wine_dialog_inputs(CROSS | UP, 0, events, 1) == 1 && events[0].code == 0x0d);
+    assert(pw_wine_dialog_inputs(CROSS, 0, NULL, 10) == 0);
+}
+
 static void test_pointer(void)
 {
     PwWinePointer pointer = { 0, 0 };
@@ -403,6 +421,7 @@ int main(void)
     test_frames();
     test_threads();
     test_inputs();
+    test_dialog_inputs();
     test_pointer();
     test_pointer_fraction();
     test_pad();
@@ -410,7 +429,8 @@ int main(void)
     test_stick_buttons();
     test_script_pad();
     printf("wine display passed: frame box copy, newest frame, refusals, concurrent put/take, "
-           "profile bindings to keys and mouse buttons, stick pointer, resized frames, "
+           "profile bindings to keys and mouse buttons, Cross and the D-pad as dialog keys, stick pointer, "
+           "resized frames, "
            "DualSense as XInput, stick directions as keys, scripted controller added to it\n");
     return 0;
 }
