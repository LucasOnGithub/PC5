     for(unsigned i=0;i<sizeof(bad)/sizeof(bad[0]);i++)assert(pw_wine_post_input(&bad[i])==-1);
     assert(pw_wine_post_input(NULL)==-1);
@@ -297,7 +301,7 @@ int main(void)
     for(int i=0;i<PW_WINE_INPUT_QUEUE;i++)assert(pw_wine_next_input(&out) && out.x==1 && out.y==2);
     assert(!pw_wine_next_input(&out));
     pw_wine_sink_stats(&s);
-    assert(s.inputs_posted==2+PW_WINE_INPUT_QUEUE && s.inputs_delivered==s.inputs_posted);
+    assert(s.inputs_posted==3+PW_WINE_INPUT_QUEUE && s.inputs_delivered==s.inputs_posted);
     assert(s.inputs_dropped==sizeof(bad)/sizeof(bad[0])+2);
 
     /* The wake pipe: readable after a post, empty once drained. */
diff --git a/wine/patches/0911-win32u-ps5-dialog-keys.patch b/wine/patches/0911-win32u-ps5-dialog-keys.patch
new file mode 100644
index 0000000..8d63949
--- /dev/null
+++ b/wine/patches/0911-win32u-ps5-dialog-keys.patch
@@ -0,0 +1,83 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sat, 24 Oct 2026 16:00:00 +0200
+Subject: [PATCH] win32u: Let the PS5 driver send keys that only a dialog box
+ takes.
+
+A game started with the controller as its XInput controller or its
+DualSense has no keyboard: a pop-up it shows before it starts (a
+minimum-specs warning, a "Yes/No" question) cannot be answered without
+one. Input type 4 is a key for a dialog box: the driver sends it as a
+key while the foreground window is a dialog box (the class DialogBox
+and MessageBox give their windows), and drops the press otherwise, so
+the game itself never sees it. A key sent down is always sent up, even
+once its dialog has closed, so no key stays held.
+---
+ dlls/win32u/ps5drv.c | 33 ++++++++++++++++++++++++++++++++-
+ 1 file changed, 32 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -65,7 +65,7 @@
+ /* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
+ struct ps5_input
+ {
+-    UINT type;              /* 1 key, 2 mouse move, 3 mouse button */
++    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 dialog key */
+     UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
+     INT  x, y;              /* mouse move: relative motion in desktop pixels */
+     UINT down;
+@@ -546,6 +546,39 @@
+     return FALSE;
+ }
+ 
++/* A dialog box: the class of every window DialogBox and MessageBox make. */
++static BOOL is_dialog( HWND hwnd )
++{
++    static const WCHAR dialogW[] = {'#','3','2','7','7','0'};
++    WCHAR buffer[16];
++    UNICODE_STRING name = {0, sizeof(buffer), buffer};
++
++    return hwnd && NtUserGetClassName( hwnd, FALSE, &name ) == ARRAY_SIZE(dialogW) &&
++           !memcmp( buffer, dialogW, sizeof(dialogW) );
++}
++
++/* The dialog keys sent down, so that each one's release is sent too, even
++ * once the dialog it pressed has gone. */
++static pthread_mutex_t dialog_lock = PTHREAD_MUTEX_INITIALIZER;
++static BYTE dialog_down[256];
++
++/* A dialog key (the title's controller buttons on a game's pop-up) is a
++ * key only while a dialog box is in front; a press is dropped otherwise. */
++static BOOL dialog_key( HWND hwnd, const struct ps5_input *event )
++{
++    BOOL send;
++
++    pthread_mutex_lock( &dialog_lock );
++    if (event->down) send = dialog_down[event->code] = is_dialog( hwnd );
++    else
++    {
++        send = dialog_down[event->code];
++        dialog_down[event->code] = 0;
++    }
++    pthread_mutex_unlock( &dialog_lock );
++    return send;
++}
++
+ static BOOL ps5_ProcessEvents( DWORD mask )
+ {
+     static const DWORD button_flags[3][2] =
+@@ -584,6 +617,9 @@
+         processed++;
+         switch (event.type)
+         {
++        case 4:
++            if (event.code > 255 || !dialog_key( hwnd, &event )) break;
++            /* fall through */
+         case 1:
+             input.ki.wVk = event.code;
+             input.ki.wScan = NtUserMapVirtualKeyEx( event.code, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
+-- 
+2.43.0
+
diff --git a/wine/ps5/pw_wine_sink.c b/wine/ps5/pw_wine_sink.c
index d2adce4..4219d62 100644
--- a/wine/ps5/pw_wine_sink.c
+++ b/wine/ps5/pw_wine_sink.c
@@ -100,7 +100,8 @@ int pw_wine_present(const void *bgra,uint32_t width,uint32_t height,uint32_t str
 static int valid(const PwWineInput *e)
 {
     switch(e->type) {
-    case PW_WINE_INPUT_KEY:return e->code>0 && e->code<256 && e->down<=1;
+    case PW_WINE_INPUT_KEY:
+    case PW_WINE_INPUT_DIALOG_KEY:return e->code>0 && e->code<256 && e->down<=1;
     case PW_WINE_INPUT_MOUSE_MOVE:return 1;
     case PW_WINE_INPUT_MOUSE_BUTTON:return e->code<=2 && e->down<=1;
     default:return 0;
diff --git a/wine/ps5/pw_wine_sink.h b/wine/ps5/pw_wine_sink.h
index 6022422..0d0d0f7 100644
--- a/wine/ps5/pw_wine_sink.h
+++ b/wine/ps5/pw_wine_sink.h
@@ -24,11 +24,14 @@
 typedef int (*PwWinePresentSink)(void *context,const void *bgra,uint32_t width,uint32_t height,
                                  uint32_t stride);
 
-enum { PW_WINE_INPUT_KEY=1,PW_WINE_INPUT_MOUSE_MOVE,PW_WINE_INPUT_MOUSE_BUTTON,
+/* DIALOG_KEY: a key the driver sends only while a dialog box is in front
+ * (Wine patch 0911), for answering a game's pop-up with the controller; a
+ * press is dropped otherwise, and a key sent down is always sent up. */
+enum { PW_WINE_INPUT_KEY=1,PW_WINE_INPUT_MOUSE_MOVE,PW_WINE_INPUT_MOUSE_BUTTON,PW_WINE_INPUT_DIALOG_KEY,
        PW_WINE_INPUT_QUEUE=256 };
 typedef struct PwWineInput {
     uint32_t type;
-    uint32_t code;      /* KEY: Windows virtual key; MOUSE_BUTTON: 0 left, 1 right, 2 middle */
+    uint32_t code;      /* KEY, DIALOG_KEY: Windows virtual key; MOUSE_BUTTON: 0 left, 1 right, 2 middle */
     int32_t x,y;        /* MOUSE_MOVE: relative motion in desktop pixels */
     uint32_t down;      /* KEY, MOUSE_BUTTON: 1 pressed, 0 released */
 } PwWineInput;
