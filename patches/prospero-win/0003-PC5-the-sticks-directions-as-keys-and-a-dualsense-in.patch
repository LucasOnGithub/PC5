+/* One axis's two directions: low is 0 (up, left), high 255 (down, right). */
+static uint32_t axis_buttons(uint8_t raw, uint32_t low, uint32_t high, uint32_t previous)
+{
+    int32_t d = (int32_t)raw - 0x80;
+    uint32_t out = 0;
+
+    if (d <= -PW_WINE_STICK_PRESS || (d <= -PW_WINE_STICK_RELEASE && (previous & low))) out |= low;
+    if (d >= PW_WINE_STICK_PRESS || (d >= PW_WINE_STICK_RELEASE && (previous & high))) out |= high;
+    return out;
+}
+
+uint32_t pw_wine_stick_buttons(const PwPadPs5 *pad, PwGameStick mouse, uint32_t previous)
+{
+    uint32_t out = 0;
+
+    if (!pad || !pad->core.connected) return 0;
+    if (mouse != PW_GAME_STICK_LEFT) {
+        out |= axis_buttons(pad->left_stick.x, PW_GAME_LEFT_STICK_LEFT, PW_GAME_LEFT_STICK_RIGHT, previous);
+        out |= axis_buttons(pad->left_stick.y, PW_GAME_LEFT_STICK_UP, PW_GAME_LEFT_STICK_DOWN, previous);
+    }
+    if (mouse != PW_GAME_STICK_RIGHT) {
+        out |= axis_buttons(pad->right_stick.x, PW_GAME_RIGHT_STICK_LEFT, PW_GAME_RIGHT_STICK_RIGHT, previous);
+        out |= axis_buttons(pad->right_stick.y, PW_GAME_RIGHT_STICK_UP, PW_GAME_RIGHT_STICK_DOWN, previous);
+    }
+    return out;
+}
+
 /* Signed 1/65536-pixel travel of one axis. */
 static int64_t travel(uint8_t stick, uint32_t speed, uint32_t elapsed_us)
 {
