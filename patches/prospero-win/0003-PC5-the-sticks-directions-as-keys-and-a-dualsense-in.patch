+/* How far a stick goes (of 128) before its direction counts as pressed, and
+ * how far back it must come to count as released, so a stick held near the
+ * edge does not chatter. */
+enum { PW_WINE_STICK_PRESS = 64, PW_WINE_STICK_RELEASE = 48 };
