+ * diagonals both. previous is the last result, for the release threshold.
+ * The stick the pointer follows (mouse) gives none, nor does a pad that is
+ * not connected. */
+uint32_t pw_wine_stick_buttons(const PwPadPs5 *pad, PwGameStick mouse, uint32_t previous);
 #endif
