+/* The sticks' directions as buttons, with a release threshold below the
+ * press one, the pointer's stick left out, and nothing while disconnected. */
+static void test_stick_buttons(void)
+{
+    PwPadPs5 pad;
+    uint32_t held;
+    PwGameInput input;
+    PwWineInput events[8];
+
+    memset(&pad, 0, sizeof(pad));
+    pad.left_stick = pad.right_stick = (PwPadPs5Stick){ 0x80, 0x80 };
+    pad.left_stick.x = 0x00;
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, 0) == 0);          /* disconnected */
+    pad.core.connected = 1;
+    assert(pw_wine_stick_buttons(NULL, PW_GAME_STICK_NONE, 0) == 0);
+    /* Centred: none; just short of the press threshold: none. */
+    pad.left_stick = (PwPadPs5Stick){ 0x80, 0x80 };
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, 0) == 0);
+    pad.left_stick.x = 0x80 + PW_WINE_STICK_PRESS - 1;
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, 0) == 0);
+    /* At the threshold: right; it stays down back to the release threshold, then goes. */
+    pad.left_stick.x = 0x80 + PW_WINE_STICK_PRESS;
+    held = pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, 0);
+    assert(held == PW_GAME_LEFT_STICK_RIGHT);
+    pad.left_stick.x = 0x80 + PW_WINE_STICK_RELEASE;
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, held) == PW_GAME_LEFT_STICK_RIGHT);
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, 0) == 0);          /* not held: not pressed */
+    pad.left_stick.x = 0x80 + PW_WINE_STICK_RELEASE - 1;
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, held) == 0);
+    /* Each direction of both sticks, and a diagonal. */
+    pad.left_stick = (PwPadPs5Stick){ 0x00, 0xff };      /* left, down */
+    pad.right_stick = (PwPadPs5Stick){ 0xff, 0x00 };     /* right, up */
+    held = pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, 0);
+    assert(held == (PW_GAME_LEFT_STICK_LEFT | PW_GAME_LEFT_STICK_DOWN | PW_GAME_RIGHT_STICK_RIGHT |
+                    PW_GAME_RIGHT_STICK_UP));
+    pad.left_stick = (PwPadPs5Stick){ 0xff, 0x00 };
+    pad.right_stick = (PwPadPs5Stick){ 0x00, 0xff };
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, held) ==
+           (PW_GAME_LEFT_STICK_RIGHT | PW_GAME_LEFT_STICK_UP | PW_GAME_RIGHT_STICK_LEFT | PW_GAME_RIGHT_STICK_DOWN));
+    /* The pointer's stick sends no directions. */
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_RIGHT, 0) == (PW_GAME_LEFT_STICK_RIGHT | PW_GAME_LEFT_STICK_UP));
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_LEFT, 0) == (PW_GAME_RIGHT_STICK_LEFT | PW_GAME_RIGHT_STICK_DOWN));
+    pad.core.connected = 0;
+    assert(pw_wine_stick_buttons(&pad, PW_GAME_STICK_NONE, held) == 0);       /* unplugged: all released */
+
+    /* Bound in a keyboard profile, a direction is a key like a button. */
+    static const char text[] = "[input]\nmode = keyboard\nleft_stick_up = w\nleft_stick_left = a\n"
+                               "right_stick_down = down\n";
+    pw_game_input_init(&input);
+    assert(pw_game_input_parse((const uint8_t *)text, sizeof(text) - 1, &input) == PW_OK);
+    assert(pw_wine_game_inputs(&input, PW_GAME_LEFT_STICK_UP | PW_GAME_LEFT_STICK_LEFT, 0, events, 8) == 2);
+    assert(events[0].type == PW_WINE_INPUT_KEY && events[0].down == 1);
+    assert((events[0].code == 'W' && events[1].code == 'A') || (events[0].code == 'A' && events[1].code == 'W'));
+    assert(pw_wine_game_inputs(&input, PW_GAME_RIGHT_STICK_DOWN, PW_GAME_LEFT_STICK_UP, events, 8) == 2);
+    assert(events[0].code == 'W' && events[0].down == 0 && events[1].code == 0x28 && events[1].down == 1);
+    assert(pw_wine_game_inputs(&input, PW_GAME_RIGHT_STICK_UP, 0, events, 8) == 0);   /* unbound */
+}
