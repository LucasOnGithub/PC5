+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Sat, 24 Oct 2026 00:50:00 +0100
+Subject: [PATCH] kernelbase: The computer name without wineboot.
+
+Unrailed 2: Back on Track stopped at its start on the console because
+GetComputerNameW failed with ERROR_FILE_NOT_FOUND.
+
+The NetBIOS name is read from the ActiveComputerName key, a volatile key
+wineboot writes from the configured name each time a prefix starts. A
+PS5 title starts no processes, so wineboot never runs there and the key
+is never made. When it is missing, the configured name (ComputerName\
+ComputerName, which the prefix keeps) is read instead, as wineboot
+would have copied it. Where wineboot ran, the key is there and nothing
+changes.
+---
+ dlls/kernelbase/registry.c | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/kernelbase/registry.c b/dlls/kernelbase/registry.c
+index 7ec30c2..261963a 100644
+--- a/dlls/kernelbase/registry.c
++++ b/dlls/kernelbase/registry.c
+@@ -3312,6 +3312,7 @@ BOOL WINAPI GetComputerNameExA( COMPUTER_NAME_FORMAT type, char *name, DWORD *le
+ BOOL WINAPI GetComputerNameExW( COMPUTER_NAME_FORMAT type, WCHAR *name, DWORD *len )
+ {
+     const WCHAR *keyname, *valuename;
++    BOOL netbios = FALSE;
+     LRESULT ret;
+     HKEY key;
+ 
+@@ -3321,6 +3322,7 @@ BOOL WINAPI GetComputerNameExW( COMPUTER_NAME_FORMAT type, WCHAR *name, DWORD *l
+     case ComputerNamePhysicalNetBIOS:
+         keyname = L"System\\CurrentControlSet\\Control\\ComputerName\\ActiveComputerName";
+         valuename = L"ComputerName";
++        netbios = TRUE;
+         break;
+     case ComputerNameDnsHostname:
+     case ComputerNamePhysicalDnsHostname:
+@@ -3360,7 +3362,13 @@ BOOL WINAPI GetComputerNameExW( COMPUTER_NAME_FORMAT type, WCHAR *name, DWORD *l
+         return FALSE;
+     }
+ 
+-    if (!(ret = RegOpenKeyExW( HKEY_LOCAL_MACHINE, keyname, 0, KEY_READ, &key )))
++    ret = RegOpenKeyExW( HKEY_LOCAL_MACHINE, keyname, 0, KEY_READ, &key );
++    /* wineboot sets the active name at each start; where it cannot run (a
++     * PS5 title starts no processes) the configured name is the active one */
++    if (ret == ERROR_FILE_NOT_FOUND && netbios)
++        ret = RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\ComputerName\\ComputerName",
++                             0, KEY_READ, &key );
++    if (!ret)
+     {
+         DWORD size = *len * sizeof(WCHAR);
+         ret = RegQueryValueExW( key, valuename, NULL, NULL, (BYTE *)name, &size );
