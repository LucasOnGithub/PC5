diff --git a/tests/test_pw_players_ps5.c b/tests/test_pw_players_ps5.c
new file mode 100644
index 0000000..adc9143
--- /dev/null
+++ b/tests/test_pw_players_ps5.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../native/pw_players_ps5.h"
+#include <assert.h>
+#include <string.h>
+
+/* A console with users signed in and out: user 42 started the title. A
+ * controller's handle is 100 plus its user; user 77's is refused while
+ * refuse_77 is set. */
+static int32_t signed_in[PW_PAD_PS5_USERS]={42,-1,-1,-1};
+static int list_rc,refuse_77,opens,closes,reads;
+static int closed[256];
+static uint8_t motors[256][2];
+static PwPadPs5Data sample;
+static char last_line[160];
+static int lines;
+
+static int user_initialize(const void *p){(void)p;assert(!"players don't start the user service");return 0;}
+static int foreground(int32_t *u){(void)u;assert(!"players don't ask for the foreground user");return 0;}
+static int terminate(void){assert(!"players don't end the user service");return 0;}
+static int pad_init(void){assert(!"players don't start the pad library");return 0;}
+static int pad_open(int32_t u,int32_t t,int32_t i,const void *p)
+{
+    assert(!t && !i && !p && u>=0 && u<150);opens++;
+    return refuse_77 && u==77 ? -0x7f0 : 100+u;
+}
+static int pad_read(int32_t h,PwPadPs5Data *s,int32_t n)
+{
+    assert(h>=100 && n==PW_PAD_PS5_BATCH);reads++;
+    s[0]=sample;return 1;
+}
+static int pad_close(int32_t h){assert(h>=100 && !closed[h]);closed[h]++;closes++;return 0;}
+static int set_vibration(int32_t h,const uint8_t m[2]){memcpy(motors[h],m,2);return 0;}
+static int login_users(int32_t users[]){memcpy(users,signed_in,sizeof(signed_in));return list_rc;}
+static void log_line(const char *line){strncpy(last_line,line,sizeof(last_line)-1);lines++;}
+
+static const PwPadPs5Ops ops={user_initialize,foreground,terminate,pad_init,pad_open,pad_read,pad_close,
+                              set_vibration,NULL,login_users};
+static const PwPadKeyMap map[]={{0x400,'Z',0,0,"left-flipper"}};
+
+int main(void)
+{
+    static PwPlayersPs5 players;
+    PwPadPs5Ops no_list=ops;
+
+    no_list.login_users=NULL;
+    assert(pw_players_ps5_start(&players,&no_list,map,1,42,log_line)==PW_ERR_UNSUPPORTED);
+    assert(!pw_players_ps5_update(&players,0) && !pw_players_ps5_pad(&players,1));
+    assert(pw_players_ps5_start(&players,&ops,map,1,-1,log_line)==PW_ERR_PRECONDITION);
+    assert(pw_players_ps5_start(&players,&ops,map,1,42,log_line)==PW_OK);
+
+    /* Only player 1 signed in: nobody joins, the first look is at once. */
+    assert(!pw_players_ps5_update(&players,5) && players.scans==1 && !opens);
+    assert(pw_players_ps5_count(&players)==1 && !pw_players_ps5_pad(&players,0));
+    /* A second user signs in: they become player 2, at the next look a second later. */
+    signed_in[2]=55;
+    assert(!pw_players_ps5_update(&players,5+PW_PLAYERS_PS5_SCAN_US-1) && players.scans==1);
+    assert(pw_players_ps5_update(&players,5+PW_PLAYERS_PS5_SCAN_US)==(1u<<1));
+    PwPadPs5 *two=pw_players_ps5_pad(&players,1);
+    assert(two && two->user_id==55 && two->pad_handle==155 && opens==1);
+    assert(strstr(last_line,"player 2 joined: user 55 handle=155"));
+    assert(pw_players_ps5_count(&players)==2);
+    /* Their controller reads like player 1's. */
+    sample=(PwPadPs5Data){.buttons=0x4000,.left_stick={10,250},.right_stick={0x80,0x80},.connected=1,
+                          .timestamp=1000,.connected_count=1};
+    assert(pw_pad_ps5_read(two)==PW_OK && two->core.connected && (two->core.previous_buttons&0x4000) &&
+           two->left_stick.x==10 && reads==1);
+    assert(pw_pad_ps5_vibrate(two,200,100)==PW_OK && motors[155][0]==200 && motors[155][1]==100);
+    /* Looking again changes nothing. */
+    assert(!pw_players_ps5_update(&players,10*PW_PLAYERS_PS5_SCAN_US) && opens==1);
+    /* Two more: the third is refused at first, then asked again; the log says so once. */
+    signed_in[1]=66;signed_in[3]=77;refuse_77=1;
+    int before=lines;
+    assert(pw_players_ps5_update(&players,20*PW_PLAYERS_PS5_SCAN_US)==(1u<<2));
+    assert(pw_players_ps5_pad(&players,2)->user_id==66 && !pw_players_ps5_pad(&players,3));
+    assert(strstr(last_line,"player 4: the console refused user 77's controller") && players.refusals==1);
+    int after=lines;
+    assert(after>before);
+    assert(!pw_players_ps5_update(&players,21*PW_PLAYERS_PS5_SCAN_US) && players.refusals==2 && lines==after);
+    refuse_77=0;
+    assert(pw_players_ps5_update(&players,22*PW_PLAYERS_PS5_SCAN_US)==(1u<<3));
+    assert(pw_players_ps5_pad(&players,3)->user_id==77 && pw_players_ps5_count(&players)==4);
+    /* Player 2 signs out: their place is let go, their motors stopped first. */
+    signed_in[2]=-1;
+    assert(pw_players_ps5_update(&players,23*PW_PLAYERS_PS5_SCAN_US)==(1u<<1));
+    assert(!pw_players_ps5_pad(&players,1) && closed[155]==1 && !motors[155][0] && !motors[155][1]);
+    assert(strstr(last_line,"player 2 left: user 55 signed out"));
+    /* A new user takes the first free place, 2, while 3 and 4 keep theirs. */
+    signed_in[2]=88;
+    assert(pw_players_ps5_update(&players,24*PW_PLAYERS_PS5_SCAN_US)==(1u<<1));
+    assert(pw_players_ps5_pad(&players,1)->user_id==88 && pw_players_ps5_pad(&players,2)->user_id==66 &&
+           pw_players_ps5_pad(&players,3)->user_id==77);
+    /* A list that can't be read changes nothing, and is said once. */
+    list_rc=-1;before=lines;
+    assert(!pw_players_ps5_update(&players,25*PW_PLAYERS_PS5_SCAN_US) && lines==before+1);
+    assert(!pw_players_ps5_update(&players,26*PW_PLAYERS_PS5_SCAN_US) && lines==before+1);
+    assert(pw_players_ps5_count(&players)==4);
+    list_rc=0;
+    /* The end closes players 2 to 4, and only theirs. */
+    int closes_before=closes;
+    pw_players_ps5_stop(&players);
+    assert(closes==closes_before+3 && closed[188]==1 && closed[166]==1 && closed[177]==1);
+    assert(!pw_players_ps5_pad(&players,1) && !pw_players_ps5_update(&players,30*PW_PLAYERS_PS5_SCAN_US));
+    pw_players_ps5_stop(&players);
+    assert(closes==closes_before+3);
+    return 0;
+}
diff --git a/tests/test_pw_wine_sink.c b/tests/test_pw_wine_sink.c
index d533f4c..4e9fd45 100644
--- a/tests/test_pw_wine_sink.c
+++ b/tests/test_pw_wine_sink.c
@@ -200,6 +200,37 @@ static uint64_t now_ns(void)
 
 /* The DualSense: numbered like the pad, but time alone is not a change;
  * a game's output reports are kept until the title reads them. */
+/* Four players: each controller has its own slot, packets and rumble, and
+ * player 0's is the one the older calls reach. */
+static void test_players(void)
+{
+    PwWinePad pad={0},got;
+    uint32_t left,right;
+
+    for(uint32_t i=1;i<PW_WINE_PADS;i++)assert(!pw_wine_pad_at(i,&got) && !got.connected && !got.packet);
+    pad.buttons=0x1000;pw_wine_set_pad_at(2,&pad);
+    assert(pw_wine_pad_at(2,&got) && got.connected==1 && got.packet==1 && got.buttons==0x1000);
+    assert(!pw_wine_pad_at(1,&got) && !pw_wine_pad_at(3,&got));
+    pad.buttons=0x2000;pw_wine_set_pad_at(0,&pad);
+    assert(pw_wine_pad(&got) && got.buttons==0x2000 && pw_wine_pad_at(0,&got) && got.buttons==0x2000);
+    assert(pw_wine_pad_at(2,&got) && got.buttons==0x1000 && got.packet==1);   /* player 3 kept his */
+    pad.buttons=0x1001;pw_wine_set_pad_at(2,&pad);assert(pw_wine_pad_at(2,&got) && got.packet==2);
+    pw_wine_set_pad_at(2,NULL);assert(!pw_wine_pad_at(2,&got) && !got.buttons);
+    assert(pw_wine_pad(&got) && got.buttons==0x2000);
+    /* out of range: nothing there, nothing kept */
+    pw_wine_set_pad_at(PW_WINE_PADS,&pad);assert(!pw_wine_pad_at(PW_WINE_PADS,&got) && !got.connected);
+    assert(!pw_wine_pad_at(1,NULL));
+    pw_wine_set_rumble_at(3,500,600);
+    assert(!pw_wine_rumble_at(1,&left,&right) && left==0 && right==0);
+    assert(pw_wine_rumble_at(3,&left,&right)==1 && left==500 && right==600);
+    assert(!pw_wine_rumble_at(3,&left,&right) && left==500);
+    pw_wine_set_rumble_at(1,0x20000,1);assert(pw_wine_rumble_at(1,&left,NULL)==1 && left==0xffff);
+    pw_wine_set_rumble(7,8);assert(pw_wine_rumble_at(0,&left,&right)==1 && left==7 && right==8);
+    pw_wine_set_rumble_at(PW_WINE_PADS,1,1);
+    assert(!pw_wine_rumble_at(PW_WINE_PADS,&left,&right) && !left && !right);
+    pw_wine_set_pad_at(0,NULL);
+}
+
 static void test_dualsense(void)
 {
     PwDualSenseState state,got;
@@ -358,5 +389,6 @@ int main(void)
     assert(!pw_wine_rumble(&left,NULL) && left==0xffff);
     test_dualsense();
     test_display_release();
+    test_players();
     return 0;
 }
