diff --git a/native/pw_players_ps5.c b/native/pw_players_ps5.c
new file mode 100644
index 0000000..06841f3
--- /dev/null
+++ b/native/pw_players_ps5.c
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_players_ps5.h"
+#include <stdio.h>
+#include <string.h>
+
+static void say(const PwPlayersPs5 *players,const char *line)
+{
+    if(players->log)players->log(line);
+}
+
+int pw_players_ps5_start(PwPlayersPs5 *players,const PwPadPs5Ops *ops,const PwPadKeyMap *map,
+                         size_t map_count,int32_t owner,PwPlayersPs5Log log)
+{
+    if(!players || !ops || owner<0)return PW_ERR_PRECONDITION;
+    memset(players,0,sizeof(*players));
+    if(!ops->login_users || !ops->pad_open || !ops->pad_read || !ops->pad_close)return PW_ERR_UNSUPPORTED;
+    players->ops=*ops;players->map=map;players->map_count=map_count;players->log=log;players->owner=owner;
+    for(int i=0;i<PW_PLAYERS_PS5_MAX;i++){players->refused[i]=-1;players->pads[i].pad_handle=-1;}
+    for(int i=0;i<PW_PAD_PS5_USERS;i++)players->signed_in[i]=-1;
+    players->started=1;
+    return PW_OK;
+}
+
+static int listed(const int32_t list[],int32_t user)
+{
+    for(int i=0;i<PW_PAD_PS5_USERS;i++)
+        if(list[i]>=0 && list[i]==user)return 1;
+    return 0;
+}
+
+static int placed(const PwPlayersPs5 *players,int32_t user)
+{
+    for(unsigned place=1;place<PW_PLAYERS_PS5_MAX;place++)
+        if(players->pads[place].opened && players->pads[place].user_id==user)return 1;
+    return 0;
+}
+
+static void leave(PwPlayersPs5 *players,unsigned place,const char *why)
+{
+    char line[96];
+    int32_t user=players->pads[place].user_id;
+    /* The motors stop first: a closed controller keeps what it was last told. */
+    (void)pw_pad_ps5_vibrate(&players->pads[place],0,0);
+    (void)pw_pad_ps5_close(&players->pads[place]);
+    players->pads[place].pad_handle=-1;
+    players->leaves++;
+    snprintf(line,sizeof(line),"PW_WINE64 player %u left: user %d %s",place+1,(int)user,why);
+    say(players,line);
+}
+
+unsigned pw_players_ps5_update(PwPlayersPs5 *players,uint64_t now_us)
+{
+    int32_t list[PW_PAD_PS5_USERS];
+    unsigned changed=0;
+    char line[128];
+
+    if(!players || !players->started)return 0;
+    if(players->scans && now_us<players->next_scan_us)return 0;
+    players->next_scan_us=now_us+PW_PLAYERS_PS5_SCAN_US;
+    players->scans++;
+    for(int i=0;i<PW_PAD_PS5_USERS;i++)list[i]=-1;
+    int rc=players->ops.login_users(list);
+    if(rc<0) {
+        if(!players->list_failed++) {
+            snprintf(line,sizeof(line),"PW_WINE64 players: the signed-in users can't be read rc=%d",rc);
+            say(players,line);
+        }
+        return 0;
+    }
+    if(memcmp(list,players->signed_in,sizeof(list))) {
+        memcpy(players->signed_in,list,sizeof(list));
+        snprintf(line,sizeof(line),"PW_WINE64 players signed in: %d %d %d %d",(int)list[0],(int)list[1],
+                 (int)list[2],(int)list[3]);
+        say(players,line);
+    }
+    /* Places whose users signed out are let go first, so a user who signs in
+     * at the same moment can take one. */
+    for(unsigned place=1;place<PW_PLAYERS_PS5_MAX;place++)
+        if(players->pads[place].opened && !listed(list,players->pads[place].user_id)) {
+            leave(players,place,"signed out");
+            changed|=1u<<place;
+        }
+    for(int i=0;i<PW_PAD_PS5_USERS;i++) {
+        int32_t user=list[i];
+        unsigned place=1;
+        if(user<0 || user==players->owner || placed(players,user))continue;
+        while(place<PW_PLAYERS_PS5_MAX && players->pads[place].opened)place++;
+        if(place==PW_PLAYERS_PS5_MAX)break;   /* four players already */
+        PwPadPs5 *pad=&players->pads[place];
+        int status=pw_pad_ps5_open_user(pad,&players->ops,players->map,players->map_count,user);
+        if(status==PW_OK) {
+            players->joins++;players->refused[place]=-1;changed|=1u<<place;
+            snprintf(line,sizeof(line),"PW_WINE64 player %u joined: user %d handle=%d",place+1,(int)user,
+                     (int)pad->pad_handle);
+            say(players,line);
+        }
+        else {
+            players->refusals++;
+            if(players->refused[place]!=user) {
+                players->refused[place]=user;
+                snprintf(line,sizeof(line),"PW_WINE64 player %u: the console refused user %d's controller rc=%d",
+                         place+1,(int)user,(int)pad->pad_handle);
+                say(players,line);
+            }
+            memset(pad,0,sizeof(*pad));pad->pad_handle=-1;
+        }
+    }
+    return changed;
+}
+
+PwPadPs5 *pw_players_ps5_pad(PwPlayersPs5 *players,unsigned place)
+{
+    if(!players || place<1 || place>=PW_PLAYERS_PS5_MAX || !players->pads[place].opened)return NULL;
+    return &players->pads[place];
+}
+
+unsigned pw_players_ps5_count(const PwPlayersPs5 *players)
+{
+    unsigned count=1;
+    if(!players)return 0;
+    for(unsigned place=1;place<PW_PLAYERS_PS5_MAX;place++)
+        if(players->pads[place].opened)count++;
+    return count;
+}
+
+void pw_players_ps5_stop(PwPlayersPs5 *players)
+{
+    if(!players || !players->started)return;
+    for(unsigned place=1;place<PW_PLAYERS_PS5_MAX;place++)
+        if(players->pads[place].opened)leave(players,place,"at the end");
+    players->started=0;
+}
diff --git a/native/pw_players_ps5.h b/native/pw_players_ps5.h
new file mode 100644
index 0000000..7d00fd4
--- /dev/null
+++ b/native/pw_players_ps5.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_PLAYERS_PS5_H
+#define PW_PLAYERS_PS5_H
+#include "pw_pad_ps5.h"
+
+/* Players 2 to 4. On the PS5 each controller belongs to a signed-in user,
+ * and a title opens a user's controller by that user (scePadOpen). Player 1
+ * is the title's own controller, the one pw_pad_ps5_open opened. Once a
+ * second the signed-in users are read again: a user without a place takes
+ * the first free one, 2 to 4, and keeps it while signed in, and a place is
+ * let go when its user signs out. A user whose controller the console
+ * refuses is asked again at the next look. Places are numbered from 0, as
+ * XInput numbers its controllers: place 0 is player 1's and never used here. */
+enum { PW_PLAYERS_PS5_MAX=PW_PAD_PS5_USERS,PW_PLAYERS_PS5_SCAN_US=1000000 };
+
+/* One line for the log, without its end of line. */
+typedef void (*PwPlayersPs5Log)(const char *line);
+
+typedef struct PwPlayersPs5 {
+    PwPadPs5Ops ops;
+    const PwPadKeyMap *map;size_t map_count;
+    PwPlayersPs5Log log;
+    int32_t owner;                          /* player 1's user */
+    PwPadPs5 pads[PW_PLAYERS_PS5_MAX];      /* places 1 to 3: open while a player is there */
+    int32_t refused[PW_PLAYERS_PS5_MAX];    /* the user last refused there, so the log says it once */
+    int32_t signed_in[PW_PAD_PS5_USERS];    /* the list read last */
+    uint64_t next_scan_us;
+    unsigned started,list_failed;
+    uint64_t scans,joins,leaves,refusals;
+} PwPlayersPs5;
+
+/* PW_OK, PW_ERR_PRECONDITION, or PW_ERR_UNSUPPORTED when the ops can't list
+ * the signed-in users. owner is player 1's user; log may be NULL. */
+int pw_players_ps5_start(PwPlayersPs5 *players,const PwPadPs5Ops *ops,const PwPadKeyMap *map,
+                         size_t map_count,int32_t owner,PwPlayersPs5Log log);
+/* Reads the signed-in users when a second has passed since the last look
+ * (the first call always looks), and opens and closes controllers to
+ * match. Returns the places that changed: bit i for place i, which a player
+ * joined or left. */
+unsigned pw_players_ps5_update(PwPlayersPs5 *players,uint64_t now_us);
+/* Place 1 to 3's controller while a player is there, else NULL. */
+PwPadPs5 *pw_players_ps5_pad(PwPlayersPs5 *players,unsigned place);
+/* How many players there are, player 1 counted. */
+unsigned pw_players_ps5_count(const PwPlayersPs5 *players);
+/* Closes the controllers of players 2 to 4. */
+void pw_players_ps5_stop(PwPlayersPs5 *players);
+
+#endif
