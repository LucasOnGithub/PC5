diff --git a/wine/patches/0926-xinput-windows-gaming-input-up-to-four-ps5-title-controllers.patch b/wine/patches/0926-xinput-windows-gaming-input-up-to-four-ps5-title-controllers.patch
new file mode 100644
index 0000000..1136c3d
--- /dev/null
+++ b/wine/patches/0926-xinput-windows-gaming-input-up-to-four-ps5-title-controllers.patch
@@ -0,0 +1,400 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 25 Oct 2026 21:00:00 +0000
+Subject: [PATCH] xinput, windows.gaming.input: Up to four PS5 title controllers.
+
+On the PS5 each controller belongs to a signed-in user. A title that
+opens other signed-in users' controllers beside its own keeps each one's
+state in its sink, one a player (pw_wine_pad_at, pw_wine_set_rumble_at in
+ntdll.prx). The Unix library reads and rumbles them by XInput's index,
+and xinput makes them controllers 0 to 3 in place of controller 0 alone:
+XInputGetState(Ex), XInputSetState, XInputGetCapabilities(Ex) and the
+rest answer for each, and each keeps the rumble asked of it. A title
+without them still has its controller 0 only.
+
+Windows.Gaming.Input's provider follows each of the four the same way: a
+game finds a Gamepad for each player whose controller is connected, which
+comes and goes with it, and its rumble reaches that player's controller.
+---
+ dlls/xinput1_3/main.c                 |   37 ++++++++-------
+ dlls/xinput1_3/unixlib.c              |   38 +++++++++++++++
+ dlls/xinput1_3/unixlib.h              |   16 ++++++
+ dlls/windows.gaming.input/title_pad.c |   83 +++++++++++++++++++--------------
+ 4 files changed, 122 insertions(+), 52 deletions(-)
+
+diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
+--- a/dlls/xinput1_3/main.c
++++ b/dlls/xinput1_3/main.c
+@@ -105,15 +105,15 @@
+ static SRWLOCK state_lock = SRWLOCK_INIT;
+ static XINPUT_STATE current_state[XUSER_MAX_COUNT];
+ 
+-/* A PS5 title's controller: Wine runs in the title's process, with no
+- * winedevice for a HID stack, and the title keeps its DualSense's state
++/* A PS5 title's controllers: Wine runs in the title's process, with no
++ * winedevice for a HID stack, and the title keeps its controllers' state
+  * where the Unix library (xinput1_3.so, loaded by name so that every
+- * xinput built from this source shares it) reads it. It is controller 0
+- * in place of HID devices; anywhere else the library finds no title and
+- * xinput uses HID. */
++ * xinput built from this source shares it) reads it. Controller 0 is the
++ * title's own, 1 to 3 other signed-in users', in place of HID devices;
++ * anywhere else the library finds no title and xinput uses HID. */
+ static unixlib_handle_t title_pad;
+ static BOOL title_pad_enabled = TRUE;
+-static XINPUT_VIBRATION title_pad_vibration;
++static XINPUT_VIBRATION title_pad_vibration[XUSER_MAX_COUNT];
+ 
+ static BOOL WINAPI find_title_pad(INIT_ONCE *once, void *param, void **context)
+ {
+@@ -133,7 +133,7 @@
+         __wine_unload_unix_lib(module);
+         return TRUE;
+     }
+-    TRACE("controller 0 is the title's\n");
++    TRACE("controllers 0 to 3 are the title's\n");
+     title_pad = handle;
+     return TRUE;
+ }
+@@ -147,9 +147,12 @@
+ 
+ static BOOL title_pad_state(DWORD index, XINPUT_STATE *state)
+ {
+-    struct xinput_pad_state pad = {0};
++    struct xinput_pad_state_params params = {.index = index};
++    struct xinput_pad_state pad;
+ 
+-    if (index || __wine_unix_call(title_pad, unix_pad_state, &pad) || !pad.connected) return FALSE;
++    if (index >= XUSER_MAX_COUNT || __wine_unix_call(title_pad, unix_pad_state_at, &params) ||
++        !params.state.connected) return FALSE;
++    pad = params.state;
+     memset(state, 0, sizeof(*state));
+     state->dwPacketNumber = pad.packet;
+     if (!title_pad_enabled) return TRUE;  /* XInputEnable(FALSE): neutral, still connected */
+@@ -164,16 +167,16 @@
+ }
+ 
+ /* xinput_cs must be held */
+-static void title_pad_rumble(void)
++static void title_pad_rumble(DWORD index)
+ {
+-    struct xinput_rumble_params params = {0};
++    struct xinput_rumble_at_params params = {.index = index};
+ 
+     if (title_pad_enabled)
+     {
+-        params.left = title_pad_vibration.wLeftMotorSpeed;
+-        params.right = title_pad_vibration.wRightMotorSpeed;
++        params.left = title_pad_vibration[index].wLeftMotorSpeed;
++        params.right = title_pad_vibration[index].wRightMotorSpeed;
+     }
+-    __wine_unix_call(title_pad, unix_pad_rumble, &params);
++    __wine_unix_call(title_pad, unix_pad_rumble_at, &params);
+ }
+ 
+ static void set_current_state(UINT index, const XINPUT_STATE *state)
+@@ -907,7 +910,7 @@
+     {
+         EnterCriticalSection(&xinput_cs);
+         title_pad_enabled = enable;
+-        title_pad_rumble();
++        for (index = 0; index < XUSER_MAX_COUNT; index++) title_pad_rumble(index);
+         LeaveCriticalSection(&xinput_cs);
+         return;
+     }
+@@ -936,8 +939,8 @@
+         if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
+         if (!title_pad_state(index, &state)) return ERROR_DEVICE_NOT_CONNECTED;
+         EnterCriticalSection(&xinput_cs);
