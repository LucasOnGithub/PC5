index 0000000..6767e2f
--- /dev/null
+++ b/wine/ps5/pw_framegen.cpp
@@ -0,0 +1,633 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Frame generation in libvulkan.prx (pw_framegen.h): ps5-framegen's
+ * interpolator (GPL-3.0-or-later, https://github.com/Swordpdf/ps5-framegen)
+ * between a game's swapchain and RADV's presents.
+ *
+ * For each frame of the game, on the queue it presents on and after what the
+ * game's present waited for: the frame is copied into the interpolator,
+ * which makes the frame halfway between it and the one before; that one is
+ * put in a second image of the swapchain and presented first, then the
+ * game's own. The swapchain is made with one image more for it, and with
+ * transfer usage. The game is held at half the display's rate, less 0.05 fps
+ * (ps5-framegen's latency hold), by sleeping before its present, so FIFO
+ * never queues: each of its frames is two refreshes, one of them generated.
+ * A game whose frames come later than that is shown as it is, and frames
+ * are generated again once eight in a row keep time; the first of those
+ * only primes the interpolator (its reset). */
+#include "pw_framegen.h"
+#include "pw_framegen_vk.h"
+#include "ps5_framegen.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <string>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance, const char *name);
+extern "C" PFN_vkVoidFunction VKAPI_CALL vk_common_GetDeviceProcAddr(VkDevice device, const char *name);
+
+struct pw_framegen_vk pw_framegen_vk;
+
+namespace
+{
+constexpr double k_display_hz = 59.94;
+/* Half the display's rate, less 0.05 fps: the queue stays empty. */
+constexpr double k_period = 1.0 / (k_display_hz / 2.0 - 0.05);
+constexpr unsigned k_slots = 3;
+constexpr unsigned k_settle = 8;
+constexpr double k_log_every = 10.0;
+
+struct
+{
+    PFN_vkCreateDevice CreateDevice;
+    PFN_vkDestroyDevice DestroyDevice;
+    PFN_vkGetDeviceQueue GetDeviceQueue;
+    PFN_vkGetDeviceQueue2 GetDeviceQueue2;
+    PFN_vkCreateSwapchainKHR CreateSwapchainKHR;
+    PFN_vkDestroySwapchainKHR DestroySwapchainKHR;
+    PFN_vkQueuePresentKHR QueuePresentKHR;
+} next;
+
+pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+int wanted = -1;
+VkInstance instance = VK_NULL_HANDLE;
+VkDevice table_device = VK_NULL_HANDLE;
+
+struct device_entry { VkDevice device; VkPhysicalDevice physical; };
+struct queue_entry { VkQueue queue; VkDevice device; uint32_t family; };
+std::vector<device_entry> devices;
+std::vector<queue_entry> queues;
+
+struct slot
+{
+    VkCommandBuffer cmd = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    VkSemaphore acquired = VK_NULL_HANDLE, generated = VK_NULL_HANDLE, shown = VK_NULL_HANDLE;
+};
+
+struct swapchain
+{
+    VkDevice device = VK_NULL_HANDLE;
+    VkPhysicalDevice physical = VK_NULL_HANDLE;
+    VkSwapchainKHR handle = VK_NULL_HANDLE;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    VkExtent2D extent{};
+    std::vector<VkImage> images;
+    ps5::framegen::interpolator fg;
+    bool ready = false, failed = false;
+    VkCommandPool pool = VK_NULL_HANDLE;
+    uint32_t family = 0;
+    slot slots[k_slots];
+    uint64_t frames = 0, generated = 0, shown = 0, late = 0;
+    double next_due = 0.0, last = 0.0, logged = 0.0;
+    unsigned on_time = 0;
+    bool engaged = false, frames_general = false;
+};
+std::vector<swapchain *> swapchains;
+uint64_t total_frames, total_generated;   /* of swapchains already gone */
+
+double now_seconds()
+{
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec + (double)ts.tv_nsec * 1e-9;
+}
+
+void sleep_until(double when)
+{
+    double left = when - now_seconds();
+    if (left <= 0.0)
+        return;
+    timespec ts;
+    ts.tv_sec = (time_t)left;
+    ts.tv_nsec = (long)((left - (double)ts.tv_sec) * 1e9);
+    nanosleep(&ts, nullptr);
+}
+
+bool is_wanted()
+{
+    if (wanted < 0)
+    {
+        const char *value = getenv("PW_PC5_FRAMEGEN");
+        wanted = value && !strcmp(value, "1");
+        if (wanted)
+            fprintf(stderr, "pw_framegen: on, %.2f fps shown at %.2f\n", 1.0 / k_period, 2.0 / k_period);
+    }
+    return wanted > 0;
+}
+
+/* Under the lock. */
+VkPhysicalDevice physical_of(VkDevice device)
+{
+    for (const auto &entry : devices)
+        if (entry.device == device)
+            return entry.physical;
+    return VK_NULL_HANDLE;
+}
+
+bool family_of(VkQueue queue, VkDevice device, uint32_t &family)
+{
+    for (const auto &entry : queues)
+        if (entry.queue == queue && entry.device == device)
+        {
+            family = entry.family;
+            return true;
+        }
+    return false;
+}
+
+swapchain *find(VkSwapchainKHR handle)
+{
+    for (auto *sc : swapchains)
+        if (sc->handle == handle)
+            return sc;
+    return nullptr;
+}
+
+/* RADV's own entry points for the interpolator and this file, once. */
+bool load_table(VkDevice device)
+{
+    bool ok = true;
+
+    if (table_device == device)
+        return true;
+    if (!instance)
+        return false;
+#define PW_FRAMEGEN_LOAD_DEVICE(name) \
+    ok = (pw_framegen_vk.name = (PFN_vk##name)vk_common_GetDeviceProcAddr(device, "vk" #name)) && ok;
+#define PW_FRAMEGEN_LOAD_INSTANCE(name) \
+    ok = (pw_framegen_vk.name = (PFN_vk##name)vk_icdGetInstanceProcAddr(instance, "vk" #name)) && ok;
+    PW_FRAMEGEN_VK_DEVICE_COMMANDS(PW_FRAMEGEN_LOAD_DEVICE)
+    PW_FRAMEGEN_VK_INSTANCE_COMMANDS(PW_FRAMEGEN_LOAD_INSTANCE)
+#undef PW_FRAMEGEN_LOAD_DEVICE
+#undef PW_FRAMEGEN_LOAD_INSTANCE
+    if (ok)
+        table_device = device;
+    return ok;
+}
+
+bool format_supported(VkFormat format)
+{
+    return format == VK_FORMAT_B8G8R8A8_UNORM || format == VK_FORMAT_B8G8R8A8_SRGB
+        || format == VK_FORMAT_R8G8B8A8_UNORM || format == VK_FORMAT_R8G8B8A8_SRGB;
+}
+
+void release(swapchain *sc)
+{
+    if (sc->ready)
+    {
+        for (auto &s : sc->slots)
+        {
+            if (s.fence)
+            {
+                vkWaitForFences(sc->device, 1, &s.fence, VK_TRUE, UINT64_MAX);
+                vkDestroyFence(sc->device, s.fence, nullptr);
+            }
+            if (s.acquired) vkDestroySemaphore(sc->device, s.acquired, nullptr);
+            if (s.generated) vkDestroySemaphore(sc->device, s.generated, nullptr);
+            if (s.shown) vkDestroySemaphore(sc->device, s.shown, nullptr);
+        }
+        if (sc->pool)
+            vkDestroyCommandPool(sc->device, sc->pool, nullptr);
+        sc->fg.destroy();
+    }
+    sc->ready = false;
+}
+
+/* At the swapchain's first present: its images, the interpolator, the
+ * command buffers on the queue's family. */
+bool setup(swapchain *sc, uint32_t family)
+{
+    std::string error;
+    uint32_t count = 0;
+
+    if (!load_table(sc->device))
+    {
+        fprintf(stderr, "pw_framegen: a Vulkan entry point is missing; off\n");
+        return false;
+    }
+    if (!format_supported(sc->format))
+    {
+        fprintf(stderr, "pw_framegen: swapchain format %d is not 8-bit RGB; off for it\n", (int)sc->format);
+        return false;
+    }
+    if (vkGetSwapchainImagesKHR(sc->device, sc->handle, &count, nullptr) != VK_SUCCESS || count < 2)
+        return false;
+    sc->images.resize(count);
+    if (vkGetSwapchainImagesKHR(sc->device, sc->handle, &count, sc->images.data()) != VK_SUCCESS)
+        return false;
+    if (!sc->fg.create(sc->physical, sc->device, sc->extent.width, sc->extent.height, error, sc->format))
+    {
+        fprintf(stderr, "pw_framegen: the interpolator could not be made (%s); off\n", error.c_str());
+        return false;
+    }
+
+    VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pool_info.queueFamilyIndex = family;
+    if (vkCreateCommandPool(sc->device, &pool_info, nullptr, &sc->pool) != VK_SUCCESS)
+    {
+        sc->fg.destroy();
+        return false;
+    }
+    sc->family = family;
+    sc->ready = true;   /* release() undoes the rest from here */
+    for (auto &s : sc->slots)
+    {
+        VkCommandBufferAllocateInfo cmd_info{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        VkSemaphoreCreateInfo semaphore_info{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+
+        cmd_info.commandPool = sc->pool;
+        cmd_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        cmd_info.commandBufferCount = 1;
+        fence_info.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        if (vkAllocateCommandBuffers(sc->device, &cmd_info, &s.cmd) != VK_SUCCESS
+            || vkCreateFence(sc->device, &fence_info, nullptr, &s.fence) != VK_SUCCESS
+            || vkCreateSemaphore(sc->device, &semaphore_info, nullptr, &s.acquired) != VK_SUCCESS
+            || vkCreateSemaphore(sc->device, &semaphore_info, nullptr, &s.generated) != VK_SUCCESS
+            || vkCreateSemaphore(sc->device, &semaphore_info, nullptr, &s.shown) != VK_SUCCESS)
+        {
+            release(sc);
+            return false;
+        }
+    }
+    fprintf(stderr, "pw_framegen: swapchain %ux%u format %d, %u images\n", sc->extent.width, sc->extent.height,
+        (int)sc->format, count);
+    return true;
+}
+
+void barrier(VkCommandBuffer cmd, VkImage image, VkImageLayout from, VkImageLayout to, VkAccessFlags src_access,
+    VkAccessFlags dst_access, VkPipelineStageFlags src_stage, VkPipelineStageFlags dst_stage)
+{
+    VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    b.srcAccessMask = src_access;
+    b.dstAccessMask = dst_access;
+    b.oldLayout = from;
+    b.newLayout = to;
+    b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = image;
+    b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    vkCmdPipelineBarrier(cmd, src_stage, dst_stage, 0, 0, nullptr, 0, nullptr, 1, &b);
+}
+
+void copy_whole(VkCommandBuffer cmd, VkImage from, VkImageLayout from_layout, VkImage to, VkImageLayout to_layout,
+    VkExtent2D extent)
+{
+    VkImageCopy region{};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.extent = {extent.width, extent.height, 1};
+    vkCmdCopyImage(cmd, from, from_layout, to, to_layout, 1, &region);
+}
+
+void blit_whole(VkCommandBuffer cmd, VkImage from, VkImageLayout from_layout, VkImage to, VkImageLayout to_layout,
+    VkExtent2D extent)
+{
+    VkImageBlit region{};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.srcOffsets[1] = {(int32_t)extent.width, (int32_t)extent.height, 1};
+    region.dstOffsets[1] = {(int32_t)extent.width, (int32_t)extent.height, 1};
+    vkCmdBlitImage(cmd, from, from_layout, to, to_layout, 1, &region, VK_FILTER_NEAREST);
+}
+
+void log_state(swapchain *sc, double now)
+{
+    double mean = 0.0, most = 0.0, flow = 0.0;
+    uint32_t timed = 0;
+
+    if (now - sc->logged < k_log_every)
+        return;
+    sc->logged = now;
+    if (sc->fg.take_gpu_time(mean, most, timed, flow))
+        fprintf(stderr, "pw_framegen: frames=%llu generated=%llu late=%llu engaged=%d gpu=%.2fms (flow %.2f) max=%.2fms\n",
+            (unsigned long long)sc->frames, (unsigned long long)sc->generated, (unsigned long long)sc->late,
+            (int)sc->engaged, mean, flow, most);
+    else
+        fprintf(stderr, "pw_framegen: frames=%llu generated=%llu late=%llu engaged=%d\n",
+            (unsigned long long)sc->frames, (unsigned long long)sc->generated, (unsigned long long)sc->late,
+            (int)sc->engaged);
+}
+
+/* The game's present with the frame before it generated; result is the game's. */
+VkResult present_generated(swapchain *sc, VkQueue queue, const VkPresentInfoKHR *info, bool reset)
+{
+    slot &s = sc->slots[sc->frames % k_slots];
+    uint32_t game = info->pImageIndices[0], extra = UINT32_MAX;
+    VkImage image = sc->images[game];
+    std::vector<VkSemaphore> waits(info->pWaitSemaphores, info->pWaitSemaphores + info->waitSemaphoreCount);
+    std::vector<VkPipelineStageFlags> stages(waits.size(), VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+    VkSemaphore signals[2] = {s.shown, s.generated};
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    VkPresentInfoKHR present;
+    VkResult result;
+    bool made;
+
+    vkWaitForFences(sc->device, 1, &s.fence, VK_TRUE, UINT64_MAX);
+    /* The second image, for the generated frame: one refresh at most. */
+    if (!reset)
+    {
+        result = vkAcquireNextImageKHR(sc->device, sc->handle, 50000000ull, s.acquired, VK_NULL_HANDLE, &extra);
+        if (result != VK_SUCCESS && result != VK_SUBOPTIMAL_KHR)
+            extra = UINT32_MAX;
+    }
+    if (extra != UINT32_MAX)
+    {
+        waits.push_back(s.acquired);
+        stages.push_back(VK_PIPELINE_STAGE_TRANSFER_BIT);
+    }
+    vkResetFences(sc->device, 1, &s.fence);
+
+    vkResetCommandBuffer(s.cmd, 0);
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(s.cmd, &begin);
+    barrier(s.cmd, image, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, 0,
+        VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    /* The interpolator's two frames to GENERAL once (its own prepare() names
+     * a shader read without the compute stage, which the validation layer
+     * reports). */
+    if (!sc->frames_general)
+    {
+        barrier(s.cmd, sc->fg.frame_image(), VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL, 0,
+            VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+            VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+        barrier(s.cmd, sc->fg.previous_image(), VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL, 0,
+            VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+            VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+        sc->frames_general = true;
+    }
+    copy_whole(s.cmd, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, sc->fg.frame_image(), VK_IMAGE_LAYOUT_GENERAL,
+        sc->extent);
+    made = sc->fg.record(s.cmd, reset || extra == UINT32_MAX);
+    if (extra != UINT32_MAX)
+    {
+        VkImage target = sc->images[extra];
+
+        barrier(s.cmd, target, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0,
+            VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+        /* Without a frame in between, the game's frame twice: the image was
+         * taken and is shown either way. */
+        if (made)
+            blit_whole(s.cmd, sc->fg.output_image(), VK_IMAGE_LAYOUT_GENERAL, target,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, sc->extent);
+        else
+            copy_whole(s.cmd, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target,
+                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, sc->extent);
+        barrier(s.cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+            VK_ACCESS_TRANSFER_WRITE_BIT, 0, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    }
+    barrier(s.cmd, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+        VK_ACCESS_TRANSFER_READ_BIT, 0, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    vkEndCommandBuffer(s.cmd);
+
+    submit.waitSemaphoreCount = (uint32_t)waits.size();
+    submit.pWaitSemaphores = waits.data();
+    submit.pWaitDstStageMask = stages.data();
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &s.cmd;
+    submit.signalSemaphoreCount = extra != UINT32_MAX ? 2 : 1;
+    submit.pSignalSemaphores = signals;
+    if ((result = vkQueueSubmit(queue, 1, &submit, s.fence)) != VK_SUCCESS)
+    {
+        fprintf(stderr, "pw_framegen: submit failed (%d); off for this swapchain\n", (int)result);
+        sc->failed = true;
+        return result;
+    }
+
+    if (extra != UINT32_MAX)
+    {
+        VkPresentInfoKHR between{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+        between.waitSemaphoreCount = 1;
+        between.pWaitSemaphores = &s.generated;
+        between.swapchainCount = 1;
+        between.pSwapchains = &sc->handle;
+        between.pImageIndices = &extra;
+        next.QueuePresentKHR(queue, &between);
+        sc->generated += made;
+    }
+
+    present = *info;
+    present.waitSemaphoreCount = 1;
+    present.pWaitSemaphores = &s.shown;
+    result = next.QueuePresentKHR(queue, &present);
+    sc->fg.advance();
+    return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL wrap_CreateDevice(VkPhysicalDevice physical, const VkDeviceCreateInfo *info,
+    const VkAllocationCallbacks *allocator, VkDevice *device)
+{
+    VkResult result = next.CreateDevice(physical, info, allocator, device);
+
+    if (result == VK_SUCCESS)
+    {
+        pthread_mutex_lock(&lock);
+        devices.push_back({*device, physical});
+        pthread_mutex_unlock(&lock);
+    }
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL wrap_DestroyDevice(VkDevice device, const VkAllocationCallbacks *allocator)
+{
+    pthread_mutex_lock(&lock);
+    for (size_t i = 0; i < swapchains.size();)
+    {
+        if (swapchains[i]->device != device)
+        {
+            i++;
+            continue;
+        }
+        release(swapchains[i]);
+        delete swapchains[i];
+        swapchains.erase(swapchains.begin() + i);
+    }
+    for (size_t i = 0; i < devices.size();)
+        devices[i].device == device ? (void)devices.erase(devices.begin() + i) : (void)i++;
+    for (size_t i = 0; i < queues.size();)
+        queues[i].device == device ? (void)queues.erase(queues.begin() + i) : (void)i++;
+    if (table_device == device)
+        table_device = VK_NULL_HANDLE;
+    pthread_mutex_unlock(&lock);
+    next.DestroyDevice(device, allocator);
+}
+
+VKAPI_ATTR void VKAPI_CALL wrap_GetDeviceQueue(VkDevice device, uint32_t family, uint32_t index, VkQueue *queue)
+{
+    next.GetDeviceQueue(device, family, index, queue);
+    pthread_mutex_lock(&lock);
+    queues.push_back({*queue, device, family});
+    pthread_mutex_unlock(&lock);
+}
+
+VKAPI_ATTR void VKAPI_CALL wrap_GetDeviceQueue2(VkDevice device, const VkDeviceQueueInfo2 *info, VkQueue *queue)
+{
+    next.GetDeviceQueue2(device, info, queue);
+    if (*queue)
+    {
+        pthread_mutex_lock(&lock);
+        queues.push_back({*queue, device, info->queueFamilyIndex});
+        pthread_mutex_unlock(&lock);
+    }
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL wrap_CreateSwapchainKHR(VkDevice device, const VkSwapchainCreateInfoKHR *info,
+    const VkAllocationCallbacks *allocator, VkSwapchainKHR *handle)
+{
+    VkSwapchainCreateInfoKHR ours = *info;
+    VkResult result;
+
+    if (!is_wanted())
+        return next.CreateSwapchainKHR(device, info, allocator, handle);
+    /* An image more for the generated frame, and copies in and out of them. */
+    ours.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ours.minImageCount = info->minImageCount + 1;
+    if ((result = next.CreateSwapchainKHR(device, &ours, allocator, handle)) != VK_SUCCESS)
+    {
+        ours.minImageCount = info->minImageCount;
+        if ((result = next.CreateSwapchainKHR(device, &ours, allocator, handle)) != VK_SUCCESS)
+        {
+            fprintf(stderr, "pw_framegen: the swapchain could not be made for it (%d)\n", (int)result);
+            return next.CreateSwapchainKHR(device, info, allocator, handle);
+        }
+    }
+
+    auto *sc = new swapchain;
+    sc->device = device;
+    sc->handle = *handle;
+    sc->format = info->imageFormat;
+    sc->extent = info->imageExtent;
+    pthread_mutex_lock(&lock);
+    sc->physical = physical_of(device);
+    if (!sc->physical)
+        sc->failed = true;
+    swapchains.push_back(sc);
+    pthread_mutex_unlock(&lock);
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL wrap_DestroySwapchainKHR(VkDevice device, VkSwapchainKHR handle,
+    const VkAllocationCallbacks *allocator)
+{
+    swapchain *sc;
+
+    pthread_mutex_lock(&lock);
+    if ((sc = find(handle)))
+    {
+        for (size_t i = 0; i < swapchains.size(); i++)
+            if (swapchains[i] == sc)
+                swapchains.erase(swapchains.begin() + i);
+    }
+    pthread_mutex_unlock(&lock);
+    if (sc)
+    {
+        release(sc);
+        pthread_mutex_lock(&lock);
+        total_frames += sc->frames;
+        total_generated += sc->generated;
+        pthread_mutex_unlock(&lock);
+        delete sc;
+    }
+    next.DestroySwapchainKHR(device, handle, allocator);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL wrap_QueuePresentKHR(VkQueue queue, const VkPresentInfoKHR *info)
+{
+    swapchain *sc = nullptr;
+    uint32_t family = 0;
+    bool known;
+    double now, interval;
+
+    if (!is_wanted() || info->swapchainCount != 1)
+        return next.QueuePresentKHR(queue, info);
+    pthread_mutex_lock(&lock);
+    sc = find(info->pSwapchains[0]);
+    known = sc && family_of(queue, sc->device, family);
+    pthread_mutex_unlock(&lock);
+    if (!sc || sc->failed)
+        return next.QueuePresentKHR(queue, info);
+    if (!sc->ready && (!known || !setup(sc, family)))
+    {
+        sc->failed = true;
+        return next.QueuePresentKHR(queue, info);
+    }
+
+    /* The hold: a frame at most every k_period. */
+    sleep_until(sc->next_due);
+    now = now_seconds();
+    interval = sc->last ? now - sc->last : 0.0;
+    sc->last = now;
+    sc->next_due = (sc->next_due > now - k_period ? sc->next_due : now) + k_period;
+    if (sc->frames && interval > 1.25 * k_period)
+    {
+        if (sc->engaged)
+            fprintf(stderr, "pw_framegen: frame %.1f ms late; shown as it is\n", (interval - k_period) * 1e3);
+        sc->late++;
+        sc->on_time = 0;
+        sc->engaged = false;
+    }
+    else if (sc->on_time < k_settle)
+        sc->on_time++;
+    sc->frames++;
+    log_state(sc, now);
+
+    if (sc->on_time < k_settle)
+        return next.QueuePresentKHR(queue, info);
+    /* Engaging: the first frame only primes the interpolator. */
+    bool reset = !sc->engaged;
+    sc->engaged = true;
+    return present_generated(sc, queue, info, reset);
+}
+}
+
+extern "C" int pw_framegen_counts(uint64_t *frames, uint64_t *generated)
+{
+    int engaged = 0;
+
+    pthread_mutex_lock(&lock);
+    *frames = total_frames;
+    *generated = total_generated;
+    for (auto *sc : swapchains)
+    {
+        *frames += sc->frames;
+        *generated += sc->generated;
+        engaged |= sc->engaged;
+    }
+    pthread_mutex_unlock(&lock);
+    return engaged;
+}
+
+extern "C" void pw_framegen_instance(VkInstance new_instance)
+{
+    if (new_instance && !instance)
+        instance = new_instance;
+}
+
+extern "C" PFN_vkVoidFunction pw_framegen_resolve(const char *name, PFN_vkVoidFunction function)
+{
+    if (!name || !function || !is_wanted())
+        return function;
+#define PW_FRAMEGEN_WRAP(entry) \
+    if (!strcmp(name, "vk" #entry)) \
+    { \
+        if (!next.entry) \
+            next.entry = (PFN_vk##entry)function; \
+        return (PFN_vkVoidFunction)wrap_##entry; \
+    }
+    PW_FRAMEGEN_WRAP(CreateDevice)
+    PW_FRAMEGEN_WRAP(DestroyDevice)
+    PW_FRAMEGEN_WRAP(GetDeviceQueue)
+    PW_FRAMEGEN_WRAP(GetDeviceQueue2)
+    PW_FRAMEGEN_WRAP(CreateSwapchainKHR)
+    PW_FRAMEGEN_WRAP(DestroySwapchainKHR)
+    PW_FRAMEGEN_WRAP(QueuePresentKHR)
+#undef PW_FRAMEGEN_WRAP
+    return function;
+}
diff --git a/wine/ps5/pw_framegen.h b/wine/ps5/pw_framegen.h
new file mode 100644
index 0000000..d5ef5a6
--- /dev/null
+++ b/wine/ps5/pw_framegen.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Frame generation in libvulkan.prx (pw_framegen.cpp): with PW_PC5_FRAMEGEN=1
+ * in the environment (PC5 sets it for a game whose Frame generation is on),
+ * a game's swapchain is held at half the display's rate (30 fps on the
+ * console's 59.94 Hz) and each of its frames is shown after the frame
+ * between it and the one before, made by ps5-framegen's interpolator (AMD
+ * FSR3's optical flow): 30 fps is shown at 60. A game slower than that is
+ * shown as it is, without frames in between, until it keeps up again.
+ *
+ * The resolver wraps the entry points it needs (the device's, its queues',
+ * its swapchains' and their presents) around the ones it is given; every
