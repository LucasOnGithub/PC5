+ #if XAUDIO2_VER >= 8
+@@ -558,13 +606,20 @@ static HRESULT WINAPI XA2SRC_SetOutputVoices(IXAudio2SourceVoice *iface,
+ {
+     XA2VoiceImpl *This = impl_from_IXAudio2SourceVoice(iface);
+     FAudioVoiceSends *faudio_sends;
