+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Sat, 24 Oct 2026 01:20:00 +0100
+Subject: [PATCH] xaudio2: Calls on a destroyed voice do nothing.
+
+Samurai Warriors 4 DX crashed about six minutes into a stage in
+FAudioSourceVoice_GetState, through a source voice it had destroyed: its
+FAudio voice had been freed, and the memory held other data since. At
+the same moment the mixer read audio data the game had already freed.
+
+The game keeps calling voices after DestroyVoice, which did no harm on
+Windows. Here the FAudio voice was left dangling, so those calls read
+freed memory; and the XA2VoiceImpl was handed to the next voice made at
+once, so a late SubmitSourceBuffer on the destroyed voice queued its
+buffer on that new voice, which then played it after the game freed it.
+
+DestroyVoice now forgets the FAudio voice, and every call on a destroyed
+voice does nothing: setters return S_OK, getters give zeros (a frequency
+ratio of 1), a second DestroyVoice is ignored, and a destroyed voice
+named as a send or a destination is left out. Setting a voice's outputs
+to destroyed voices only does nothing; creating a voice that sends only
+to them fails when there is no mastering voice either, for FAudio would
+take its rate. A voice that failed to be created forgets the FAudio voice
+FAudio freed without clearing (an xWMA voice it can't decode). A
+destroyed source or submix voice's XA2VoiceImpl is reused only once 64
+more voices have been destroyed after it, so a late call can't reach the
+voice made in its place, while the voices kept stay few.
+---
+ dlls/xaudio2_7/xaudio_dll.c     | 342 +++++++++++++++++++++++++++++---
+ dlls/xaudio2_7/xaudio_private.h |   1 +
+ 2 files changed, 313 insertions(+), 30 deletions(-)
+
+diff --git a/dlls/xaudio2_7/xaudio_dll.c b/dlls/xaudio2_7/xaudio_dll.c
+index cea309e..cf27ddb 100644
+--- a/dlls/xaudio2_7/xaudio_dll.c
++++ b/dlls/xaudio2_7/xaudio_dll.c
+@@ -348,34 +348,69 @@ FAudioEffectChain *wrap_effect_chain(const XAUDIO2_EFFECT_CHAIN *pEffectChain)
+     return ret;
+ }
+ 
++/* A game may still call a voice it destroyed, which did no harm on Windows.
++ * Here the FAudio voice is gone (FAudio freed it, and the memory may hold
++ * anything since), so such calls do nothing, and getters give zeros. The
++ * XA2VoiceImpl stays, and is only reused once VOICE_QUARANTINE more voices
++ * have been destroyed after it, so a late call can't reach the next voice
++ * made in its place either. */
++#define VOICE_QUARANTINE 64
++static LONG64 voices_destroyed;
++
++static HRESULT destroyed_voice(XA2VoiceImpl *voice, const char *call)
++{
++    WARN("%s on destroyed voice %p\n", call, voice);
++    return S_OK;
++}
++
++/* Under engine's lock and voice's: whether CreateSourceVoice or
++ * CreateSubmixVoice may make a voice in its place. */
++static inline BOOL voice_reusable(const XA2VoiceImpl *voice)
++{
++    return !voice->in_use && (!voice->destroyed ||
++            ReadAcquire64(&voices_destroyed) - voice->destroyed >= VOICE_QUARANTINE);
++}
++
+ /* Send Wrapping */
+ 
+-static FAudioVoiceSends *wrap_voice_sends(const XAUDIO2_VOICE_SENDS *sends)
++/* gone: the list named voices, and every one of them was destroyed. */
++static FAudioVoiceSends *wrap_voice_sends(const XAUDIO2_VOICE_SENDS *sends, BOOL *gone)
+ {
+     FAudioVoiceSends *ret;
+     int i;
+ 
++    *gone = FALSE;
+     if(!sends)
+         return NULL;
+ 
+ #if XAUDIO2_VER <= 3
+     ret = malloc(sizeof(*ret) + sends->OutputCount * sizeof(FAudioSendDescriptor));
+-    ret->SendCount = sends->OutputCount;
++    ret->SendCount = 0;
+     ret->pSends = (FAudioSendDescriptor*)(ret + 1);
+     for(i = 0; i < sends->OutputCount; ++i){
+         XA2VoiceImpl *voice = impl_from_IXAudio2Voice(sends->pOutputVoices[i]);
+-        ret->pSends[i].pOutputVoice = voice->faudio_voice;
+-        ret->pSends[i].Flags = 0;
++        if(!voice->faudio_voice){
++            destroyed_voice(voice, "a send");
++            continue;
++        }
++        ret->pSends[ret->SendCount].pOutputVoice = voice->faudio_voice;
++        ret->pSends[ret->SendCount++].Flags = 0;
+     }
++    *gone = sends->OutputCount && !ret->SendCount;
+ #else
+     ret = malloc(sizeof(*ret) + sends->SendCount * sizeof(FAudioSendDescriptor));
+-    ret->SendCount = sends->SendCount;
++    ret->SendCount = 0;
+     ret->pSends = (FAudioSendDescriptor*)(ret + 1);
+     for(i = 0; i < sends->SendCount; ++i){
+         XA2VoiceImpl *voice = impl_from_IXAudio2Voice(sends->pSends[i].pOutputVoice);
+-        ret->pSends[i].pOutputVoice = voice->faudio_voice;
+-        ret->pSends[i].Flags = sends->pSends[i].Flags;
++        if(!voice->faudio_voice){
++            destroyed_voice(voice, "a send");
++            continue;
++        }
++        ret->pSends[ret->SendCount].pOutputVoice = voice->faudio_voice;
++        ret->pSends[ret->SendCount++].Flags = sends->pSends[i].Flags;
+     }
++    *gone = sends->SendCount && !ret->SendCount;
+ #endif
+     return ret;
+ }
+@@ -514,14 +549,21 @@ static const FAudioEngineCallback FAudioEngineCallback_Vtbl = {
+ 
+ static inline void destroy_voice(XA2VoiceImpl *This)
+ {
++    if (!This->faudio_voice)
++    {
++        destroyed_voice(This, "DestroyVoice");
++        return;
++    }
+     if (FAILED(FAudioVoice_DestroyVoiceSafeEXT(This->faudio_voice)))
+     {
+         ERR("Destroying voice %p failed.\n", This);
+         return;
+     }
++    This->faudio_voice = NULL;
+     free_effect_chain(This->effect_chain);
+     This->effect_chain = NULL;
+     This->in_use = FALSE;
++    This->destroyed = InterlockedIncrement64(&voices_destroyed);
+ }
