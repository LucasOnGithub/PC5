+ }
+@@ -643,6 +714,8 @@ static HRESULT WINAPI XA2SRC_SetFilterParameters(IXAudio2SourceVoice *iface,
+ {
+     XA2VoiceImpl *This = impl_from_IXAudio2SourceVoice(iface);
+     TRACE("%p, %p, 0x%x\n", This, pParameters, OperationSet);
