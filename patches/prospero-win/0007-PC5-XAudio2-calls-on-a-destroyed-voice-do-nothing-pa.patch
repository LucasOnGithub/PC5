++    if (!This->faudio_voice)
++        return destroyed_voice(This, "SetOutputVoices");
+ 
+-    faudio_sends = wrap_voice_sends(pSendList);
++    faudio_sends = wrap_voice_sends(pSendList, &gone);
+ 
+-    hr = FAudioVoice_SetOutputVoices(This->faudio_voice, faudio_sends);
++    /* sends only to destroyed voices: the call does nothing */
++    if (gone)
++        hr = destroyed_voice(This, "SetOutputVoices to destroyed voices");
++    else
++        hr = FAudioVoice_SetOutputVoices(This->faudio_voice, faudio_sends);
+ 
+     free_voice_sends(faudio_sends);
+ 
+@@ -579,6 +634,8 @@ static HRESULT WINAPI XA2SRC_SetEffectChain(IXAudio2SourceVoice *iface,
+     HRESULT hr;
+ 
+     TRACE("%p, %p\n", This, pEffectChain);
++    if (!This->faudio_voice)
++        return destroyed_voice(This, "SetEffectChain");
+ 
+     chain = wrap_effect_chain(pEffectChain);
+ #if XAUDIO2_VER >= 8
+@@ -598,6 +655,8 @@ static HRESULT WINAPI XA2SRC_EnableEffect(IXAudio2SourceVoice *iface, UINT32 Eff
+ {
+     XA2VoiceImpl *This = impl_from_IXAudio2SourceVoice(iface);
+     TRACE("%p, %u, 0x%x\n", This, EffectIndex, OperationSet);
