+
+/* ---- The overlay: the frame counter and more, a line each ----------------
+ * What PC5's Settings › Overlay turns on, as flags. FPS alone keeps the
+ * large counter above; with anything else every line is a label and a
+ * value in the 5x7 glyphs. A line whose value is unknown (a sensor that
+ * can't be read) is left out. */
+enum {
+    PW_PC5_HUD_FPS = 1u,
+    PW_PC5_HUD_FRAME_TIME = 2u,
+    PW_PC5_HUD_CPU = 4u,
+    PW_PC5_HUD_CPU_TEMP = 8u,
+    PW_PC5_HUD_SOC_TEMP = 16u,
+    PW_PC5_HUD_MEMORY = 32u,
+    PW_PC5_HUD_ALL = 63u,
+    PW_PC5_HUD_LINES = 6,
+    PW_PC5_HUD_PITCH = 9,        /* a line: 7 rows of glyph and 2 of space */
+};
+
+typedef struct PwPc5HudStats {
+    unsigned lines;              /* PW_PC5_HUD_*: what is shown */
+    unsigned fps;                /* frames shown in the last second */
+    uint32_t frame_us;           /* their average time, 0 when none */
+    int cpu_percent;             /* the game's process, of every CPU; -1 unknown */
+    int cpu_celsius, soc_celsius;/* -1 unknown */
+    uint64_t memory_used;        /* bytes */
+    uint64_t memory_total;       /* bytes, 0 unknown */
+} PwPc5HudStats;
+
+/* A glyph of the overlay's lines: its width (1 to 5 columns, bit width-1
+ * the left one) and 7 rows. Letters for the labels, digits and signs for
+ * the values; '^' is the degree sign. */
+static inline int pw_pc5_hud_line_glyph(char c, const uint8_t **rows)
+{
+    static const struct { char c; uint8_t width; uint8_t rows[7]; } glyphs[] = {
+        { 'A', 5, { 0x0e, 0x11, 0x11, 0x1f, 0x11, 0x11, 0x11 } },
+        { 'C', 5, { 0x0e, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0e } },
+        { 'F', 5, { 0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x10 } },
+        { 'M', 5, { 0x11, 0x1b, 0x15, 0x15, 0x11, 0x11, 0x11 } },
+        { 'O', 5, { 0x0e, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
+        { 'P', 5, { 0x1e, 0x11, 0x11, 0x1e, 0x10, 0x10, 0x10 } },
+        { 'R', 5, { 0x1e, 0x11, 0x11, 0x1e, 0x14, 0x12, 0x11 } },
+        { 'S', 5, { 0x0f, 0x10, 0x10, 0x0e, 0x01, 0x01, 0x1e } },
+        { 'U', 5, { 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
+        { '%', 5, { 0x19, 0x1a, 0x02, 0x04, 0x08, 0x0b, 0x13 } },
+        { '.', 1, { 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01 } },
+        { '/', 3, { 0x01, 0x01, 0x02, 0x02, 0x02, 0x04, 0x04 } },
+        { '^', 3, { 0x02, 0x05, 0x02, 0x00, 0x00, 0x00, 0x00 } },
+        { ' ', 2, { 0 } },
+    };
+    if (c >= '0' && c <= '9') {
+        *rows = pw_pc5_hud_glyphs[c - '0'];
+        return 5;
+    }
+    for (unsigned i = 0; i < sizeof(glyphs) / sizeof(glyphs[0]); i++)
+        if (glyphs[i].c == c) {
+            *rows = glyphs[i].rows;
+            return glyphs[i].width;
+        }
+    *rows = NULL;
+    return 0;
+}
+
+/* How wide text is in the line glyphs, a column between them. */
+static inline int pw_pc5_hud_text_width(const char *text)
+{
+    int width = 0;
+    for (const char *p = text; *p; p++) {
+        const uint8_t *rows;
+        int w = pw_pc5_hud_line_glyph(*p, &rows);
+        if (w) width += w + (width ? 1 : 0);
+    }
+    return width;
+}
+
+static inline void pw_pc5_hud_text(uint32_t *image, int x, int y, const char *text, uint32_t color)
+{
+    for (const char *p = text; *p; p++) {
+        const uint8_t *rows;
+        int w = pw_pc5_hud_line_glyph(*p, &rows);
+        if (!w) continue;
+        for (int row = 0; row < 7; row++)
+            for (int column = 0; column < w; column++)
+                if (rows[row] & (1u << (w - 1 - column))) {
+                    int px = x + column, py = y + row;
+                    if (px >= 0 && px < PW_PC5_HUD_SIDE && py >= 0 && py < PW_PC5_HUD_SIDE)
+                        image[py * PW_PC5_HUD_SIDE + px] = color;
+                }
+        x += w + 1;
+    }
+}
+
+/* A decimal with one digit after the point, from tenths. */
+static inline void pw_pc5_hud_tenths(char *out, size_t size, uint64_t tenths, int point)
+{
+    char digits[24];
+    int count = 0;
+    size_t at = 0;
+    uint64_t whole = tenths / 10;
+
+    do { digits[count++] = (char)('0' + whole % 10); whole /= 10; } while (whole && count < 20);
+    while (count && at + 1 < size) out[at++] = digits[--count];
+    if (point && at + 3 < size) {
+        out[at++] = '.';
+        out[at++] = (char)('0' + tenths % 10);
+    }
+    out[at] = 0;
+}
+
+/* A line's label and value, 0 when it isn't shown. The value is the
+ * longest form that fits beside the label. */
+static inline int pw_pc5_hud_line(const PwPc5HudStats *stats, unsigned line, const char **label, char *value,
+                                  size_t size)
+{
+    enum { ROOM = PW_PC5_HUD_SIDE - 3 - 17 - 3 - 3 };   /* the margins, the label and a space */
+    char used[8], total[8];
+
+    value[0] = 0;
+    if (!(stats->lines & line)) return 0;
+    switch (line) {
+    case PW_PC5_HUD_FPS:
+        *label = "FPS";
+        snprintf(value, size, "%u", stats->fps > 999 ? 999 : stats->fps);
+        return 1;
+    case PW_PC5_HUD_FRAME_TIME:
+        *label = "MS";
+        if (!stats->frame_us) return 0;
+        /* 16.7 below 100 ms, 125 above */
+        pw_pc5_hud_tenths(value, size, (stats->frame_us + 50) / 100 > 9999 ? 9999 : (stats->frame_us + 50) / 100,
+                          stats->frame_us < 99950);
+        return 1;
+    case PW_PC5_HUD_CPU:
+        *label = "CPU";
+        if (stats->cpu_percent < 0) return 0;
+        snprintf(value, size, "%d%%", stats->cpu_percent > 100 ? 100 : stats->cpu_percent);
+        return 1;
+    case PW_PC5_HUD_CPU_TEMP:
+    case PW_PC5_HUD_SOC_TEMP: {
+        int celsius = line == PW_PC5_HUD_CPU_TEMP ? stats->cpu_celsius : stats->soc_celsius;
+        *label = line == PW_PC5_HUD_CPU_TEMP ? "CPU" : "SOC";
+        if (celsius < 0) return 0;
+        snprintf(value, size, "%d^C", celsius > 999 ? 999 : celsius);
+        return 1;
+    }
+    case PW_PC5_HUD_MEMORY: {
+        /* gigabytes (GiB) used of the whole: 5.1/12.5, then 12/12.5, then
+         * 12/13, each rounded from the bytes */
+        const uint64_t half = (uint64_t)1 << 29;
+        uint64_t used10 = (stats->memory_used * 10 + half) >> 30, total10 = (stats->memory_total * 10 + half) >> 30;
+        uint64_t used1 = (stats->memory_used + half) >> 30, total1 = (stats->memory_total + half) >> 30;
+        *label = "RAM";
+        if (!stats->memory_total) return 0;
+        if (used10 > 99999) used10 = 99999;   /* 9999.9 at most */
+        if (total10 > 99999) total10 = 99999;
+        if (used1 > 9999) used1 = 9999;
+        if (total1 > 9999) total1 = 9999;
+        for (int form = 0; form < 3; form++) {
+            /* never more used than the whole it's shown with */
+            uint64_t u = form == 0 ? used10 : form == 1 && used1 * 10 > total10 ? total10 / 10 * 10 : used1 * 10;
+            pw_pc5_hud_tenths(used, sizeof(used), u, !form);
+            pw_pc5_hud_tenths(total, sizeof(total), form == 2 ? total1 * 10 : total10, form < 2);
+            snprintf(value, size, "%s/%s", used, total);
+            if (pw_pc5_hud_text_width(value) <= ROOM) break;
+        }
+        return 1;
+    }
+    }
+    return 0;
+}
+
+/* The overlay's lines on a dark rounded box at the top of the image: the
+ * box's height, 0 when no line is shown (the image is then clear). */
+static inline uint32_t pw_pc5_hud_draw_lines(uint32_t *image, const PwPc5HudStats *stats)
+{
+    static const unsigned order[PW_PC5_HUD_LINES] = { PW_PC5_HUD_FPS, PW_PC5_HUD_FRAME_TIME, PW_PC5_HUD_CPU,
+                                                      PW_PC5_HUD_CPU_TEMP, PW_PC5_HUD_SOC_TEMP, PW_PC5_HUD_MEMORY };
+    const char *labels[PW_PC5_HUD_LINES];
+    char values[PW_PC5_HUD_LINES][24];
+    unsigned count = 0;
+    uint32_t height;
+
+    memset(image, 0, PW_PC5_HUD_SIDE * PW_PC5_HUD_SIDE * 4);
+    for (unsigned i = 0; i < PW_PC5_HUD_LINES; i++)
+        if (pw_pc5_hud_line(stats, order[i], &labels[count], values[count], sizeof(values[count]))) count++;
+    if (!count) return 0;
+    height = 4 + count * PW_PC5_HUD_PITCH - 2 + 4;
+    for (uint32_t y = 0; y < height; y++)
+        for (uint32_t x = 0; x < PW_PC5_HUD_SIDE; x++) {
+            /* corners rounded to a radius of 6 */
+            int cx = x < 6 ? 6 - (int)x : x > PW_PC5_HUD_SIDE - 7 ? (int)x - (PW_PC5_HUD_SIDE - 7) : 0;
+            int cy = y < 6 ? 6 - (int)y : y > height - 7 ? (int)y - (int)(height - 7) : 0;
+            if (cx * cx + cy * cy <= 36) image[y * PW_PC5_HUD_SIDE + x] = 0xc0101216u;
+        }
+    for (unsigned i = 0; i < count; i++) {
+        int y = 4 + (int)i * PW_PC5_HUD_PITCH;
+        pw_pc5_hud_text(image, 3, y, labels[i], 0xff9aa3afu);
+        pw_pc5_hud_text(image, PW_PC5_HUD_SIDE - 3 - pw_pc5_hud_text_width(values[i]), y, values[i], 0xffffffffu);
+    }
+    return height;
+}
+
+/* The overlay for stats: the large counter for FPS alone (its box's
+ * height), else the lines. */
+static inline uint32_t pw_pc5_hud_draw_stats(uint32_t *image, const PwPc5HudStats *stats)
+{
+    if ((stats->lines & PW_PC5_HUD_ALL) == PW_PC5_HUD_FPS) {
+        pw_pc5_hud_draw(image, stats->fps);
+        return PW_PC5_HUD_BOX_HEIGHT;
+    }
+    return pw_pc5_hud_draw_lines(image, stats);
 }
 
