+ dlls/windows.gaming.input/Makefile.in |   1 +
+ dlls/windows.gaming.input/main.c      |  12 +-
+ dlls/windows.gaming.input/private.h   |   2 +
+ dlls/windows.gaming.input/title_pad.c | 409 ++++++++++++++++++++++++++
+ 4 files changed, 422 insertions(+), 2 deletions(-)
+
+diff --git a/dlls/windows.gaming.input/Makefile.in b/dlls/windows.gaming.input/Makefile.in
+index 34936b7..034cfed 100644
+--- a/dlls/windows.gaming.input/Makefile.in
++++ b/dlls/windows.gaming.input/Makefile.in
+@@ -18,4 +18,5 @@ SOURCES = \
+ 	provider.idl \
+ 	racing_wheel.c \
+ 	ramp_effect.c \
++	title_pad.c \
+ 	vector.c
+diff --git a/dlls/windows.gaming.input/main.c b/dlls/windows.gaming.input/main.c
+index 7b0a68f..aa8f8ab 100644
+--- a/dlls/windows.gaming.input/main.c
++++ b/dlls/windows.gaming.input/main.c
+@@ -113,6 +113,8 @@ static DWORD WINAPI monitor_thread_proc( void *param )
+     HANDLE start_event = param;
+     HDEVNOTIFY devnotify;
+     HMODULE module;
++    BOOL title;
++    DWORD ret;
+     HWND hwnd;
+     MSG msg;
+ 
+@@ -122,17 +124,23 @@ static DWORD WINAPI monitor_thread_proc( void *param )
+     RegisterClassExW( &wndclass );
+     hwnd = CreateWindowExW( 0, wndclass.lpszClassName, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, NULL, NULL );
+     devnotify = RegisterDeviceNotificationW( hwnd, &filter, DEVICE_NOTIFY_ALL_INTERFACE_CLASSES );
++    /* a PS5 title's controller (title_pad.c), there before the game has the
++     * factories, and then looked at four times a second */
++    if ((title = title_pad_init())) title_pad_update();
+     SetEvent( start_event );
+     initialize_providers();
+ 
+-    do
++    for (;;)
+     {
+         while (PeekMessageW( &msg, hwnd, 0, 0, PM_REMOVE ))
+         {
+             TranslateMessage( &msg );
+             DispatchMessageW( &msg );
+         }
+-    } while (!MsgWaitForMultipleObjectsEx( 0, NULL, INFINITE, QS_ALLINPUT, MWMO_ALERTABLE ));
++        ret = MsgWaitForMultipleObjectsEx( 0, NULL, title ? 250 : INFINITE, QS_ALLINPUT, MWMO_ALERTABLE );
++        if (ret == WAIT_TIMEOUT) title_pad_update();
++        else if (ret) break;
++    }
+ 
+     UnregisterDeviceNotification( devnotify );
+     DestroyWindow( hwnd );
+diff --git a/dlls/windows.gaming.input/private.h b/dlls/windows.gaming.input/private.h
+index e345ca4..7aa236f 100644
+--- a/dlls/windows.gaming.input/private.h
++++ b/dlls/windows.gaming.input/private.h
+@@ -66,6 +66,8 @@ extern HRESULT vector_create( const struct vector_iids *iids, void **out );
+ 
+ extern void provider_create( const WCHAR *device_path );
+ extern void provider_remove( const WCHAR *device_path );
++extern BOOL title_pad_init(void);
++extern void title_pad_update(void);
+ 
+ extern void manager_on_provider_created( IGameControllerProvider *provider );
+ extern void manager_on_provider_removed( IGameControllerProvider *provider );
+diff --git a/dlls/windows.gaming.input/title_pad.c b/dlls/windows.gaming.input/title_pad.c
+new file mode 100644
+index 0000000..04e0f30
+--- /dev/null
++++ b/dlls/windows.gaming.input/title_pad.c
+@@ -0,0 +1,409 @@
