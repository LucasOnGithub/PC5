++ * License along with this library; if not, write to the Free Software
++ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
++ */
++
++/* A PS5 title runs Wine in its own process, with no winedevice for a HID
++ * stack, so the providers in provider.c find no controller there. In xinput
++ * mode the title keeps its controller's state where xinput's Unix library
++ * (xinput1_3.so) reads it; this provider reads it the same way, so a game
++ * finds the Xbox controller XInput reports (045e:028e) as a Gamepad and a
++ * RawGameController, as on a PC. It comes and goes with the controller.
++ * Anywhere else the library finds no title and nothing changes. */
++
++#include "private.h"
++
++#include "winternl.h"
++#include "xinput.h"
++
++#include "../xinput1_3/unixlib.h"
++
++#include "wine/debug.h"
++
++WINE_DEFAULT_DEBUG_CHANNEL(input);
++
++static unixlib_handle_t title_pad;
++/* while the title's controller is connected; only the monitor thread changes it */
++static IGameControllerProvider *title_pad_provider;
++static SRWLOCK vibration_lock = SRWLOCK_INIT;
++
++struct title_pad
++{
++    IWineGameControllerProvider IWineGameControllerProvider_iface;
++    IGameControllerProvider IGameControllerProvider_iface;
++    LONG ref;
++
++    struct WineGameControllerVibration vibration;
++};
++
++static inline struct title_pad *impl_from_IWineGameControllerProvider( IWineGameControllerProvider *iface )
++{
++    return CONTAINING_RECORD( iface, struct title_pad, IWineGameControllerProvider_iface );
++}
++
++static BOOL read_pad( struct xinput_pad_state *pad )
++{
++    memset( pad, 0, sizeof(*pad) );
++    if (!__wine_unix_call( title_pad, unix_pad_state, pad ) && pad->connected) return TRUE;
++    memset( pad, 0, sizeof(*pad) );
++    return FALSE;
++}
++
++static HRESULT WINAPI wine_provider_QueryInterface( IWineGameControllerProvider *iface, REFIID iid, void **out )
++{
++    struct title_pad *impl = impl_from_IWineGameControllerProvider( iface );
++
++    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
++
++    if (IsEqualGUID( iid, &IID_IUnknown ) ||
++        IsEqualGUID( iid, &IID_IInspectable ) ||
++        IsEqualGUID( iid, &IID_IAgileObject ) ||
++        IsEqualGUID( iid, &IID_IWineGameControllerProvider ))
++    {
++        IInspectable_AddRef( (*out = &impl->IWineGameControllerProvider_iface) );
++        return S_OK;
++    }
++
++    if (IsEqualGUID( iid, &IID_IGameControllerProvider ))
++    {
++        IInspectable_AddRef( (*out = &impl->IGameControllerProvider_iface) );
++        return S_OK;
++    }
++
++    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
++    *out = NULL;
++    return E_NOINTERFACE;
++}
++
++static ULONG WINAPI wine_provider_AddRef( IWineGameControllerProvider *iface )
++{
++    struct title_pad *impl = impl_from_IWineGameControllerProvider( iface );
++    ULONG ref = InterlockedIncrement( &impl->ref );
++    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
++    return ref;
++}
++
++static ULONG WINAPI wine_provider_Release( IWineGameControllerProvider *iface )
++{
++    struct title_pad *impl = impl_from_IWineGameControllerProvider( iface );
++    ULONG ref = InterlockedDecrement( &impl->ref );
++
++    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
++
++    if (!ref) free( impl );
++    return ref;
++}
++
++static HRESULT WINAPI wine_provider_GetIids( IWineGameControllerProvider *iface, ULONG *iid_count, IID **iids )
++{
++    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
++    return E_NOTIMPL;
++}
++
++static HRESULT WINAPI wine_provider_GetRuntimeClassName( IWineGameControllerProvider *iface, HSTRING *class_name )
++{
++    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
++    return E_NOTIMPL;
++}
++
++static HRESULT WINAPI wine_provider_GetTrustLevel( IWineGameControllerProvider *iface, TrustLevel *trust_level )
++{
++    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
++    return E_NOTIMPL;
++}
++
++static HRESULT WINAPI wine_provider_get_NonRoamableId( IWineGameControllerProvider *iface, HSTRING *value )
++{
++    FIXME( "iface %p, value %p stub!\n", iface, value );
++    return E_NOTIMPL;
++}
++
++static HRESULT WINAPI wine_provider_get_DisplayName( IWineGameControllerProvider *iface, HSTRING *value )
++{
++    static const WCHAR name[] = L"Controller (XBOX 360 For Windows)";
++
++    TRACE( "iface %p, value %p\n", iface, value );
++
++    return WindowsCreateString( name, wcslen( name ), value );
++}
++
++static HRESULT WINAPI wine_provider_get_Type( IWineGameControllerProvider *iface, WineGameControllerType *value )
++{
++    TRACE( "iface %p, value %p.\n", iface, value );
++
++    *value = WineGameControllerType_Gamepad;
++    return S_OK;
++}
++
++/* the six axes, ten buttons and one switch of an Xbox controller's HID
++ * collection (winexinput.sys), in the order gamepad.c reads them */
++static HRESULT WINAPI wine_provider_get_AxisCount( IWineGameControllerProvider *iface, INT32 *value )
++{
++    TRACE( "iface %p, value %p.\n", iface, value );
++
++    *value = 6;
++    return S_OK;
++}
++
++static HRESULT WINAPI wine_provider_get_ButtonCount( IWineGameControllerProvider *iface, INT32 *value )
++{
++    TRACE( "iface %p, value %p.\n", iface, value );
++
++    *value = 10;
++    return S_OK;
++}
++
++static HRESULT WINAPI wine_provider_get_SwitchCount( IWineGameControllerProvider *iface, INT32 *value )
++{
++    TRACE( "iface %p, value %p.\n", iface, value );
++
++    *value = 1;
++    return S_OK;
++}
++
++static GameControllerSwitchPosition dpad_position( WORD buttons )
++{
++    BOOL up = buttons & XINPUT_GAMEPAD_DPAD_UP, down = buttons & XINPUT_GAMEPAD_DPAD_DOWN;
++    BOOL left = buttons & XINPUT_GAMEPAD_DPAD_LEFT, right = buttons & XINPUT_GAMEPAD_DPAD_RIGHT;
++
++    if (up && down) up = down = FALSE;
++    if (left && right) left = right = FALSE;
++
++    if (up) return right ? GameControllerSwitchPosition_UpRight :
++                   left ? GameControllerSwitchPosition_UpLeft : GameControllerSwitchPosition_Up;
++    if (down) return right ? GameControllerSwitchPosition_DownRight :
++                     left ? GameControllerSwitchPosition_DownLeft : GameControllerSwitchPosition_Down;
++    if (right) return GameControllerSwitchPosition_Right;
++    if (left) return GameControllerSwitchPosition_Left;
++    return GameControllerSwitchPosition_Center;
++}
++
++static double thumb_axis( SHORT value )
++{
++    return (value + 32768) / 65535.;
++}
++
++static HRESULT WINAPI wine_provider_get_State( IWineGameControllerProvider *iface, struct WineGameControllerState *out )
++{
++    static const WORD buttons[] =
++    {
++        XINPUT_GAMEPAD_A,
++        XINPUT_GAMEPAD_B,
++        XINPUT_GAMEPAD_X,
++        XINPUT_GAMEPAD_Y,
++        XINPUT_GAMEPAD_LEFT_SHOULDER,
++        XINPUT_GAMEPAD_RIGHT_SHOULDER,
++        XINPUT_GAMEPAD_BACK,
++        XINPUT_GAMEPAD_START,
++        XINPUT_GAMEPAD_LEFT_THUMB,
++        XINPUT_GAMEPAD_RIGHT_THUMB,
++    };
++    struct xinput_pad_state pad;
++    UINT32 i;
++
++    TRACE( "iface %p, out %p.\n", iface, out );
++
++    /* a controller gone since the game looked holds still, centered,
++     * until the monitor thread removes it */
++    if (!read_pad( &pad )) WARN( "the title's controller is not connected\n" );
++
++    memset( out, 0, sizeof(*out) );
++    for (i = 0; i < ARRAY_SIZE(buttons); i++) out->buttons[i] = (pad.buttons & buttons[i]) != 0;
++    out->switches[0] = dpad_position( pad.buttons );
++    out->axes[0] = thumb_axis( pad.thumb_ly );
++    out->axes[1] = thumb_axis( pad.thumb_lx );
++    out->axes[2] = thumb_axis( pad.thumb_ry );
++    out->axes[3] = thumb_axis( pad.thumb_rx );
++    out->axes[4] = pad.left_trigger / 255.;
++    out->axes[5] = pad.right_trigger / 255.;
++    out->timestamp = GetTickCount64();
++
++    return S_OK;
++}
++
++static HRESULT WINAPI wine_provider_get_Vibration( IWineGameControllerProvider *iface, struct WineGameControllerVibration *out )
++{
++    struct title_pad *impl = impl_from_IWineGameControllerProvider( iface );
++
++    TRACE( "iface %p, out %p.\n", iface, out );
++
++    AcquireSRWLockShared( &vibration_lock );
++    *out = impl->vibration;
++    ReleaseSRWLockShared( &vibration_lock );
++    return S_OK;
++}
++
++/* The DualSense's two motors play the Xbox controller's: rumble the large
++ * one, buzz the small one. It has no motors in its triggers for left and
++ * right; the game still reads back what it set. */
++static HRESULT WINAPI wine_provider_put_Vibration( IWineGameControllerProvider *iface, struct WineGameControllerVibration value )
++{
++    struct title_pad *impl = impl_from_IWineGameControllerProvider( iface );
++    struct xinput_rumble_params params = {.left = value.rumble, .right = value.buzz};
++    NTSTATUS status;
++
++    TRACE( "iface %p, value %p.\n", iface, &value );
++
++    AcquireSRWLockExclusive( &vibration_lock );
++    impl->vibration = value;
++    if ((status = __wine_unix_call( title_pad, unix_pad_rumble, &params )))
++        WARN( "rumble failed, status %#lx\n", status );
++    ReleaseSRWLockExclusive( &vibration_lock );
++
++    return S_OK;
++}
++
++static HRESULT WINAPI wine_provider_get_ForceFeedbackMotor( IWineGameControllerProvider *iface, IForceFeedbackMotor **value )
++{
++    TRACE( "iface %p, value %p.\n", iface, value );
++
++    *value = NULL;
++    return S_OK;
++}
++
++static const struct IWineGameControllerProviderVtbl wine_provider_vtbl =
++{
++    wine_provider_QueryInterface,
++    wine_provider_AddRef,
++    wine_provider_Release,
++    /* IInspectable methods */
++    wine_provider_GetIids,
++    wine_provider_GetRuntimeClassName,
++    wine_provider_GetTrustLevel,
++    /* IWineGameControllerProvider methods */
++    wine_provider_get_NonRoamableId,
++    wine_provider_get_DisplayName,
++    wine_provider_get_Type,
++    wine_provider_get_AxisCount,
++    wine_provider_get_ButtonCount,
++    wine_provider_get_SwitchCount,
++    wine_provider_get_State,
++    wine_provider_get_Vibration,
++    wine_provider_put_Vibration,
++    wine_provider_get_ForceFeedbackMotor,
++};
++
++DEFINE_IINSPECTABLE( game_provider, IGameControllerProvider, struct title_pad, IWineGameControllerProvider_iface )
++
++static HRESULT WINAPI game_provider_get_FirmwareVersionInfo( IGameControllerProvider *iface, GameControllerVersionInfo *value )
++{
++    FIXME( "iface %p, value %p stub!\n", iface, value );
