index 0000000..d630245
--- /dev/null
+++ b/wine/patches/0491-winegstreamer-give-each-read-request-to-the-read-thread-once.patch
@@ -0,0 +1,75 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: SuperLeiyan <5438286+SuperLeiyan@users.noreply.github.com>
+Date: Tue, 27 Oct 2026 00:30:00 +0100
+Subject: [PATCH] winegstreamer: Give each of the parser's read requests to the
+ read thread once.
+
+The demuxer's read request stayed posted after the frontend's read thread
+answered it, until the demuxer thread woke and cleared it. A read thread
+that came back in between got the same request again and read its offset
+again; when the demuxer had meanwhile posted its next request, at another
+offset, that data answered it. FFmpeg's Matroska demuxer then found
+garbage ("0x00 ... invalid as first byte of an EBML number", "Element ...
+exceeds containing master element"), resynchronised, and skipped up to
+4 s of a movie's packets at a time: the movie stuttered and showed decoding
+damage, and its sound ran ahead.
+
+A request is now given to the read thread once, and push_data answers only
+the request it gave.
+---
+diff --git a/dlls/winegstreamer/ffmpeg_parser.c b/dlls/winegstreamer/ffmpeg_parser.c
+index 13baa6a..ec3506f 100644
+--- a/dlls/winegstreamer/ffmpeg_parser.c
++++ b/dlls/winegstreamer/ffmpeg_parser.c
+@@ -119,6 +119,9 @@ struct wg_parser
+         UINT32 size;            /* outstanding; 0 once answered */
+         UINT32 done_size;
+         bool done, error;
++        /* Given to the frontend's read thread (get_next_read_offset): a request is
++         * given once, and push_data answers only the request it was given. */
++        bool taken;
+     } read;
+ 
+     AVFormatContext *format;
+@@ -170,7 +173,7 @@ static int io_read(void *opaque, uint8_t *data, int size)
+     parser->read.data = data;
+     parser->read.offset = parser->position;
+     parser->read.size = size;
+-    parser->read.done = parser->read.error = false;
++    parser->read.done = parser->read.error = parser->read.taken = false;
+     parser->read.done_size = 0;
+     pthread_cond_broadcast(&parser->read_cond);
+ 
+@@ -219,7 +222,11 @@ NTSTATUS wg_parser_get_next_read_offset(void *args)
+     struct wg_parser *parser = get_parser(params->parser);
+ 
+     pthread_mutex_lock(&parser->mutex);
+-    while (parser->sink_connected && !parser->read.size)
++    /* A request already given out is not given again: once answered, it stays
++     * until the demuxer takes its data, and a read thread that came back for
++     * another in between read the same offset again, and gave that data to the
++     * demuxer's next request, at another offset. */
++    while (parser->sink_connected && (!parser->read.size || parser->read.taken))
+         pthread_cond_wait(&parser->read_cond, &parser->mutex);
+     if (!parser->sink_connected)
+     {
+@@ -228,6 +235,7 @@ NTSTATUS wg_parser_get_next_read_offset(void *args)
+     }
+     params->offset = parser->read.offset;
+     params->size = parser->read.size;
++    parser->read.taken = true;
+     pthread_mutex_unlock(&parser->mutex);
+     return S_OK;
+ }
+@@ -238,7 +246,7 @@ NTSTATUS wg_parser_push_data(void *args)
+     struct wg_parser *parser = get_parser(params->parser);
+ 
+     pthread_mutex_lock(&parser->mutex);
+-    if (parser->read.size && !parser->read.done)
++    if (parser->read.size && parser->read.taken && !parser->read.done)
+     {
+         if (params->data)
+         {
+-- 
