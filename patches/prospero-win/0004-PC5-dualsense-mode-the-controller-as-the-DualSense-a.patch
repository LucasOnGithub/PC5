++/* dualsense mode (PW_DUALSENSE=1, which a PS5 title sets): the game finds
++ * the title's controller as the DualSense a PC finds plugged in by USB,
++ * through SetupAPI and HID, DirectInput or raw input.
++ *
++ * A PS5 title runs Wine in its own process and cannot start winedevice, so
++ * there is no HID class driver to make the device. xinput1_3, which ntdll
++ * loads at the start in this mode, makes it on a thread of the game's
++ * process instead: a device manager and a device in the server, a symbolic
++ * link, the device instance and interface where plug and play leaves them in
++ * the registry (volatile keys, which go with the server), and the device's
++ * I/O answered as hidclass.sys answers it for a HID collection: reads from
++ * each open file's queue of input reports, which the thread fills 250 times
++ * a second as a DualSense sends them, the HID ioctls, output and feature
++ * reports, and the input sent on as raw input. The reports are the Unix
++ * library's (pw_dualsense.h), the preparsed data hidparse.sys's
++ * (dualsense_hid.c). */
++
++#include <stdarg.h>
++#include <stdlib.h>
++#include <string.h>
++
++#include "ntstatus.h"
++#define WIN32_NO_STATUS
++#include "windef.h"
++#include "winbase.h"
