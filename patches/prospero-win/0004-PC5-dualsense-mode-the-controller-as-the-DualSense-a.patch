+static void dualsense_effects(PwPadPs5 *pad, const PwDualSenseOutput *out, uint64_t *count)
+{
+    uint8_t large = out->motor_large, small = out->motor_small;
+#ifdef PW_PC5
+    if (pc5_game_on) {
+        Pc5PadOutput pc5;
+        memset(&pc5, 0, sizeof(pc5));
+        pc5.set = (out->set & PW_DUALSENSE_MOTORS ? PC5_OUTPUT_MOTORS : 0u) |
+                  (out->set & PW_DUALSENSE_LIGHT ? PC5_OUTPUT_LIGHT : 0u) |
+                  (out->set & (PW_DUALSENSE_LEFT_TRIGGER | PW_DUALSENSE_RIGHT_TRIGGER) ? PC5_OUTPUT_TRIGGERS : 0u);
+        pc5.large = large;
+        pc5.small = small;
+        pc5.light = (uint32_t)out->light[0] << 16 | (uint32_t)out->light[1] << 8 | out->light[2];
+        for (int i = 0; i < 2; i++) {
+            PwDualSenseTrigger trigger;
+            pw_dualsense_trigger(out->trigger[i], &trigger);
+            pc5.trigger[i].mode = trigger.mode != PW_DS_TRIGGER_OFF ? PC5_TRIGGER_GAME : PC5_TRIGGER_OFF;
+            pc5.trigger[i].effect = (uint8_t)trigger.mode;
+            memcpy(pc5.trigger[i].data, trigger.data, sizeof(pc5.trigger[i].data));
+        }
+        pc5_game_output(&pc5_game, pad->pad_handle, &pc5, &large, &small);
+    }
+#endif
+    int vibrate = pw_pad_ps5_vibrate(pad, large, small);
+    if (!(*count)++ || vibrate != PW_OK)
+        PS5LOG_LOG("PW_WINE64 dualsense output set=%#x motors=%u/%u light=%02x%02x%02x triggers=%#x/%#x "
+                   "status=%s rc=%d", (unsigned)out->set, large, small, out->light[0], out->light[1], out->light[2],
+                   out->trigger[0][0], out->trigger[1][0], pw_result_name(vibrate), pad->vibration_rc);
+}
