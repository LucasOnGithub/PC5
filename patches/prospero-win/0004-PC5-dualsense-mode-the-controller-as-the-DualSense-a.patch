++
++/* The DualSense's preparsed data, which hid.dll's HidP_ calls read, is what
++ * hidclass.sys gets from hidparse.sys's HidP_GetCollectionDescription. A
++ * PS5 title has no driver process to load hidparse.sys into, so its code is
++ * built here, with the pool allocations it makes from the heap. */
++
++#include <stdarg.h>
++#include <stdlib.h>
++
++#include "ntstatus.h"
++#include "windef.h"
++#include "winbase.h"
++#include "winternl.h"
++#include "winioctl.h"
++
++#include <ddk/wdm.h>
++#include <ddk/hidpddi.h>
++
++#define ExAllocatePool( type, size ) ((void)(type), malloc( size ))
++#define ExFreePool( ptr ) free( ptr )
++#define DriverEntry dualsense_hidparse_entry
++
++#include "../hidparse.sys/main.c"
+-- 
