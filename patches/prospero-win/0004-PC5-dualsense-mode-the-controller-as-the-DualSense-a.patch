+int pw_wine_dualsense_state(const PwPadPs5 *pad, PwDualSenseState *out)
+{
+    if (!out) return 0;
+    memset(out, 0, sizeof(*out));
+    out->lx = out->ly = out->rx = out->ry = 0x80;
+    if (!pad || !pad->core.connected) return 0;
+    out->connected = 1;
+    out->buttons = pad->core.previous_buttons;
+    out->lx = pad->left_stick.x;
+    out->ly = pad->left_stick.y;
+    out->rx = pad->right_stick.x;
+    out->ry = pad->right_stick.y;
+    out->l2 = pad->l2;
+    out->r2 = pad->r2;
+    out->touches = pad->touch.fingers > 2 ? 2 : pad->touch.fingers;
+    for (unsigned i = 0; i < out->touches; i++) {
+        out->touch_x[i] = pad->touch.touch[i].x;
+        out->touch_y[i] = pad->touch.touch[i].y;
+        out->touch_id[i] = pad->touch.touch[i].finger;
+    }
+    memcpy(out->gyro, pad->angular_velocity, sizeof(out->gyro));
+    memcpy(out->accel, pad->acceleration, sizeof(out->accel));
+    out->timestamp_us = pad->timestamp;
+    return 1;
+}
