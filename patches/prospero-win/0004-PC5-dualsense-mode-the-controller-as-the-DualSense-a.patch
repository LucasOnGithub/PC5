new file mode 100644
index 0000000..cbbd20c
--- /dev/null
+++ b/tests/test_pw_dualsense.c
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../wine/ps5/input/pw_dualsense.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+/* The descriptor's report sizes in bits, walked item by item: by type
+ * (0 input, 1 output, 2 feature) and report id. */
+static unsigned bits[3][256];
+
+static void walk_descriptor(void)
+{
+    const uint8_t *d = pw_dualsense_descriptor;
+    size_t n = sizeof(pw_dualsense_descriptor), at = 0;
+    unsigned size = 0, count = 0, id = 0, depth = 0;
+
+    memset(bits, 0, sizeof(bits));
+    while (at < n) {
+        uint8_t prefix = d[at];
+        unsigned length = prefix & 3, value = 0;
+        if (length == 3) length = 4;
+        assert(at + 1 + length <= n);
+        for (unsigned i = 0; i < length; i++) value |= (unsigned)d[at + 1 + i] << (8 * i);
+        switch (prefix & 0xfc) {
+        case 0x74: size = value; break;              /* report size */
+        case 0x94: count = value; break;             /* report count */
+        case 0x84: id = value; break;                /* report id */
+        case 0x80: bits[0][id] += size * count; break;
+        case 0x90: bits[1][id] += size * count; break;
+        case 0xb0: bits[2][id] += size * count; break;
+        case 0xa0: depth++; break;
+        case 0xc0: assert(depth); depth--; break;
+        default: break;
+        }
+        at += 1 + length;
+    }
+    assert(at == n && depth == 0);
+}
+
+static void test_descriptor(void)
+{
+    walk_descriptor();
+    assert(bits[0][1] == (PW_DUALSENSE_INPUT_SIZE - 1) * 8);
+    assert(bits[1][2] == (PW_DUALSENSE_OUTPUT_SIZE - 1) * 8);
+    for (size_t i = 0; i < sizeof(pw_dualsense_features) / sizeof(pw_dualsense_features[0]); i++) {
+        uint8_t id = pw_dualsense_features[i].id;
+        assert(bits[2][id] == (pw_dualsense_features[i].length - 1u) * 8u);
+        assert(pw_dualsense_features[i].length <= PW_DUALSENSE_FEATURE_SIZE);
+        assert(pw_dualsense_feature(id, NULL, 0) == pw_dualsense_features[i].length);
+    }
+    for (unsigned id = 0; id < 256; id++) {
+        if (id != 1) assert(!bits[0][id]);
+        if (id != 2) assert(!bits[1][id]);
+    }
+}
+
+static PwDualSenseState centred(void)
+{
+    PwDualSenseState s;
+    memset(&s, 0, sizeof(s));
+    s.connected = 1;
+    s.lx = s.ly = s.rx = s.ry = 0x80;
+    return s;
+}
+
+static void test_input(void)
+{
+    uint8_t r[PW_DUALSENSE_INPUT_SIZE];
+    PwDualSenseState s = centred();
+
+    pw_dualsense_input(&s, 7, r);
+    assert(r[0] == 1 && r[1] == 0x80 && r[2] == 0x80 && r[3] == 0x80 && r[4] == 0x80 && !r[5] && !r[6] && r[7] == 7);
+    assert(r[8] == 8 && !r[9] && !r[10]);                     /* the hat at rest, nothing pressed */
+    assert(r[33] & 0x80 && r[37] & 0x80);                    /* no fingers on the touchpad */
+    assert(r[53] == 0x0a);
+    /* Sticks and triggers as they are. */
+    s.lx = 0; s.ly = 255; s.rx = 10; s.ry = 200; s.l2 = 33; s.r2 = 255;
+    pw_dualsense_input(&s, 0, r);
+    assert(r[1] == 0 && r[2] == 255 && r[3] == 10 && r[4] == 200 && r[5] == 33 && r[6] == 255);
+    /* Each button where a DualSense puts it. */
+    static const struct { uint32_t pad; int byte; uint8_t bit; } buttons[] = {
+        { PW_DS_PAD_SQUARE, 8, 0x10 }, { PW_DS_PAD_CROSS, 8, 0x20 }, { PW_DS_PAD_CIRCLE, 8, 0x40 },
+        { PW_DS_PAD_TRIANGLE, 8, 0x80 }, { PW_DS_PAD_L1, 9, 0x01 }, { PW_DS_PAD_R1, 9, 0x02 },
+        { PW_DS_PAD_L2, 9, 0x04 }, { PW_DS_PAD_R2, 9, 0x08 }, { PW_DS_PAD_CREATE, 9, 0x10 },
+        { PW_DS_PAD_OPTIONS, 9, 0x20 }, { PW_DS_PAD_L3, 9, 0x40 }, { PW_DS_PAD_R3, 9, 0x80 },
+        { PW_DS_PAD_TOUCHPAD, 10, 0x02 },
+    };
+    for (size_t i = 0; i < sizeof(buttons) / sizeof(buttons[0]); i++) {
+        s = centred();
+        s.buttons = buttons[i].pad;
+        pw_dualsense_input(&s, 0, r);
+        assert(r[buttons[i].byte] == (buttons[i].byte == 8 ? (uint8_t)(buttons[i].bit | 8) : buttons[i].bit));
+        for (int b = 9; b <= 11; b++) if (b != buttons[i].byte) assert(!r[b]);
+    }
+    /* The d-pad as the hat, diagonals too; opposite directions cancel. */
+    static const struct { uint32_t pad; uint8_t hat; } hats[] = {
+        { PW_DS_PAD_UP, 0 }, { PW_DS_PAD_UP | PW_DS_PAD_RIGHT, 1 }, { PW_DS_PAD_RIGHT, 2 },
+        { PW_DS_PAD_DOWN | PW_DS_PAD_RIGHT, 3 }, { PW_DS_PAD_DOWN, 4 }, { PW_DS_PAD_DOWN | PW_DS_PAD_LEFT, 5 },
+        { PW_DS_PAD_LEFT, 6 }, { PW_DS_PAD_UP | PW_DS_PAD_LEFT, 7 }, { PW_DS_PAD_UP | PW_DS_PAD_DOWN, 8 },
+        { PW_DS_PAD_LEFT | PW_DS_PAD_RIGHT | PW_DS_PAD_UP, 0 },
+    };
+    for (size_t i = 0; i < sizeof(hats) / sizeof(hats[0]); i++) assert(pw_dualsense_hat(hats[i].pad) == hats[i].hat);
+    /* Motion: 16 to a degree a second, 8192 to a g, clamped. */
+    s = centred();
+    s.gyro[0] = 1.0f;                 /* 57.3 degrees a second */
+    s.gyro[1] = -0.5f;
+    s.gyro[2] = 100.0f;               /* beyond the range */
+    s.accel[0] = 0.0f; s.accel[1] = -1.0f; s.accel[2] = 0.5f;
+    s.timestamp_us = 1000;
+    pw_dualsense_input(&s, 0, r);
+    assert((int16_t)(r[16] | r[17] << 8) == 917 && (int16_t)(r[18] | r[19] << 8) == -458);
+    assert((int16_t)(r[20] | r[21] << 8) == 32767);
+    assert((int16_t)(r[22] | r[23] << 8) == 0 && (int16_t)(r[24] | r[25] << 8) == -8192 &&
+           (int16_t)(r[26] | r[27] << 8) == 4096);
+    assert((uint32_t)(r[28] | r[29] << 8 | r[30] << 16 | (uint32_t)r[31] << 24) == 3000);
+    /* Two fingers: each one's number, x and y in 12 bits; past the edge, clamped. */
+    s = centred();
+    s.touches = 2;
+    s.touch_id[0] = 5; s.touch_x[0] = 1919; s.touch_y[0] = 1079;
+    s.touch_id[1] = 0x86; s.touch_x[1] = 3000; s.touch_y[1] = 0x123;
+    pw_dualsense_input(&s, 0, r);
+    assert(r[33] == 5 && r[34] == 0x7f && r[35] == (0x07 | 0x70) && r[36] == 0x43);
+    assert(r[37] == 0x06 && r[38] == 0x7f && r[39] == (0x07 | 0x30) && r[40] == 0x12);
+    s.touches = 1;
+    pw_dualsense_input(&s, 0, r);
+    assert(!(r[33] & 0x80) && (r[37] & 0x80));
+    /* Disconnected: neutral, whatever the state says. */
+    s = centred();
+    s.connected = 0; s.buttons = PW_DS_PAD_CROSS; s.lx = 0; s.r2 = 200; s.touches = 2;
+    pw_dualsense_input(&s, 0, r);
+    assert(r[1] == 0x80 && !r[6] && r[8] == 8 && (r[33] & 0x80) && (r[37] & 0x80));
+    assert((int16_t)(r[24] | r[25] << 8) == 8192);
+}
+
+static void test_output(void)
+{
+    uint8_t r[PW_DUALSENSE_OUTPUT_SIZE];
+    PwDualSenseOutput out;
+
+    memset(&out, 0, sizeof(out));
+    memset(r, 0, sizeof(r));
+    r[0] = 2;
+    assert(!pw_dualsense_parse_output(r, sizeof(r), &out) && out.sequence == 0);   /* asks nothing */
+    /* Rumble, as SDL sends it. */
+    r[1] = 0x03; r[3] = 40; r[4] = 200;
+    assert(pw_dualsense_parse_output(r, sizeof(r), &out) == 1);
+    assert(out.motor_small == 40 && out.motor_large == 200 && out.set == PW_DUALSENSE_MOTORS && out.sequence == 1);
+    /* The triggers and the light bar. */
+    memset(r, 0, sizeof(r));
+    r[0] = 2; r[1] = 0x0c; r[2] = 0x14;
+    r[11] = 0x21; r[12] = 0xff;            /* R2 */
+    r[22] = 0x01; r[23] = 0x80; r[24] = 0xff;   /* L2 */
+    r[44] = 0x04; r[45] = 255; r[46] = 64; r[47] = 1;
+    assert(pw_dualsense_parse_output(r, sizeof(r), &out) == 1 && out.sequence == 2);
+    assert(out.trigger[1][0] == 0x21 && out.trigger[1][1] == 0xff && out.trigger[0][0] == 0x01 && out.trigger[0][2] == 0xff);
+    assert(out.light[0] == 255 && out.light[1] == 64 && out.light[2] == 1 && out.player_leds == 0x04);
+    assert(out.set == (PW_DUALSENSE_MOTORS | PW_DUALSENSE_LIGHT | PW_DUALSENSE_LEFT_TRIGGER | PW_DUALSENSE_RIGHT_TRIGGER |
+                       PW_DUALSENSE_PLAYER_LEDS));
+    assert(out.motor_large == 200);        /* kept: not asked this time */
+    /* Another report, a short one, or nothing: refused. */
+    r[0] = 0x31;
+    assert(!pw_dualsense_parse_output(r, sizeof(r), &out));
+    assert(!pw_dualsense_parse_output(NULL, 48, &out) && !pw_dualsense_parse_output(r, 2, &out));
+    /* A short report 2 reads as zeros past its end. */
+    uint8_t shortr[5] = { 2, 0x01, 0, 9, 8 };
+    assert(pw_dualsense_parse_output(shortr, sizeof(shortr), &out) && out.motor_small == 9 && out.motor_large == 8);
+    assert(out.sequence == 3);
+}
+
+static void test_features(void)
+{
+    uint8_t r[PW_DUALSENSE_FEATURE_SIZE];
+
+    memset(r, 0x5a, sizeof(r));
+    assert(pw_dualsense_feature(0x05, r, sizeof(r)) == 41 && r[0] == 0x05);
+    assert((int16_t)(r[7] | r[8] << 8) == 32000 && (int16_t)(r[9] | r[10] << 8) == -32000);
+    assert((int16_t)(r[19] | r[20] << 8) == 2000 && (int16_t)(r[21] | r[22] << 8) == 2000);
+    assert((int16_t)(r[23] | r[24] << 8) == 8192 && (int16_t)(r[33] | r[34] << 8) == -8192);
+    assert(!r[1] && !r[3] && !r[5] && r[41] == 0x5a);   /* biases 0; nothing written past its length */
+    /* With the units above, a reading means what the input report says: a
+     * gyro step is (2000 + 2000) / (32000 + 32000) = 1/16 degree a second. */
+    assert(2 * 2000 * PW_DUALSENSE_GYRO_PER_DEGREE == 2 * 32000);
+    assert(pw_dualsense_feature(0x09, r, sizeof(r)) == 20 && r[0] == 0x09 && r[1] == 0x35 && r[6] == 0x7c);
+    assert(pw_dualsense_feature(0x20, r, sizeof(r)) == 64 && !memcmp(r + 1, "Jun 10 2024", 11) &&
+           (r[44] | r[45] << 8) == 0x0630);
+    assert(pw_dualsense_feature(0x08, r, sizeof(r)) == 48 && r[0] == 0x08 && !r[1] && !r[47]);
+    assert(pw_dualsense_feature(0x33, r, sizeof(r)) == 0 && pw_dualsense_feature(0x01, r, sizeof(r)) == 0);
+    /* Into a smaller buffer: what fits. */
+    memset(r, 0x5a, sizeof(r));
+    assert(pw_dualsense_feature(0x20, r, 10) == 64 && r[0] == 0x20 && r[10] == 0x5a);
+}
+
+static void test_triggers(void)
+{
+    uint8_t e[11];
+    PwDualSenseTrigger t;
+
+    memset(e, 0, sizeof(e));
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_OFF);
+    e[0] = 0x05;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_OFF);
+    /* Resistance from a point. */
+    memset(e, 0, sizeof(e)); e[0] = 0x01; e[1] = 0x80; e[2] = 0xff;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_FEEDBACK && t.data[0] == 5 && t.data[1] == 8);
+    e[2] = 0;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_OFF);
+    /* Between two points. */
+    memset(e, 0, sizeof(e)); e[0] = 0x02; e[1] = 0x00; e[2] = 0x00; e[3] = 0x80;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_WEAPON && t.data[0] == 2 && t.data[1] == 3 && t.data[2] == 4);
+    /* A vibration. */
+    memset(e, 0, sizeof(e)); e[0] = 0x06; e[1] = 30; e[2] = 0xff; e[3] = 0;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_VIBRATION && t.data[0] == 0 && t.data[1] == 8 && t.data[2] == 30);
+    /* Zone by zone: zones 0, 2 and 9, firmness 1, 3 and 8. */
+    memset(e, 0, sizeof(e)); e[0] = 0x21;
+    e[1] = 0x05; e[2] = 0x02;
+    {
+        uint32_t packed = 0u << 0 | 2u << 6 | 7u << 27;
+        e[3] = (uint8_t)packed; e[4] = (uint8_t)(packed >> 8); e[5] = (uint8_t)(packed >> 16); e[6] = (uint8_t)(packed >> 24);
+    }
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_MULTIPLE_FEEDBACK && t.data[0] == 1 && t.data[1] == 0 && t.data[2] == 3 && t.data[9] == 8);
+    /* A weapon from zone 3 to 6, firmness 5. */
+    memset(e, 0, sizeof(e)); e[0] = 0x25; e[1] = (1 << 3) | (1 << 6); e[3] = 4;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_WEAPON && t.data[0] == 3 && t.data[1] == 6 && t.data[2] == 5);
+    e[1] = 1 << 3;                                       /* one zone: not a weapon */
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_OFF);
+    /* A vibration zone by zone at 40 Hz. */
+    memset(e, 0, sizeof(e)); e[0] = 0x26; e[1] = 0xff; e[2] = 0x03; e[9] = 40;
+    {
+        uint32_t packed = 0;
+        for (int i = 0; i < 10; i++) packed |= (uint32_t)(i % 8) << (3 * i);
+        e[3] = (uint8_t)packed; e[4] = (uint8_t)(packed >> 8); e[5] = (uint8_t)(packed >> 16); e[6] = (uint8_t)(packed >> 24);
+    }
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_MULTIPLE_VIBRATION && t.data[0] == 40 && t.data[1] == 1 && t.data[8] == 8 &&
+           t.data[9] == 1 && t.data[10] == 2);
+    e[9] = 0;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_OFF);
+    /* A machine between zones 1 and 8. */
+    memset(e, 0, sizeof(e)); e[0] = 0x27; e[1] = 0x02; e[2] = 0x01; e[3] = 2; e[4] = 25;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_VIBRATION && t.data[0] == 1 && t.data[1] == 3 && t.data[2] == 25);
+    /* Anything else: off. */
+    memset(e, 0, sizeof(e)); e[0] = 0x7f; e[1] = 0xff;
+    pw_dualsense_trigger(e, &t);
+    assert(t.mode == PW_DS_TRIGGER_OFF);
+}
+
+int main(void)
+{
+    test_descriptor();
+    test_input();
+    test_output();
+    test_features();
+    test_triggers();
+    printf("dualsense passed: the descriptor's report sizes, input report 1 (sticks, triggers, every button, the hat, "
+           "motion, the touchpad, disconnected), output report 2 (motors, triggers, light bar), feature reports, "
+           "trigger effects as libScePad's\n");
+    return 0;
+}
