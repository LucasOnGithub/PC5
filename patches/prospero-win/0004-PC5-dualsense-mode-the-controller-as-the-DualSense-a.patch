++/* dualsense mode: the title's whole controller, touchpad and motion too
++ * (pw_wine_dualsense), and the output reports a game sends it, which the
++ * title reads back (pw_wine_dualsense_report). */
++static int (*title_dualsense)( PwDualSenseState *state );
++static int (*title_dualsense_report)( const uint8_t *report, uint32_t size );
++
