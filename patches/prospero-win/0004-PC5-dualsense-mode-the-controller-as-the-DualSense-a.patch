diff --git a/wine/patches/0476-ntdll-load-xinput-for-the-dualsense.patch b/wine/patches/0476-ntdll-load-xinput-for-the-dualsense.patch
new file mode 100644
index 0000000..2089854
--- /dev/null
+++ b/wine/patches/0476-ntdll-load-xinput-for-the-dualsense.patch
@@ -0,0 +1,63 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 23 Oct 2026 20:40:00 +0200
+Subject: [PATCH] ntdll: Load xinput1_3 at the start for the PS5 title's DualSense.
+
+In dualsense mode (PW_DUALSENSE=1) xinput1_3 makes the title's
+controller a DualSense (patch 0475), which must exist before the game
+looks for controllers, whether or not the game imports an xinput. Once
+the main module's dependencies are attached, xinput1_3 is loaded from
+the system directory (a game's own copy has no DualSense); a failure is
+logged and the game runs on. In a WoW64 process the 32-bit side loads
+it.
+---
+ dlls/ntdll/loader.c |   27 +++++++++++++++++++++++++++
+ 1 file changed, 27 insertions(+)
+
+diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
+index a0992cf..1cb22bf 100644
+--- a/dlls/ntdll/loader.c
++++ b/dlls/ntdll/loader.c
+@@ -4429,6 +4429,32 @@ static void init_wow64( CONTEXT *context )
+ #endif
+ 
+ 
++/* dualsense mode (PW_DUALSENSE=1, which a PS5 title sets): xinput1_3 makes
++ * the title's controller a DualSense (its dualsense.c), which must be there
++ * before the game looks for controllers. It comes from the system
++ * directory: a game's own xinput1_3.dll has no DualSense. */
++static void load_dualsense(void)
++{
++    static const WCHAR variable[] = L"PW_DUALSENSE";
++    WCHAR value[2], path[MAX_PATH];
++    UNICODE_STRING name;
++    HMODULE module;
++    NTSTATUS status;
++    SIZE_T len;
++
++#ifdef _WIN64
++    if (NtCurrentTeb()->WowTebOffset) return;  /* the 32-bit side does it */
++#endif
++    if (RtlQueryEnvironmentVariable( NULL, variable, wcslen( variable ), value, ARRAY_SIZE(value), &len ) ||
++        len != 1 || value[0] != '1')
++        return;
++    wcscpy( path, system_dir );
++    wcscat( path, L"xinput1_3.dll" );
++    RtlInitUnicodeString( &name, path );
++    if ((status = LdrLoadDll( NULL, 0, &name, &module )))
++        ERR( "cannot load %s for the DualSense, status %lx\n", debugstr_w(path), status );
++}
++
+ /* release some address space once dlls are loaded*/
+ static void release_address_space(void)
+ {
+@@ -4581,6 +4607,7 @@ void loader_init( CONTEXT *context, void **entry )
+                  debugstr_w(NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer), status );
+             NtTerminateProcess( GetCurrentProcess(), status );
+         }
++        load_dualsense();
+         release_address_space();
+         if (wm->ldr.TlsIndex == -1) call_tls_callbacks( wm->ldr.DllBase, DLL_PROCESS_ATTACH );
+         if (wm->ldr.ActivationContext) RtlDeactivateActivationContext( 0, cookie );
+-- 
+2.43.0
diff --git a/wine/ps5/input/pw_dualsense.h b/wine/ps5/input/pw_dualsense.h
new file mode 100644
index 0000000..d8f5ed6
--- /dev/null
+++ b/wine/ps5/input/pw_dualsense.h
@@ -0,0 +1,384 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_DUALSENSE_H
+#define PW_DUALSENSE_H
+/*
+ * The DualSense as a PC sees one plugged in by USB: a HID game pad, Sony's
+ * 054c:0ce6, with its own reports. A game in dualsense mode finds the
+ * title's controller this way (xinput1_3's dualsense.c answers as Windows'
+ * HID class driver would, wine/patches/0475): the title gives its state
+ * (PwDualSenseState), this file makes the input report a DualSense sends,
+ * reads the output reports a game sends back (rumble, light bar, the
+ * adaptive triggers' effects) and answers the feature reports games and
+ * SDL ask for (calibration, pairing, firmware).
+ *
+ * Header only, with no Windows or console headers: Wine's xinput Unix
+ * library includes it (staged beside it by both Wine builds), and so do the
+ * host tests and the title.
+ *
+ * The report layouts are the DualSense's USB ones, as Linux's
+ * hid-playstation driver and SDL's HIDAPI driver read them.
+ */
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+enum {
+    PW_DUALSENSE_VENDOR = 0x054c, PW_DUALSENSE_PRODUCT = 0x0ce6, PW_DUALSENSE_VERSION = 0x0100,
+    PW_DUALSENSE_INPUT_SIZE = 64,    /* report 1, with its id */
+    PW_DUALSENSE_OUTPUT_SIZE = 48,   /* report 2, with its id */
+    PW_DUALSENSE_FEATURE_SIZE = 64,  /* the longest feature report, with its id */
+};
+
+/* The title's controller, laid out alike for 32- and 64-bit code (no
+ * pointers, fixed sizes): what the sink keeps (wine/ps5/pw_wine_sink.h). */
+typedef struct PwDualSenseState {
+    uint32_t connected;              /* 0: no controller */
+    uint32_t packet;                 /* the sink's: changes whenever the state does */
+    uint32_t buttons;                /* scePadRead's bits */
+    uint8_t lx, ly, rx, ry;          /* 0-255, 0x80 centred, left and up 0 */
+    uint8_t l2, r2;                  /* 0-255 */
+    uint8_t touches;                 /* fingers on the touchpad, 0-2 */
+    uint8_t reserved;
+    uint16_t touch_x[2], touch_y[2]; /* 0-1919, 0-1079 */
+    uint8_t touch_id[2];             /* each finger's number, while it stays down */
+    uint8_t reserved2[2];
+    float gyro[3];                   /* angular velocity, radians a second (pitch, yaw, roll) */
+    float accel[3];                  /* acceleration, g (x, y, z) */
+    uint64_t timestamp_us;
+} PwDualSenseState;
+
+/* What a game's output reports asked of the controller. */
+enum {
+    PW_DUALSENSE_MOTORS = 1u << 0, PW_DUALSENSE_LIGHT = 1u << 1,
+    PW_DUALSENSE_LEFT_TRIGGER = 1u << 2, PW_DUALSENSE_RIGHT_TRIGGER = 1u << 3,
+    PW_DUALSENSE_PLAYER_LEDS = 1u << 4,
+};
+typedef struct PwDualSenseOutput {
+    uint32_t sequence;               /* changes with each report that asks something */
+    uint32_t set;                    /* PW_DUALSENSE_*: what a game has set so far */
+    uint8_t motor_large, motor_small;
+    uint8_t light[3];                /* red, green, blue */
+    uint8_t player_leds;
+    uint8_t trigger[2][11];          /* L2, R2: the DualSense's effect, its mode and ten numbers */
+} PwDualSenseOutput;
+
+/* scePadRead's buttons. */
+enum {
+    PW_DS_PAD_CREATE = 0x1u, PW_DS_PAD_L3 = 0x2u, PW_DS_PAD_R3 = 0x4u, PW_DS_PAD_OPTIONS = 0x8u,
+    PW_DS_PAD_UP = 0x10u, PW_DS_PAD_RIGHT = 0x20u, PW_DS_PAD_DOWN = 0x40u, PW_DS_PAD_LEFT = 0x80u,
+    PW_DS_PAD_L2 = 0x100u, PW_DS_PAD_R2 = 0x200u, PW_DS_PAD_L1 = 0x400u, PW_DS_PAD_R1 = 0x800u,
+    PW_DS_PAD_TRIANGLE = 0x1000u, PW_DS_PAD_CIRCLE = 0x2000u, PW_DS_PAD_CROSS = 0x4000u,
+    PW_DS_PAD_SQUARE = 0x8000u, PW_DS_PAD_TOUCHPAD = 0x100000u,
+};
+
+/* The motion sensors' units, which the calibration report (5) states: 16 to
+ * a degree a second, 8192 to a g. */
+enum { PW_DUALSENSE_GYRO_PER_DEGREE = 16, PW_DUALSENSE_ACCEL_PER_G = 8192 };
+
+/* The report descriptor: report 1 in (the sticks X Y Z Rz, the triggers Rx
+ * Ry, a counter, the hat, 15 buttons, then the DualSense's own data), report
+ * 2 out, and the feature reports a DualSense has. */
+static const uint8_t pw_dualsense_descriptor[] = {
+    0x05, 0x01, 0x09, 0x05, 0xa1, 0x01,             /* Generic Desktop, Game Pad, Application */
+    0x85, 0x01,                                     /*   report 1 */
+    0x09, 0x30, 0x09, 0x31, 0x09, 0x32, 0x09, 0x35, /*   X Y Z Rz: the sticks */
+    0x09, 0x33, 0x09, 0x34,                         /*   Rx Ry: the triggers */
+    0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x06, 0x81, 0x02,
+    0x06, 0x00, 0xff, 0x09, 0x20, 0x95, 0x01, 0x81, 0x02,             /*   the counter */
+    0x05, 0x01, 0x09, 0x39, 0x15, 0x00, 0x25, 0x07, 0x35, 0x00, 0x46, 0x3b, 0x01,
+    0x65, 0x14, 0x75, 0x04, 0x95, 0x01, 0x81, 0x42, 0x65, 0x00,       /*   the hat, 0-7 or none */
+    0x05, 0x09, 0x19, 0x01, 0x29, 0x0f, 0x15, 0x00, 0x25, 0x01, 0x75, 0x01, 0x95, 0x0f, 0x81, 0x02,
+    0x06, 0x00, 0xff, 0x09, 0x21, 0x95, 0x0d, 0x81, 0x02,             /*   13 bits */
+    0x06, 0x00, 0xff, 0x09, 0x22, 0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x34, 0x81, 0x02,
+    0x85, 0x02, 0x09, 0x23, 0x95, 0x2f, 0x91, 0x02,  /*   report 2 out: 47 bytes */
+    0x85, 0x05, 0x09, 0x33, 0x95, 0x28, 0xb1, 0x02,  /*   feature 5: calibration */
+    0x85, 0x08, 0x09, 0x34, 0x95, 0x2f, 0xb1, 0x02,
+    0x85, 0x09, 0x09, 0x24, 0x95, 0x13, 0xb1, 0x02,  /*   feature 9: pairing */
+    0x85, 0x0a, 0x09, 0x25, 0x95, 0x1a, 0xb1, 0x02,
+    0x85, 0x20, 0x09, 0x26, 0x95, 0x3f, 0xb1, 0x02,  /*   feature 0x20: firmware */
+    0x85, 0x21, 0x09, 0x27, 0x95, 0x04, 0xb1, 0x02,
+    0x85, 0x22, 0x09, 0x40, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0x80, 0x09, 0x28, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0x81, 0x09, 0x29, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0x82, 0x09, 0x2a, 0x95, 0x09, 0xb1, 0x02,
+    0x85, 0x83, 0x09, 0x2b, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0x84, 0x09, 0x2c, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0x85, 0x09, 0x2d, 0x95, 0x02, 0xb1, 0x02,
+    0x85, 0xa0, 0x09, 0x2e, 0x95, 0x01, 0xb1, 0x02,
+    0x85, 0xe0, 0x09, 0x2f, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0xf0, 0x09, 0x30, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0xf1, 0x09, 0x31, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0xf2, 0x09, 0x32, 0x95, 0x0f, 0xb1, 0x02,
+    0x85, 0xf4, 0x09, 0x35, 0x95, 0x3f, 0xb1, 0x02,
+    0x85, 0xf5, 0x09, 0x36, 0x95, 0x03, 0xb1, 0x02,
+    0xc0,
+};
+
+/* The feature reports, with their lengths (the id included). */
+static const struct { uint8_t id, length; } pw_dualsense_features[] = {
+    { 0x05, 41 }, { 0x08, 48 }, { 0x09, 20 }, { 0x0a, 27 }, { 0x20, 64 }, { 0x21, 5 }, { 0x22, 64 },
+    { 0x80, 64 }, { 0x81, 64 }, { 0x82, 10 }, { 0x83, 64 }, { 0x84, 64 }, { 0x85, 3 }, { 0xa0, 2 },
+    { 0xe0, 64 }, { 0xf0, 64 }, { 0xf1, 64 }, { 0xf2, 16 }, { 0xf4, 64 }, { 0xf5, 4 },
+};
+
+static inline void pw_dualsense_le16(uint8_t *at, int32_t value)
+{
+    if (value > 32767) value = 32767;
+    if (value < -32768) value = -32768;
+    at[0] = (uint8_t)((uint32_t)value & 0xff);
+    at[1] = (uint8_t)(((uint32_t)value >> 8) & 0xff);
+}
+
+static inline void pw_dualsense_le32(uint8_t *at, uint32_t value)
+{
+    for (int i = 0; i < 4; i++) at[i] = (uint8_t)(value >> (8 * i));
+}
+
+/* The d-pad as the hat: 0 up, clockwise to 7 up-left, 8 none. */
+static inline uint8_t pw_dualsense_hat(uint32_t buttons)
+{
+    int up = !!(buttons & PW_DS_PAD_UP), down = !!(buttons & PW_DS_PAD_DOWN);
+    int left = !!(buttons & PW_DS_PAD_LEFT), right = !!(buttons & PW_DS_PAD_RIGHT);
+    if (up && down) up = down = 0;
+    if (left && right) left = right = 0;
+    if (up) return right ? 1 : left ? 7 : 0;
+    if (down) return right ? 3 : left ? 5 : 4;
+    if (right) return 2;
+    if (left) return 6;
+    return 8;
+}
+
+static inline int32_t pw_dualsense_round(float value)
+{
+    return (int32_t)(value < 0 ? value - 0.5f : value + 0.5f);
+}
+
+/* Input report 1 for a state (a neutral one while disconnected); counter
+ * numbers the reports. */
+static inline void pw_dualsense_input(const PwDualSenseState *s, uint8_t counter,
+                                      uint8_t report[PW_DUALSENSE_INPUT_SIZE])
+{
+    const float degrees = 57.29577951f;
+    uint32_t b = s->connected ? s->buttons : 0;
+
+    memset(report, 0, PW_DUALSENSE_INPUT_SIZE);
+    report[0] = 0x01;
+    report[1] = s->connected ? s->lx : 0x80;
+    report[2] = s->connected ? s->ly : 0x80;
+    report[3] = s->connected ? s->rx : 0x80;
+    report[4] = s->connected ? s->ry : 0x80;
+    report[5] = s->connected ? s->l2 : 0;
+    report[6] = s->connected ? s->r2 : 0;
+    report[7] = counter;
+    report[8] = (uint8_t)(pw_dualsense_hat(b) | (b & PW_DS_PAD_SQUARE ? 0x10 : 0) | (b & PW_DS_PAD_CROSS ? 0x20 : 0) |
+                          (b & PW_DS_PAD_CIRCLE ? 0x40 : 0) | (b & PW_DS_PAD_TRIANGLE ? 0x80 : 0));
+    report[9] = (uint8_t)((b & PW_DS_PAD_L1 ? 0x01 : 0) | (b & PW_DS_PAD_R1 ? 0x02 : 0) | (b & PW_DS_PAD_L2 ? 0x04 : 0) |
+                          (b & PW_DS_PAD_R2 ? 0x08 : 0) | (b & PW_DS_PAD_CREATE ? 0x10 : 0) |
+                          (b & PW_DS_PAD_OPTIONS ? 0x20 : 0) | (b & PW_DS_PAD_L3 ? 0x40 : 0) | (b & PW_DS_PAD_R3 ? 0x80 : 0));
+    report[10] = (uint8_t)(b & PW_DS_PAD_TOUCHPAD ? 0x02 : 0);   /* the PS button is the console's */
+    pw_dualsense_le32(report + 12, s->packet);
+    if (s->connected) {
+        for (int i = 0; i < 3; i++) {
+            pw_dualsense_le16(report + 16 + 2 * i, pw_dualsense_round(s->gyro[i] * degrees * PW_DUALSENSE_GYRO_PER_DEGREE));
+            pw_dualsense_le16(report + 22 + 2 * i, pw_dualsense_round(s->accel[i] * PW_DUALSENSE_ACCEL_PER_G));
+        }
+    } else {
+        pw_dualsense_le16(report + 24, PW_DUALSENSE_ACCEL_PER_G);   /* at rest, flat: 1 g */
+    }
+    pw_dualsense_le32(report + 28, (uint32_t)(s->timestamp_us * 3));   /* a third of a microsecond each */
+    /* The touchpad's two fingers: bit 7 set while a finger is up, then x and y
+     * (12 bits each). */
+    for (int i = 0; i < 2; i++) {
+        uint8_t *point = report + 33 + 4 * i;
+        uint16_t x = s->touch_x[i] > 1919 ? 1919 : s->touch_x[i], y = s->touch_y[i] > 1079 ? 1079 : s->touch_y[i];
+        int down = s->connected && i < s->touches;
+        point[0] = (uint8_t)((down ? 0 : 0x80) | (s->touch_id[i] & 0x7f));
+        point[1] = (uint8_t)(x & 0xff);
+        point[2] = (uint8_t)(((x >> 8) & 0x0f) | ((y & 0x0f) << 4));
+        point[3] = (uint8_t)(y >> 4);
+    }
+    report[53] = 0x0a;   /* the battery: full, not charging */
+}
+
+/* An output report (2) merged into out: 1 when it asked anything. */
+static inline int pw_dualsense_parse_output(const uint8_t *report, size_t size, PwDualSenseOutput *out)
+{
+    uint8_t r[PW_DUALSENSE_OUTPUT_SIZE] = { 0 };
+    uint32_t asked = 0;
+
+    if (!report || size < 3 || report[0] != 0x02) return 0;
+    memcpy(r, report, size < sizeof(r) ? size : sizeof(r));
+    if (r[1] & 0x03) {   /* the motors (DualShock 4 style) */
+        out->motor_small = r[3];
+        out->motor_large = r[4];
+        asked |= PW_DUALSENSE_MOTORS;
+    }
+    if (r[1] & 0x04) {
+        memcpy(out->trigger[1], r + 11, 11);
+        asked |= PW_DUALSENSE_RIGHT_TRIGGER;
+    }
+    if (r[1] & 0x08) {
+        memcpy(out->trigger[0], r + 22, 11);
+        asked |= PW_DUALSENSE_LEFT_TRIGGER;
+    }
+    if (r[2] & 0x04) {
+        out->light[0] = r[45];
+        out->light[1] = r[46];
+        out->light[2] = r[47];
+        asked |= PW_DUALSENSE_LIGHT;
+    }
+    if (r[2] & 0x10) {
+        out->player_leds = r[44];
+        asked |= PW_DUALSENSE_PLAYER_LEDS;
+    }
+    if (!asked) return 0;
+    out->set |= asked;
+    out->sequence++;
+    return 1;
+}
+
+/* A feature report by its id into report (whose size is size): how long it
+ * is with its id, or 0 for an id the DualSense hasn't got. Calibration (5)
+ * gives the motion sensors' units above; pairing (9) an address; firmware
+ * (0x20) a recent version. The rest read as zeros. */
+static inline size_t pw_dualsense_feature(uint8_t id, uint8_t *report, size_t size)
+{
+    size_t length = 0;
+
+    for (size_t i = 0; i < sizeof(pw_dualsense_features) / sizeof(pw_dualsense_features[0]); i++)
+        if (pw_dualsense_features[i].id == id) length = pw_dualsense_features[i].length;
+    if (!length || !report) return length;
+    if (size > length) size = length;
+    memset(report, 0, size);
+    {
+        uint8_t full[PW_DUALSENSE_FEATURE_SIZE] = { 0 };
+        full[0] = id;
+        if (id == 0x05) {
+            /* The gyro's biases (0), then each axis's reading at +/- the speed
+             * below, pitch, yaw, roll; then the accelerometer's at +/- 1 g. */
+            for (int axis = 0; axis < 3; axis++) {
+                pw_dualsense_le16(full + 7 + 4 * axis, 32000);
+                pw_dualsense_le16(full + 9 + 4 * axis, -32000);
+            }
+            pw_dualsense_le16(full + 19, 2000);   /* degrees a second */
+            pw_dualsense_le16(full + 21, 2000);
+            for (int axis = 0; axis < 3; axis++) {
+                pw_dualsense_le16(full + 23 + 4 * axis, PW_DUALSENSE_ACCEL_PER_G);
+                pw_dualsense_le16(full + 25 + 4 * axis, -PW_DUALSENSE_ACCEL_PER_G);
+            }
+        } else if (id == 0x09) {
+            static const uint8_t address[6] = { 0x35, 0x43, 0x50, 0x01, 0xc5, 0x7c };   /* little-endian */
+            memcpy(full + 1, address, sizeof(address));
+        } else if (id == 0x20) {
+            memcpy(full + 1, "Jun 10 2024", 11);
+            memcpy(full + 12, "12:00:00", 8);
+            pw_dualsense_le16(full + 20, 0x0003);      /* firmware type */
+            pw_dualsense_le16(full + 22, 0x0000);      /* software series */
+            pw_dualsense_le32(full + 24, 0x00000613);  /* hardware */
+            pw_dualsense_le32(full + 28, 0x01000100);  /* firmware */
+            pw_dualsense_le16(full + 44, 0x0630);      /* the update version SDL reads */
+        }
+        memcpy(report, full, size);
+    }
+    return length;
+}
+
+/* libScePad's adaptive trigger modes, and one trigger's command in its terms. */
+enum {
+    PW_DS_TRIGGER_OFF = 0, PW_DS_TRIGGER_FEEDBACK = 1, PW_DS_TRIGGER_WEAPON = 2, PW_DS_TRIGGER_VIBRATION = 3,
+    PW_DS_TRIGGER_MULTIPLE_FEEDBACK = 4, PW_DS_TRIGGER_SLOPE = 5, PW_DS_TRIGGER_MULTIPLE_VIBRATION = 6,
+};
+typedef struct PwDualSenseTrigger {
+    uint32_t mode;
+    uint8_t data[11];   /* as libScePad's command lays them out for the mode */
+} PwDualSenseTrigger;
+
+static inline uint8_t pw_dualsense_scale(uint8_t value, uint8_t most)
+{
+    return (uint8_t)((value * most + 127) / 255);
+}
+
+/* The first and last of the zones a ten-bit mask names. */
+static inline int pw_dualsense_zones(const uint8_t *mask, int *first, int *last)
+{
+    uint32_t bits = (uint32_t)mask[0] | (uint32_t)mask[1] << 8;
+    *first = *last = -1;
+    for (int i = 0; i < 10; i++)
+        if (bits & (1u << i)) {
+            if (*first < 0) *first = i;
+            *last = i;
+        }
+    return *first >= 0;
+}
+
+/* A DualSense trigger effect (its mode, then ten numbers, as a game sends
+ * them in report 2) as libScePad's command. The effects games use are
+ * these; any other, or a malformed one, is off. */
+static inline void pw_dualsense_trigger(const uint8_t effect[11], PwDualSenseTrigger *out)
+{
+    const uint8_t *p = effect + 1;
+    uint32_t packed = (uint32_t)p[2] | (uint32_t)p[3] << 8 | (uint32_t)p[4] << 16 | (uint32_t)p[5] << 24;
+    uint32_t mask = (uint32_t)p[0] | (uint32_t)p[1] << 8;
+    int first, last;
+
+    memset(out, 0, sizeof(*out));
+    switch (effect[0]) {
+    case 0x01:   /* resistance from a point: where (0-255), how firm (0-255) */
+        out->mode = PW_DS_TRIGGER_FEEDBACK;
+        out->data[0] = pw_dualsense_scale(p[0], 9);
+        out->data[1] = pw_dualsense_scale(p[1], 8);
+        if (!out->data[1]) out->mode = PW_DS_TRIGGER_OFF;
+        break;
+    case 0x02:   /* resistance between two points, then a release: from, to, how firm */
+        out->mode = PW_DS_TRIGGER_WEAPON;
+        out->data[0] = pw_dualsense_scale(p[0], 9);
+        out->data[1] = pw_dualsense_scale(p[1], 9);
+        out->data[2] = pw_dualsense_scale(p[2], 8);
+        if (out->data[0] < 2) out->data[0] = 2;
+        if (out->data[0] > 7) out->data[0] = 7;
+        if (out->data[1] <= out->data[0]) out->data[1] = (uint8_t)(out->data[0] + 1);
+        if (out->data[1] > 8) out->data[1] = 8;
+        break;
+    case 0x06:   /* a vibration: how fast (Hz), how strong (0-255), from where (0-255) */
+        out->mode = PW_DS_TRIGGER_VIBRATION;
+        out->data[0] = pw_dualsense_scale(p[2], 9);
+        out->data[1] = pw_dualsense_scale(p[1], 8);
+        out->data[2] = p[0];
+        if (!out->data[1] || !out->data[2]) out->mode = PW_DS_TRIGGER_OFF;
+        break;
+    case 0x21:   /* resistance zone by zone: ten zones on or off, each one's firmness 1-8 */
+        out->mode = PW_DS_TRIGGER_MULTIPLE_FEEDBACK;
+        for (int i = 0; i < 10; i++)
+            if (mask & (1u << i)) out->data[i] = (uint8_t)(((packed >> (3 * i)) & 7) + 1);
+        if (!(mask & 0x3ff)) out->mode = PW_DS_TRIGGER_OFF;
+        break;
+    case 0x22:   /* a bow: resistance from a point to another, then it snaps */
+    case 0x25:   /* a weapon: resistance from a point to another, then it gives */
+        if (!pw_dualsense_zones(p, &first, &last) || first == last) break;
+        out->mode = PW_DS_TRIGGER_WEAPON;
+        out->data[0] = (uint8_t)(first < 2 ? 2 : first > 7 ? 7 : first);
+        out->data[1] = (uint8_t)(last <= out->data[0] ? out->data[0] + 1 : last > 8 ? 8 : last);
+        out->data[2] = (uint8_t)((p[2] & 7) + 1);
+        break;
+    case 0x26:   /* a vibration zone by zone: ten zones, each one's strength 1-8, and how fast */
+        out->mode = PW_DS_TRIGGER_MULTIPLE_VIBRATION;
+        out->data[0] = p[8];
+        for (int i = 0; i < 10; i++)
+            if (mask & (1u << i)) out->data[1 + i] = (uint8_t)(((packed >> (3 * i)) & 7) + 1);
+        if (!(mask & 0x3ff) || !p[8]) out->mode = PW_DS_TRIGGER_OFF;
+        break;
+    case 0x23:   /* galloping: a beat from a point to another */
+    case 0x27:   /* a machine: a vibration between two points */
+        if (!pw_dualsense_zones(p, &first, &last)) break;
+        out->mode = PW_DS_TRIGGER_VIBRATION;
+        out->data[0] = (uint8_t)first;
+        out->data[1] = effect[0] == 0x27 ? (uint8_t)((p[2] & 7) + 1) : 4;
+        out->data[2] = effect[0] == 0x27 ? p[3] : p[3] ? p[3] : 10;
+        if (!out->data[2]) out->mode = PW_DS_TRIGGER_OFF;
+        break;
+    default:     /* 0x05 and 0x00: off */
+        break;
+    }
+}
+
+#endif
