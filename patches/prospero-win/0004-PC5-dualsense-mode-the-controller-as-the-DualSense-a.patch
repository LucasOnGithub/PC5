diff --git a/tests/test_pw_wine_sink.c b/tests/test_pw_wine_sink.c
index 33ec489..27df79f 100644
--- a/tests/test_pw_wine_sink.c
+++ b/tests/test_pw_wine_sink.c
@@ -175,6 +175,88 @@ static void *poster(void *arg)
     return NULL;
 }
 
+/* A frame the sink is slow with: held until released, two seconds at most. */
+static int present_held,present_release;
+static int holding_sink(void *context,const void *bgra,uint32_t w,uint32_t h,uint32_t stride)
+{
+    (void)context;(void)bgra;(void)w;(void)h;(void)stride;
+    __atomic_store_n(&present_held,1,__ATOMIC_RELEASE);
+    for(int waited=0;waited<2000 && !__atomic_load_n(&present_release,__ATOMIC_ACQUIRE);waited++)usleep(1000);
+    return 0;
+}
+static void *presenter(void *arg)
+{
+    uint32_t frame[4*3]={0};
+    (void)arg;
+    (void)pw_wine_present(frame,4,3,16);
+    return NULL;
+}
+static uint64_t now_ns(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC,&t);
+    return (uint64_t)t.tv_sec*1000000000u+(uint64_t)t.tv_nsec;
+}
+
+/* The DualSense: numbered like the pad, but time alone is not a change;
+ * a game's output reports are kept until the title reads them. */
+static void test_dualsense(void)
+{
+    PwDualSenseState state,got;
+    PwDualSenseOutput out;
+    memset(&got,0x5a,sizeof(got));
+    assert(!pw_wine_dualsense(&got) && !got.connected && !got.packet && !got.buttons && !got.touches);
+    assert(!pw_wine_dualsense(NULL));
+    memset(&state,0,sizeof(state));
+    state.lx=state.ly=state.rx=state.ry=0x80;state.buttons=PW_DS_PAD_CROSS;state.packet=99;
+    state.touches=1;state.touch_x[0]=100;state.touch_y[0]=200;state.gyro[1]=0.25f;state.timestamp_us=10;
+    pw_wine_set_dualsense(&state);
+    assert(pw_wine_dualsense(&got) && got.connected==1 && got.packet==1 && got.buttons==PW_DS_PAD_CROSS);
+    assert(got.touches==1 && got.touch_x[0]==100 && got.touch_y[0]==200 && got.gyro[1]==0.25f && got.timestamp_us==10);
+    state.timestamp_us=20;pw_wine_set_dualsense(&state);
+    assert(pw_wine_dualsense(&got) && got.packet==1 && got.timestamp_us==20);
+    PwDualSenseState changes[8];
+    for(int i=0;i<8;i++)changes[i]=state;
+    changes[0].buttons=PW_DS_PAD_TOUCHPAD;changes[1].lx=0;changes[2].r2=9;changes[3].touches=2;
+    changes[4].touch_x[1]=5;changes[5].touch_id[0]=3;changes[6].gyro[0]=1.0f;changes[7].accel[2]=1.0f;
+    for(uint32_t i=0;i<8;i++) {
+        pw_wine_set_dualsense(&changes[i]);
+        assert(pw_wine_dualsense(&got) && got.packet==2+i);
+    }
+    /* Disconnected: neutral, the packet kept; reconnecting is a new one. */
+    pw_wine_set_dualsense(NULL);
+    assert(!pw_wine_dualsense(&got) && !got.connected && got.packet==9 && !got.buttons && !got.touches);
+    pw_wine_set_dualsense(&changes[7]);
+    assert(pw_wine_dualsense(&got) && got.packet==10 && got.accel[2]==1.0f);
+    /* Output: nothing yet; a report that asks nothing changes nothing. */
+    assert(!pw_wine_dualsense_output(&out) && !out.set);
+    uint8_t report[PW_DUALSENSE_OUTPUT_SIZE]={2};
+    assert(!pw_wine_dualsense_report(report,sizeof(report)) && !pw_wine_dualsense_output(NULL));
+    assert(!pw_wine_dualsense_report(NULL,48));
+    report[1]=0x03;report[3]=10;report[4]=20;
+    assert(pw_wine_dualsense_report(report,sizeof(report))==1);
+    assert(pw_wine_dualsense_output(&out)==1 && out.motor_small==10 && out.motor_large==20);
+    assert(!pw_wine_dualsense_output(&out) && out.motor_large==20);   /* read once, kept */
+    report[1]=0;report[2]=0x04;report[45]=1;report[46]=2;report[47]=3;
+    assert(pw_wine_dualsense_report(report,sizeof(report))==1 && pw_wine_dualsense_output(&out)==1);
+    assert(out.light[0]==1 && out.light[2]==3 && out.motor_large==20 && (out.set&PW_DUALSENSE_LIGHT));
+    /* Wine's DualSense thread does not wait for a frame the title is slow with. */
+    int tag;
+    pthread_t thread;
+    pw_wine_set_present_sink(holding_sink,NULL);
+    assert(!pthread_create(&thread,NULL,presenter,NULL));
+    while(!__atomic_load_n(&present_held,__ATOMIC_ACQUIRE))usleep(100);
+    uint64_t started=now_ns();
+    assert(pw_wine_dualsense(&got) && got.packet==10);
+    report[2]=0;report[1]=0x03;report[3]=1;
+    assert(pw_wine_dualsense_report(report,sizeof(report))==1 && pw_wine_dualsense_output(&out)==1);
+    pw_wine_set_dualsense(&changes[0]);
+    assert(now_ns()-started<500000000u);
+    __atomic_store_n(&present_release,1,__ATOMIC_RELEASE);
+    assert(!pthread_join(thread,NULL));
+    pw_wine_set_present_sink(sink,&tag);
+}
+
