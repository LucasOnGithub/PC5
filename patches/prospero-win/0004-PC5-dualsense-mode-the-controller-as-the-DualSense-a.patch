++#include "wine/hid.h"
++#include "wine/list.h"
++#include "wine/server.h"
++#include "wine/debug.h"
++
++#include "unixlib.h"
++#include "dualsense.h"
++
++WINE_DEFAULT_DEBUG_CHANNEL(xinput);
++
++#define DS_HID_GUID     L"{4d1e55b2-f16f-11cf-88cb-001111000030}"
++#define DS_HIDCLASS     L"{745a17a0-74d3-11d0-b6fe-00a0c90f57da}"
++#define DS_HARDWARE     L"VID_054C&PID_0CE6&MI_03"
++#define DS_SERIAL       L"1&5d5e2a1&0&0000"
++#define DS_INSTANCE     L"HID\\" DS_HARDWARE L"\\" DS_SERIAL
++#define DS_LINK         L"HID#" DS_HARDWARE L"#" DS_SERIAL L"#" DS_HID_GUID
++#define DS_DEVICE       L"\\Device\\PwDualSense"
++#define DS_ENUM_KEY     L"System\\CurrentControlSet\\Enum\\" DS_INSTANCE
++#define DS_CLASS_KEY    L"System\\CurrentControlSet\\Control\\DeviceClasses\\" DS_HID_GUID L"\\##?#" DS_LINK
++
++enum
++{
++    DS_INPUT_SIZE = 64,
++    DS_OUTPUT_SIZE = 48,
++    DS_INPUT_ID = 1,
++    DS_OUTPUT_ID = 2,
++    DS_QUEUE_DEFAULT = 32,      /* hidclass's, and Windows' */
++    DS_QUEUE_MIN = 2,
++    DS_QUEUE_MAX = 512,
++    DS_TICK_US = 4000,          /* a DualSense on USB sends 250 reports a second */
++    DS_RAWINPUT_HANDLE = 0x5c0e6, /* any but 1 and 2, which are the mouse's and the keyboard's */
++    DS_VERSION = 0x0100,
++};
++
++struct ds_read
++{
++    struct list entry;
++    HANDLE irp;                 /* until it is answered */
++    UINT64 id;                  /* the server's name for it, which a cancel gives: never reused */
++};
++
++struct ds_file
++{
++    struct list entry;
++    struct list reads;          /* ds_read: waiting for a report */
++    BOOL closed;
++    ULONG length;               /* the input reports kept, as IOCTL_SET_NUM_DEVICE_INPUT_BUFFERS sets */
++    ULONG first, count;
++    BYTE (*reports)[DS_INPUT_SIZE];
++};
++
++/* What the next get_next_device_request answers the current call with. */
++struct ds_result
++{
++    HANDLE handle;              /* the call's, which the server then closes; 0 when it is pending */
++    client_ptr_t user_ptr;
++    NTSTATUS status;
++    int pending;
++    ULONG_PTR info;
++    BYTE *data;
++    ULONG size;
++};
++
++static struct
++{
++    unixlib_handle_t unix;
++    HANDLE manager, link;
++    HIDP_DEVICE_DESC desc;
++    const HIDP_COLLECTION_DESC *collection;
++    HID_COLLECTION_INFORMATION information;
++    struct list files;
++    BYTE report[DS_INPUT_SIZE]; /* the newest input report */
++    BYTE counter;
++    BYTE *in;
++    ULONG in_capacity;
++    UINT64 next_read;
++    BOOL keys;
++} ds = { .files = LIST_INIT( ds.files ) };
++
++static NTSTATUS ds_call( unsigned int code, void *params )
++{
++    return __wine_unix_call( ds.unix, code, params );
++}
++
++/* The registry, as plug and play leaves it for a HID collection: the
++ * device's instance, and its interface, enabled. */
++static BOOL set_value( HKEY key, const WCHAR *name, DWORD type, const void *data, DWORD size )
++{
++    return !RegSetValueExW( key, name, 0, type, data, size );
++}
++
++static BOOL set_string( HKEY key, const WCHAR *name, const WCHAR *value )
++{
++    return set_value( key, name, REG_SZ, value, (wcslen( value ) + 1) * sizeof(WCHAR) );
++}
++
++static HKEY create_key( HKEY root, const WCHAR *path )
++{
++    HKEY key;
++
++    if (RegCreateKeyExW( root, path, 0, NULL, REG_OPTION_VOLATILE, KEY_ALL_ACCESS, NULL, &key, NULL )) return NULL;
++    return key;
++}
++
++static BOOL create_keys(void)
++{
++    static const WCHAR hardware_ids[] =
++        L"HID\\VID_054C&PID_0CE6&REV_0100&MI_03\0HID\\" DS_HARDWARE L"\0"
++        L"HID\\VID_054C&UP:0001_U:0005\0HID_DEVICE_SYSTEM_GAME\0HID_DEVICE_UP:0001_U:0005\0HID_DEVICE\0";
++    static const WCHAR compatible_ids[] = L"HID_DEVICE_SYSTEM_GAME\0HID_DEVICE_UP:0001_U:0005\0HID_DEVICE\0";
++    static const WCHAR link[] = L"\\\\?\\" DS_LINK;
++    const DWORD one = 1;
++    HKEY key, refstr, control;
++    BOOL ok;
++
++    if (!(key = create_key( HKEY_LOCAL_MACHINE, DS_ENUM_KEY ))) return FALSE;
++    ok = set_string( key, L"ClassGUID", DS_HIDCLASS ) && set_string( key, L"Class", L"HIDClass" ) &&
++         set_string( key, L"DeviceDesc", L"HID-compliant game controller" ) &&
++         set_string( key, L"Mfg", L"(Standard system devices)" ) &&
++         set_value( key, L"HardwareID", REG_MULTI_SZ, hardware_ids, sizeof(hardware_ids) ) &&
++         set_value( key, L"CompatibleIDs", REG_MULTI_SZ, compatible_ids, sizeof(compatible_ids) );
++    RegCloseKey( key );
++    if (!ok) return FALSE;
++
++    if (!(key = create_key( HKEY_LOCAL_MACHINE, DS_CLASS_KEY ))) return FALSE;
++    ok = set_string( key, L"DeviceInstance", DS_INSTANCE );
++    if (ok && (ok = (refstr = create_key( key, L"#" )) != NULL))
++    {
++        ok = set_string( refstr, L"SymbolicLink", link );
++        if (ok && (ok = (control = create_key( refstr, L"Control" )) != NULL))
++        {
++            ok = set_value( control, L"Linked", REG_DWORD, &one, sizeof(one) );
++            RegCloseKey( control );
++        }
++        RegCloseKey( refstr );
++    }
++    RegCloseKey( key );
++    return ok;
++}
++
++static void delete_keys(void)
++{
++    RegDeleteTreeW( HKEY_LOCAL_MACHINE, DS_CLASS_KEY );
++    RegDeleteTreeW( HKEY_LOCAL_MACHINE, DS_ENUM_KEY );
++}
++
++/* The device in the server, and the link the interface's path opens. */
++static NTSTATUS create_device(void)
++{
++    static const WCHAR device[] = DS_DEVICE;
++    UNICODE_STRING name = RTL_CONSTANT_STRING( L"\\??\\" DS_LINK ), target = RTL_CONSTANT_STRING( DS_DEVICE );
++    OBJECT_ATTRIBUTES attr;
++    NTSTATUS status;
++
++    SERVER_START_REQ( create_device_manager )
++    {
++        req->access     = SYNCHRONIZE;
++        req->attributes = 0;
++        if (!(status = wine_server_call( req ))) ds.manager = wine_server_ptr_handle( reply->handle );
++    }
++    SERVER_END_REQ;
++    if (status) return status;
++
++    SERVER_START_REQ( create_device )
++    {
++        req->rootdir  = 0;
++        req->manager  = wine_server_obj_handle( ds.manager );
++        req->user_ptr = wine_server_client_ptr( &ds );
++        wine_server_add_data( req, device, sizeof(device) - sizeof(WCHAR) );
++        status = wine_server_call( req );
++    }
++    SERVER_END_REQ;
++    if (status) return status;
++
++    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, NULL, NULL );
++    return NtCreateSymbolicLinkObject( &ds.link, SYMBOLIC_LINK_ALL_ACCESS, &attr, &target );
++}
++
++/* Each open file's queue of input reports: the oldest goes first, and a
++ * full queue drops it, as hidclass's does. */
++static BOOL queue_resize( struct ds_file *file, ULONG length )
++{
++    BYTE (*reports)[DS_INPUT_SIZE];
++
++    if (!(reports = calloc( length, DS_INPUT_SIZE ))) return FALSE;
++    free( file->reports );
++    file->reports = reports;
++    file->length = length;
++    file->first = file->count = 0;
++    return TRUE;
++}
++
++static void queue_push( struct ds_file *file, const BYTE *report )
++{
++    if (file->count == file->length)
++    {
++        file->first = (file->first + 1) % file->length;
++        file->count--;
++    }
++    memcpy( file->reports[(file->first + file->count++) % file->length], report, DS_INPUT_SIZE );
++}
++
++static BOOL queue_pop( struct ds_file *file, BYTE *report )
++{
++    if (!file->count) return FALSE;
++    memcpy( report, file->reports[file->first], DS_INPUT_SIZE );
++    file->first = (file->first + 1) % file->length;
++    file->count--;
++    return TRUE;
++}
++
++static void complete_irp( HANDLE irp, NTSTATUS status, const void *data, ULONG size )
++{
++    SERVER_START_REQ( set_irp_result )
++    {
++        req->handle = wine_server_obj_handle( irp );
++        req->status = status;
++        req->size   = size;
++        if (size) wine_server_add_data( req, data, size );
++        wine_server_call( req );
++    }
++    SERVER_END_REQ;
++}
++
++static void complete_reads( struct ds_file *file, NTSTATUS status )
++{
++    struct ds_read *read, *next;
++
++    LIST_FOR_EACH_ENTRY_SAFE( read, next, &file->reads, struct ds_read, entry )
++    {
++        complete_irp( read->irp, status, NULL, 0 );
++        list_remove( &read->entry );
++        free( read );
++    }
++}
++
++static struct ds_file *find_file( client_ptr_t ptr )
++{
++    struct ds_file *file;
++
++    LIST_FOR_EACH_ENTRY( file, &ds.files, struct ds_file, entry )
++        if (wine_server_client_ptr( file ) == ptr) return file;
++    return NULL;
++}
++
++/* A report the thread makes: it goes to each open file, to the oldest read
++ * waiting there or else into the queue, and to raw input. */
++static void send_report(void)
++{
++    struct xinput_dualsense_input params = {.counter = ds.counter++};
++    UINT buffer[(sizeof(struct hid_packet) + DS_INPUT_SIZE + sizeof(UINT) - 1) / sizeof(UINT)];
++    struct hid_packet *hid = (struct hid_packet *)buffer;
++    INPUT input = {.type = INPUT_HARDWARE};
++    struct ds_file *file;
++
++    if (ds_call( unix_dualsense_input, &params )) return;
++    memcpy( ds.report, params.data, DS_INPUT_SIZE );
++
++    LIST_FOR_EACH_ENTRY( file, &ds.files, struct ds_file, entry )
++    {
++        struct list *head;
++
++        if (file->closed) continue;
++        if ((head = list_head( &file->reads )))
++        {
++            struct ds_read *read = LIST_ENTRY( head, struct ds_read, entry );
++            complete_irp( read->irp, STATUS_SUCCESS, ds.report, DS_INPUT_SIZE );
++            list_remove( &read->entry );
++            free( read );
++        }
++        else queue_push( file, ds.report );
++    }
++
++    input.hi.uMsg = WM_INPUT;
++    input.hi.wParamH = HIWORD(RIM_INPUT);
++    input.hi.wParamL = LOWORD(RIM_INPUT);
++    hid->head.device = DS_RAWINPUT_HANDLE;
++    hid->head.usage = MAKELONG(ds.collection->Usage, ds.collection->UsagePage);
++    hid->head.count = 1;
++    hid->head.length = DS_INPUT_SIZE;
++    memcpy( hid->data, ds.report, DS_INPUT_SIZE );
++    NtUserSendHardwareInput( 0, 0, &input, (LPARAM)hid );
++}
++
++static NTSTATUS dispatch_create( obj_handle_t handle )
++{
++    struct ds_file *file;
++    NTSTATUS status;
++
++    if (!(file = calloc( 1, sizeof(*file) ))) return STATUS_NO_MEMORY;
++    list_init( &file->reads );
++    if (!queue_resize( file, DS_QUEUE_DEFAULT ))
++    {
++        free( file );
++        return STATUS_NO_MEMORY;
++    }
++    SERVER_START_REQ( set_kernel_object_ptr )
++    {
++        req->manager  = wine_server_obj_handle( ds.manager );
++        req->handle   = handle;
++        req->user_ptr = wine_server_client_ptr( file );
++        status = wine_server_call( req );
++    }
++    SERVER_END_REQ;
++    if (status)
++    {
++        free( file->reports );
++        free( file );
++        return status;
++    }
++    list_add_tail( &ds.files, &file->entry );
++    TRACE( "file %p opened\n", file );
++    return STATUS_SUCCESS;
++}
++
++static void dispatch_close( struct ds_file *file )
++{
++    if (!file) return;
++    TRACE( "file %p closed\n", file );
++    file->closed = TRUE;
++    complete_reads( file, STATUS_DEVICE_NOT_CONNECTED );
++    free( file->reports );
++    file->reports = NULL;
++    file->count = 0;
++}
++
++static void dispatch_free( client_ptr_t ptr )
++{
++    struct ds_file *file;
++
++    if (!(file = find_file( ptr ))) return;  /* the device's, or unknown */
++    complete_reads( file, STATUS_DEVICE_NOT_CONNECTED );
++    list_remove( &file->entry );
++    free( file->reports );
++    free( file );
++}
++
++static void dispatch_cancel( client_ptr_t ptr )
++{
++    struct ds_file *file;
++    struct ds_read *read;
++
++    LIST_FOR_EACH_ENTRY( file, &ds.files, struct ds_file, entry )
++    {
++        LIST_FOR_EACH_ENTRY( read, &file->reads, struct ds_read, entry )
++        {
++            if (read->id != ptr) continue;
++            complete_irp( read->irp, STATUS_CANCELLED, NULL, 0 );
++            list_remove( &read->entry );
++            free( read );
++            return;
++        }
++    }
++}
++
++static BYTE *result_data( struct ds_result *result, const void *data, ULONG size )
++{
++    if (!(result->data = malloc( size ? size : 1 ))) return NULL;
++    if (data) memcpy( result->data, data, size );
++    else memset( result->data, 0, size );
++    result->size = size;
++    return result->data;
++}
++
++static void dispatch_read( struct ds_file *file, ULONG size, HANDLE irp, struct ds_result *result )
++{
++    struct ds_read *read;
++    BYTE report[DS_INPUT_SIZE];
++
++    if (!file || file->closed) result->status = STATUS_INVALID_HANDLE;
++    else if (size < ds.collection->InputLength) result->status = STATUS_INVALID_BUFFER_SIZE;
++    else if (queue_pop( file, report ))
++    {
++        if (!result_data( result, report, DS_INPUT_SIZE )) result->status = STATUS_NO_MEMORY;
++        else result->info = DS_INPUT_SIZE;
++    }
++    else if (!(read = malloc( sizeof(*read) ))) result->status = STATUS_NO_MEMORY;
++    else
++    {
++        read->irp = irp;
++        read->id = ++ds.next_read;
++        list_add_tail( &file->reads, &read->entry );
++        result->handle = 0;     /* kept until a report answers it */
++        result->user_ptr = read->id;
++        result->status = STATUS_PENDING;
++        result->pending = 1;
++    }
++}
++
++/* An output report from the game: rumble, the light bar, the triggers. */
++static NTSTATUS write_report( const BYTE *report, ULONG size, ULONG_PTR *info )
++{
++    struct xinput_dualsense_output params = {0};
++
++    if (!size) return STATUS_INVALID_USER_BUFFER;
++    if (report[0] != DS_OUTPUT_ID || size < ds.collection->OutputLength) return STATUS_INVALID_PARAMETER;
++    params.size = min( size, sizeof(params.data) );
++    memcpy( params.data, report, params.size );
++    ds_call( unix_dualsense_output, &params );
++    TRACE( "output report, %s\n", params.asked ? "asked" : "nothing asked" );
++    *info = ds.collection->OutputLength;
++    return STATUS_SUCCESS;
++}
++
++static NTSTATUS get_string( ULONG code, BYTE *out, ULONG out_size, ULONG_PTR *info )
++{
++    const WCHAR *string = code == IOCTL_HID_GET_PRODUCT_STRING ? L"DualSense Wireless Controller" :
++                          code == IOCTL_HID_GET_MANUFACTURER_STRING ? L"Sony Interactive Entertainment" : L"";
++
++    *info = (wcslen( string ) + 1) * sizeof(WCHAR);
++    if (*info > out_size) return STATUS_BUFFER_TOO_SMALL;
++    memcpy( out, string, *info );
++    return STATUS_SUCCESS;
++}
++
++static NTSTATUS hid_ioctl( struct ds_file *file, ULONG code, const BYTE *in, ULONG in_size, BYTE *out,
++                           ULONG out_size, ULONG_PTR *info )
++{
++    struct xinput_dualsense_feature feature = {0};
++
++    switch (code)
++    {
++    case IOCTL_HID_GET_POLL_FREQUENCY_MSEC:
++        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_OVERFLOW;
++        *(ULONG *)out = 0;      /* not polled: it sends reports itself */
++        *info = sizeof(ULONG);
++        return STATUS_SUCCESS;
++    case IOCTL_HID_SET_POLL_FREQUENCY_MSEC:
++        if (in_size < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_PRODUCT_STRING:
++    case IOCTL_HID_GET_MANUFACTURER_STRING:
++    case IOCTL_HID_GET_SERIALNUMBER_STRING:
++        return get_string( code, out, out_size, info );
++    case IOCTL_HID_GET_COLLECTION_INFORMATION:
++        *info = sizeof(ds.information);
++        if (out_size < sizeof(ds.information)) return STATUS_BUFFER_OVERFLOW;
++        memcpy( out, &ds.information, sizeof(ds.information) );
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_COLLECTION_DESCRIPTOR:
++        *info = ds.collection->PreparsedDataLength;
++        if (out_size < ds.collection->PreparsedDataLength) return STATUS_INVALID_BUFFER_SIZE;
++        memcpy( out, ds.collection->PreparsedData, ds.collection->PreparsedDataLength );
++        return STATUS_SUCCESS;
++    case IOCTL_SET_NUM_DEVICE_INPUT_BUFFERS:
++    {
++        ULONG length;
++
++        if (in_size != sizeof(ULONG)) return STATUS_BUFFER_OVERFLOW;
++        length = *(const ULONG *)in;
++        if (length < DS_QUEUE_MIN || length > DS_QUEUE_MAX) return STATUS_INVALID_PARAMETER;
++        if (length == file->length) return STATUS_SUCCESS;
++        return queue_resize( file, length ) ? STATUS_SUCCESS : STATUS_NO_MEMORY;
++    }
++    case IOCTL_GET_NUM_DEVICE_INPUT_BUFFERS:
++        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
++        *(ULONG *)out = file->length;
++        *info = sizeof(ULONG);
++        return STATUS_SUCCESS;
++    case IOCTL_HID_FLUSH_QUEUE:
++        file->first = file->count = 0;
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_INPUT_REPORT:
++        if (!out_size) return STATUS_INVALID_USER_BUFFER;
++        if (out[0] != DS_INPUT_ID || out_size < ds.collection->InputLength) return STATUS_INVALID_PARAMETER;
++        memcpy( out, ds.report, DS_INPUT_SIZE );
++        *info = DS_INPUT_SIZE;
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_FEATURE:
++        if (!out_size) return STATUS_INVALID_USER_BUFFER;
++        feature.id = out[0];
++        if (ds_call( unix_dualsense_feature, &feature ) || !feature.size || out_size < feature.size)
++            return STATUS_INVALID_PARAMETER;
++        memcpy( out, feature.data, feature.size );
++        *info = feature.size;
++        TRACE( "feature report %#x\n", feature.id );
++        return STATUS_SUCCESS;
++    case IOCTL_HID_SET_FEATURE:
++        if (!in_size) return STATUS_INVALID_USER_BUFFER;
++        feature.id = in[0];
++        if (ds_call( unix_dualsense_feature, &feature ) || !feature.size || in_size < feature.size)
++            return STATUS_INVALID_PARAMETER;
++        *info = feature.size;   /* a DualSense keeps nothing a game sets this way */
++        return STATUS_SUCCESS;
++    case IOCTL_HID_SET_OUTPUT_REPORT:
++        return write_report( in, in_size, info );
++    case IOCTL_HID_GET_WINE_RAWINPUT_HANDLE:
++        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_OVERFLOW;
++        *(ULONG *)out = DS_RAWINPUT_HANDLE;
++        *info = sizeof(ULONG);
++        return STATUS_SUCCESS;
++    default:
++        FIXME( "unsupported ioctl %#lx\n", code );
++        return STATUS_NOT_SUPPORTED;
++    }
++}
++
++/* As ntoskrnl hands an ioctl to a driver, and returns what it wrote: a
++ * buffered ioctl's output is what it reports writing, a direct one's is
++ * the whole buffer, which arrives after the input. */
++static void dispatch_ioctl( struct ds_file *file, ULONG code, ULONG in_size, ULONG out_size,
++                            struct ds_result *result )
++{
++    BOOL direct = (code & 3) != METHOD_BUFFERED;
++    BYTE *out;
++
++    if (!file || file->closed)
++    {
++        result->status = STATUS_INVALID_HANDLE;
++        return;
++    }
++    if (direct && out_size)
++    {
++        if (in_size < out_size)
++        {
++            result->status = STATUS_INVALID_DEVICE_REQUEST;
++            return;
++        }
++        in_size -= out_size;
++    }
++    if (!(out = result_data( result, direct && out_size ? ds.in + in_size : NULL, out_size )))
++    {
++        result->status = STATUS_NO_MEMORY;
++        return;
++    }
++    result->status = hid_ioctl( file, code, ds.in, in_size, out, out_size, &result->info );
++    if (!direct) result->size = NT_ERROR(result->status) ? 0 : min( result->info, out_size );
++}
++
++static void dispatch_volume( ULONG info_class, ULONG out_size, struct ds_result *result )
++{
++    FILE_FS_DEVICE_INFORMATION info = {.DeviceType = FILE_DEVICE_UNKNOWN};
++
++    if (info_class != FileFsDeviceInformation) result->status = STATUS_NOT_SUPPORTED;
++    else if (out_size < sizeof(info)) result->status = STATUS_INFO_LENGTH_MISMATCH;
++    else if (!result_data( result, &info, sizeof(info) )) result->status = STATUS_NO_MEMORY;
++    else result->info = sizeof(info);
++}
++
++static void dispatch( const union irp_params *params, HANDLE irp, ULONG in_size, struct ds_result *result )
++{
++    result->handle = irp;
++    result->status = STATUS_SUCCESS;
++
++    switch (params->type)
++    {
++    case IRP_CALL_CREATE:
++        result->status = dispatch_create( params->create.file );
++        break;
++    case IRP_CALL_CLOSE:
++        dispatch_close( find_file( params->close.file ) );
++        break;
++    case IRP_CALL_READ:
++        dispatch_read( find_file( params->read.file ), params->read.out_size, irp, result );
++        break;
++    case IRP_CALL_WRITE:
++    {
++        struct ds_file *file = find_file( params->write.file );
++        if (!file || file->closed) result->status = STATUS_INVALID_HANDLE;
++        else result->status = write_report( ds.in, in_size, &result->info );
++        break;
++    }
++    case IRP_CALL_FLUSH:
++        break;
++    case IRP_CALL_IOCTL:
++        dispatch_ioctl( find_file( params->ioctl.file ), params->ioctl.code, in_size, params->ioctl.out_size, result );
++        break;
++    case IRP_CALL_VOLUME:
++        dispatch_volume( params->volume.info_class, params->volume.out_size, result );
++        break;
++    case IRP_CALL_FREE:
++        dispatch_free( params->free.obj );
++        break;
++    case IRP_CALL_CANCEL:
++        dispatch_cancel( params->cancel.irp );
++        break;
++    default:
++        result->status = STATUS_NOT_SUPPORTED;
++        break;
++    }
++}
++
++/* Answers the current call and takes the next one, as ntoskrnl's loop does. */
++static NTSTATUS next_request( struct ds_result *result, union irp_params *params, HANDLE *irp, ULONG *in_size )
++{
++    NTSTATUS status;
++
++    SERVER_START_REQ( get_next_device_request )
++    {
++        req->manager     = wine_server_obj_handle( ds.manager );
++        req->prev        = wine_server_obj_handle( result->handle );
++        req->user_ptr    = result->user_ptr;
++        req->status      = result->status;
++        req->pending     = result->pending;
++        req->iosb_status = result->status;
++        req->result      = result->info;
++        if (result->size) wine_server_add_data( req, result->data, result->size );
++        wine_server_set_reply( req, ds.in, ds.in_capacity );
++        if (!(status = wine_server_call( req )))
++        {
++            *irp     = wine_server_ptr_handle( reply->next );
++            *params  = reply->params;
++            *in_size = reply->in_size;
++        }
++        else if (status == STATUS_BUFFER_OVERFLOW) *in_size = reply->in_size;
++    }
++    SERVER_END_REQ;
++
++    free( result->data );
++    memset( result, 0, sizeof(*result) );
++    return status;
++}
++
++/* The device goes: the server deletes it with the manager, and fails what
++ * waits on it, so a game is not left waiting for good. */
++static void stop_device(void)
++{
++    delete_keys();
++    ds.keys = FALSE;
++    if (ds.link) NtClose( ds.link );
++    NtClose( ds.manager );
++    ds.link = ds.manager = 0;
++}
++
++static DWORD WINAPI dualsense_thread( void *arg )
++{
++    struct ds_result result = {0};
++    LARGE_INTEGER frequency, now, next;
++    unsigned int failures = 0;
++    LONGLONG tick;
++
++    SetThreadDescription( GetCurrentThread(), L"wine_xinput_dualsense" );
++    QueryPerformanceFrequency( &frequency );
++    tick = frequency.QuadPart * DS_TICK_US / 1000000;
++    if (tick < 1) tick = 1;
++    QueryPerformanceCounter( &next );
++
++    for (;;)
++    {
++        union irp_params params;
++        HANDLE irp = 0;
++        ULONG in_size = 0;
++        NTSTATUS status = next_request( &result, &params, &irp, &in_size );
++
++        if (status == STATUS_BUFFER_OVERFLOW)
++        {
++            BYTE *in = realloc( ds.in, in_size );
++
++            if (in)
++            {
++                ds.in = in;
++                ds.in_capacity = in_size;
++                continue;
++            }
++            status = STATUS_NO_MEMORY;
++        }
++        if (status == STATUS_SUCCESS)
++        {
++            failures = 0;
++            dispatch( &params, irp, in_size, &result );
++        }
++        else if (status != STATUS_PENDING)
++        {
++            /* as ntoskrnl's loop, go on; but not forever */
++            LARGE_INTEGER pause = {.QuadPart = -10 * 10000};
++
++            if (!failures++) ERR( "the server refused the next request: status %#lx\n", status );
++            if (failures == 500)
++            {
++                ERR( "the DualSense stops: status %#lx\n", status );
++                stop_device();
++                return 1;
++            }
++            NtDelayExecution( FALSE, &pause );
++        }
++
++        QueryPerformanceCounter( &now );
++        if (now.QuadPart >= next.QuadPart)
++        {
++            send_report();
++            next.QuadPart += tick;
++            if (next.QuadPart <= now.QuadPart) next.QuadPart = now.QuadPart + tick;  /* late: no burst */
++        }
++        if (status == STATUS_PENDING)
++        {
++            LARGE_INTEGER timeout;
++
++            QueryPerformanceCounter( &now );
++            if (next.QuadPart > now.QuadPart)
++            {
++                timeout.QuadPart = -((next.QuadPart - now.QuadPart) * 10000000 / frequency.QuadPart) - 1;
++                NtWaitForSingleObject( ds.manager, FALSE, &timeout );
++            }
++        }
++    }
++}
