++void dualsense_start(void)
++{
++    UNICODE_STRING name = RTL_CONSTANT_STRING( L"xinput1_3" );
++    struct xinput_dualsense_descriptor descriptor = {0};
++    struct xinput_dualsense_input input = {0};
++    unixlib_module_t module;
++    WCHAR value[4];
++    NTSTATUS status;
++    HANDLE thread;
++
++    if (GetEnvironmentVariableW( L"PW_DUALSENSE", value, ARRAY_SIZE(value) ) != 1 || value[0] != '1') return;
++
++    if ((status = __wine_load_unix_lib( &name, &module, &ds.unix )))
++    {
++        ERR( "no Unix library, status %#lx: no DualSense\n", status );
++        return;
++    }
++    if ((status = ds_call( unix_dualsense_init, NULL )))
++    {
++        ERR( "no title, status %#lx: no DualSense\n", status );
++        return;
++    }
++    if (ds_call( unix_dualsense_descriptor, &descriptor ) ||
++        (status = HidP_GetCollectionDescription( descriptor.data, descriptor.size, PagedPool, &ds.desc )) !=
++        HIDP_STATUS_SUCCESS || ds.desc.CollectionDescLength != 1)
++    {
++        ERR( "the report descriptor does not parse, status %#lx: no DualSense\n", status );
++        return;
++    }
++    ds.collection = ds.desc.CollectionDesc;
++    ds.information.DescriptorSize = ds.collection->PreparsedDataLength;
++    ds.information.Polled = FALSE;
++    ds.information.VendorID = 0x054c;
++    ds.information.ProductID = 0x0ce6;
++    ds.information.VersionNumber = DS_VERSION;
++    if (!ds_call( unix_dualsense_input, &input )) memcpy( ds.report, input.data, DS_INPUT_SIZE );
++    if (!(ds.in = malloc( 4096 ))) return;
++    ds.in_capacity = 4096;
++
++    if ((status = create_device()))
++    {
++        ERR( "cannot make the device, status %#lx: no DualSense\n", status );
++        return;
++    }
++    if (!(ds.keys = create_keys()))
++    {
++        ERR( "cannot register the device: no DualSense\n" );
++        delete_keys();
++        return;
++    }
++    if (!(thread = CreateThread( NULL, 0, dualsense_thread, NULL, 0, NULL )))
++    {
++        ERR( "cannot start the device's thread, error %lu: no DualSense\n", GetLastError() );
++        delete_keys();
++        ds.keys = FALSE;
++        return;
++    }
++    CloseHandle( thread );
++    MESSAGE( "xinput: the controller is a DualSense (054c:0ce6, %u-byte reports, %u bytes of preparsed data)\n",
++             ds.collection->InputLength, ds.collection->PreparsedDataLength );
++}
++
++void dualsense_stop(void)
++{
++    if (ds.keys) delete_keys();
++    ds.keys = FALSE;
++}
