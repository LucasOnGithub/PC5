+/* The DualSense: a new packet number whenever anything but the time changed. */
+static int same_dualsense(const PwDualSenseState *a,const PwDualSenseState *b)
+{
+    return a->buttons==b->buttons && a->lx==b->lx && a->ly==b->ly && a->rx==b->rx && a->ry==b->ry &&
+           a->l2==b->l2 && a->r2==b->r2 && a->touches==b->touches &&
+           !memcmp(a->touch_x,b->touch_x,sizeof(a->touch_x)) && !memcmp(a->touch_y,b->touch_y,sizeof(a->touch_y)) &&
+           !memcmp(a->touch_id,b->touch_id,sizeof(a->touch_id)) && !memcmp(a->gyro,b->gyro,sizeof(a->gyro)) &&
+           !memcmp(a->accel,b->accel,sizeof(a->accel));
+}
+void pw_wine_set_dualsense(const PwDualSenseState *state)
+{
+    pthread_mutex_lock(&dualsense_lock);
+    if(!state)dualsense_state.connected=0;
+    else {
+        uint32_t packet=dualsense_state.packet;
+        if(!dualsense_state.connected || !same_dualsense(state,&dualsense_state))
+            packet=packet+1?packet+1:1;   /* 0 is never a packet */
+        dualsense_state=*state;dualsense_state.connected=1;dualsense_state.packet=packet;
+    }
+    pthread_mutex_unlock(&dualsense_lock);
+}
+int pw_wine_dualsense(PwDualSenseState *state)
+{
+    int connected;
+    if(!state)return 0;
+    pthread_mutex_lock(&dualsense_lock);
+    connected=dualsense_state.connected!=0;
+    if(connected)*state=dualsense_state;
+    else {
+        uint32_t packet=dualsense_state.packet;
+        memset(state,0,sizeof(*state));
+        state->packet=packet;
+    }
+    pthread_mutex_unlock(&dualsense_lock);
+    return connected;
+}
+int pw_wine_dualsense_report(const uint8_t *report,uint32_t size)
+{
+    int asked;
+    if(!report)return 0;
+    pthread_mutex_lock(&dualsense_lock);
+    asked=pw_dualsense_parse_output(report,size,&dualsense_out);
+    pthread_mutex_unlock(&dualsense_lock);
+    return asked;
+}
+int pw_wine_dualsense_output(PwDualSenseOutput *output)
+{
+    int changed;
+    pthread_mutex_lock(&dualsense_lock);
+    changed=dualsense_out.sequence!=dualsense_out_seen;
+    dualsense_out_seen=dualsense_out.sequence;
+    if(output)*output=dualsense_out;
+    pthread_mutex_unlock(&dualsense_lock);
+    return changed;
+}
