diff --git a/native/wine64_main.c b/native/wine64_main.c
index d77ceb8..78e3c51 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -1642,6 +1642,18 @@ int main(int argc, char **argv)
         }
 #endif
         int pad_read = pad_status == PW_OK && post_input && pw_pad_ps5_read(&pad) == PW_OK;
+#ifdef PW_PC5
+        /* PC5's on-screen keyboard (the touchpad clicked with two fingers): the buttons
+         * it takes are hidden from the game this tick, and held again for the next read. */
+        uint32_t pc5_hidden = 0, pc5_held = pad.core.previous_buttons;
+        if (pad_read && pc5_game_on) {
+            pc5_hidden = pc5_game_keyboard(&pc5_game, pad.core.previous_buttons, pad.core.pressed_edges,
+                                           pad.core.released_edges, pad.touch.fingers);
+            pad.core.previous_buttons &= ~pc5_hidden;
+            pad.core.pressed_edges &= ~pc5_hidden;
+            pad.core.released_edges &= ~pc5_hidden;
+        }
+#endif
         /* XInput controller 0: the DualSense, and in a script build the
          * macro's controller added to it, every frame, so a scripted press
          * stays down until its release. */
@@ -1709,6 +1721,21 @@ int main(int argc, char **argv)
                                (unsigned)right, pw_result_name(vibrate), pad.vibration_rc);
             }
         }
+#ifdef PW_PC5
+        pad.core.previous_buttons = pc5_held;
+        /* The keyboard's text, typed into the game as fast as Wine's queue takes it. */
+        if (pc5_game_on && post_input) {
+            size_t count = 0, sent = 0;
+            const uint16_t *text = pc5_game_keyboard_text(&pc5_game, &count);
+            while (sent < count) {
+                PwWineInput unit = { PW_WINE_INPUT_CHAR, text[sent], 0, 0, 1 };
+                if (post_input(&unit)) break;
+                sent++;
+                posted++;
+            }
+            if (sent) pc5_game_keyboard_typed(&pc5_game, sent);
+        }
+#endif
         if (__atomic_load_n(&display_request, __ATOMIC_ACQUIRE) &&
             !__atomic_load_n(&display_closed, __ATOMIC_RELAXED)) {
             int closed = video_status == PW_OK ? pw_videoout_ps5_close(&video) : PW_OK;
diff --git a/tests/test_pw_wine_sink.c b/tests/test_pw_wine_sink.c
