 native/wine64_main.c                          | 27 ++++++++++
 tests/test_pw_wine_sink.c                     |  8 ++-
 ...aracters-from-the-console-s-keyboard.patch | 51 +++++++++++++++++++
 wine/ps5/pw_wine_sink.c                       |  1 +
 wine/ps5/pw_wine_sink.h                       | 12 +++--
 6 files changed, 94 insertions(+), 6 deletions(-)
 create mode 100644 wine/patches/0922-win32u-ps5-type-characters-from-the-console-s-keyboard.patch

