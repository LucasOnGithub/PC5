     PwWineInput bad[]={{0,1,0,0,1},{PW_WINE_INPUT_KEY,0,0,0,1},{PW_WINE_INPUT_KEY,256,0,0,1},
                        {PW_WINE_INPUT_DIALOG_KEY,0,0,0,1},{PW_WINE_INPUT_DIALOG_KEY,300,0,0,1},
-                       {PW_WINE_INPUT_KEY,65,0,0,2},{PW_WINE_INPUT_MOUSE_BUTTON,3,0,0,1},{99,0,0,0,0}};
+                       {PW_WINE_INPUT_KEY,65,0,0,2},{PW_WINE_INPUT_MOUSE_BUTTON,3,0,0,1},{99,0,0,0,0},
+                       {PW_WINE_INPUT_CHAR,0,0,0,1},{PW_WINE_INPUT_CHAR,0x10000,0,0,1},{PW_WINE_INPUT_CHAR,'a',0,0,0}};
     for(unsigned i=0;i<sizeof(bad)/sizeof(bad[0]);i++)assert(pw_wine_post_input(&bad[i])==-1);
     assert(pw_wine_post_input(NULL)==-1);
     e=(PwWineInput){PW_WINE_INPUT_MOUSE_MOVE,0,1,2,0};
@@ -301,7 +305,7 @@ int main(void)
     for(int i=0;i<PW_WINE_INPUT_QUEUE;i++)assert(pw_wine_next_input(&out) && out.x==1 && out.y==2);
     assert(!pw_wine_next_input(&out));
     pw_wine_sink_stats(&s);
-    assert(s.inputs_posted==3+PW_WINE_INPUT_QUEUE && s.inputs_delivered==s.inputs_posted);
+    assert(s.inputs_posted==4+PW_WINE_INPUT_QUEUE && s.inputs_delivered==s.inputs_posted);
     assert(s.inputs_dropped==sizeof(bad)/sizeof(bad[0])+2);
 
     /* The wake pipe: readable after a post, empty once drained. */
diff --git a/wine/patches/0922-win32u-ps5-type-characters-from-the-console-s-keyboard.patch b/wine/patches/0922-win32u-ps5-type-characters-from-the-console-s-keyboard.patch
new file mode 100644
index 0000000..1d1b893
--- /dev/null
+++ b/wine/patches/0922-win32u-ps5-type-characters-from-the-console-s-keyboard.patch
@@ -0,0 +1,51 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 25 Oct 2026 10:39:17 +0000
+Subject: [PATCH] win32u: Let the PS5 driver type characters from the console's keyboard.
+
+The console's on-screen keyboard gives text, not keys: a name for a save,
+a server's address, a chat line. Input type 5 is one UTF-16 unit of that
+text, which the driver sends as Windows sends a character from an input
+method: KEYEVENTF_UNICODE, down and up, a VK_PACKET key that
+TranslateMessage turns into WM_CHAR. A character beyond the BMP comes as
+its two surrogates, one event each.
+---
+ dlls/win32u/ps5drv.c | 16 ++++++++++++++--
+ 1 file changed, 14 insertions(+), 2 deletions(-)
+
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -65,8 +65,8 @@ WINE_DEFAULT_DEBUG_CHANNEL(ps5drv);
+ /* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
+ struct ps5_input
+ {
+-    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 dialog key */
+-    UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
++    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 dialog key, 5 character */
++    UINT code;              /* virtual key, button 0 left 1 right 2 middle, or a UTF-16 unit */
+     INT  x, y;              /* mouse move: relative motion in desktop pixels */
+     UINT down;
+ };
+@@ -627,6 +627,18 @@ static BOOL ps5_ProcessEvents( DWORD mask )
+             if (is_extended_key( event.code )) input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+             NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+             break;
++        case 5:
++            /* A character typed on the console's on-screen keyboard, sent as
++             * Windows sends one from an input method: a VK_PACKET key, down and
++             * up, that TranslateMessage turns into WM_CHAR. A character beyond
++             * the BMP comes as its two surrogates, one event each. */
++            if (!event.code || event.code > 0xffff) break;
++            input.ki.wScan = event.code;
++            input.ki.dwFlags = KEYEVENTF_UNICODE;
++            NtUserSendHardwareInput( hwnd, 0, &input, 0 );
++            input.ki.dwFlags = KEYEVENTF_UNICODE | KEYEVENTF_KEYUP;
++            NtUserSendHardwareInput( hwnd, 0, &input, 0 );
++            break;
+         case 2:
+             move_cursor( hwnd, event.x, event.y );
+             break;
+-- 
+2.43.0
+
diff --git a/wine/ps5/pw_wine_sink.c b/wine/ps5/pw_wine_sink.c
index 4219d62..1211d80 100644
--- a/wine/ps5/pw_wine_sink.c
+++ b/wine/ps5/pw_wine_sink.c
@@ -104,6 +104,7 @@ static int valid(const PwWineInput *e)
     case PW_WINE_INPUT_DIALOG_KEY:return e->code>0 && e->code<256 && e->down<=1;
     case PW_WINE_INPUT_MOUSE_MOVE:return 1;
     case PW_WINE_INPUT_MOUSE_BUTTON:return e->code<=2 && e->down<=1;
+    case PW_WINE_INPUT_CHAR:return e->code>0 && e->code<=0xffff && e->down==1;
     default:return 0;
     }
 }
diff --git a/wine/ps5/pw_wine_sink.h b/wine/ps5/pw_wine_sink.h
index 0d0d0f7..7289dcc 100644
--- a/wine/ps5/pw_wine_sink.h
+++ b/wine/ps5/pw_wine_sink.h
@@ -26,14 +26,18 @@ typedef int (*PwWinePresentSink)(void *context,const void *bgra,uint32_t width,u
 
 /* DIALOG_KEY: a key the driver sends only while a dialog box is in front
  * (Wine patch 0911), for answering a game's pop-up with the controller; a
- * press is dropped otherwise, and a key sent down is always sent up. */
+ * press is dropped otherwise, and a key sent down is always sent up.
+ * CHAR: one UTF-16 unit of text typed on the console's on-screen keyboard,
+ * which the driver types as Windows types a character from an input method
+ * (Wine patch 0922); a character beyond the BMP is its two surrogates. */
 enum { PW_WINE_INPUT_KEY=1,PW_WINE_INPUT_MOUSE_MOVE,PW_WINE_INPUT_MOUSE_BUTTON,PW_WINE_INPUT_DIALOG_KEY,
-       PW_WINE_INPUT_QUEUE=256 };
+       PW_WINE_INPUT_CHAR,PW_WINE_INPUT_QUEUE=256 };
 typedef struct PwWineInput {
     uint32_t type;
-    uint32_t code;      /* KEY, DIALOG_KEY: Windows virtual key; MOUSE_BUTTON: 0 left, 1 right, 2 middle */
+    uint32_t code;      /* KEY, DIALOG_KEY: Windows virtual key; MOUSE_BUTTON: 0 left, 1 right, 2 middle;
+                           CHAR: a UTF-16 unit */
     int32_t x,y;        /* MOUSE_MOVE: relative motion in desktop pixels */
-    uint32_t down;      /* KEY, MOUSE_BUTTON: 1 pressed, 0 released */
+    uint32_t down;      /* KEY, MOUSE_BUTTON: 1 pressed, 0 released; CHAR: 1 */
 } PwWineInput;
 
 /* The console's output format: interleaved left,right 16-bit frames at
