--- a/tests/test_pw_wine_sink.c
+++ b/tests/test_pw_wine_sink.c
@@ -290,9 +290,13 @@ int main(void)
     /* A dialog key is a key the driver sends only to a dialog box: validated as one. */
     e=(PwWineInput){PW_WINE_INPUT_DIALOG_KEY,0x0d,0,0,1};assert(!pw_wine_post_input(&e));
     assert(pw_wine_next_input(&out) && out.type==PW_WINE_INPUT_DIALOG_KEY && out.code==0x0d && out.down==1);
+    /* A character is one UTF-16 unit, a surrogate too. */
+    e=(PwWineInput){PW_WINE_INPUT_CHAR,0xd83d,0,0,1};assert(!pw_wine_post_input(&e));
