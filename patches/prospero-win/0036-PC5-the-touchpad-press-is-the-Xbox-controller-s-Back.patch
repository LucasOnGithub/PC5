     { 0x400u, 0x0100u }, { 0x800u, 0x0200u }, { 0x2u, 0x0040u }, { 0x4u, 0x0080u },
     { 0x10u, 0x0001u }, { 0x40u, 0x0002u }, { 0x80u, 0x0004u }, { 0x20u, 0x0008u },
-    { 0x8u, 0x0010u }, { 0x1u, 0x0020u }, { 0x100000u, 0x0400u },
+    /* Back is the touchpad's press as well as Create's: the console answers
+     * Create with its own share menu, so a game's Back would bring that up. */
+    { 0x8u, 0x0010u }, { 0x1u, 0x0020u }, { 0x100000u, 0x0020u },
 };
 
