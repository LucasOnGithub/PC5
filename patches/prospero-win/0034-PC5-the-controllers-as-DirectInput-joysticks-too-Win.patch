+ dlls/dinput/dinput.c         |   10 +
+ dlls/dinput/dinput_private.h |    3 
+ dlls/dinput8/Makefile.in     |    3 
+ dlls/dinput/title_pad.c      |  530 ++++++++++++++++++++++++++++++++++++++++++
+ 5 files changed, 546 insertions(+), 3 deletions(-)
+
