++ * but WITHOUT ANY WARRANTY; without even the implied warranty of
++ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
++ * Lesser General Public License for more details.
++ *
++ * You should have received a copy of the GNU Lesser General Public
++ * License along with this library; if not, write to the Free Software
++ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
++ */
++
++/* A PS5 title runs Wine in its own process, with no winedevice for a HID
++ * stack, so joystick_hid.c finds only the HID devices the title makes itself
++ * (its DualSense, in dualsense mode). In xinput mode the title keeps each
++ * player's controller where xinput's Unix library (xinput1_3.so) reads it;
++ * here each connected one is a joystick as Windows shows an Xbox 360
++ * controller: "Controller (XBOX 360 For Windows)", 045e:028e, X and Y the
++ * left stick, Rx and Ry the right one, Z both triggers (the left one up from
++ * the middle, the right one down), the D-pad a hat and ten buttons. As on
++ * Windows it has no force feedback, which games ask of XInput, and its path
++ * names it an XInput device (IG_), so a game that reads such controllers with
++ * XInput leaves it out here. The input thread reads it every few
++ * milliseconds while it is acquired, so buffered data and event notification
++ * work as for a HID joystick. winmm's joystick calls go through DirectInput
++ * and find it too. Anywhere but in a title the library finds no title and
++ * nothing changes. */
++
++#include <stdarg.h>
++#include <string.h>
++
++#include "ntstatus.h"
++#define WIN32_NO_STATUS
++#include "windef.h"
++#include "winbase.h"
++#include "winternl.h"
++#include "winuser.h"
++#include "winerror.h"
++#include "devguid.h"
++#include "dinput.h"
++#include "xinput.h"
++
++#include "dinput_private.h"
++#include "device_private.h"
++
++#include "../xinput1_3/unixlib.h"
++
++#include "wine/debug.h"
++
++WINE_DEFAULT_DEBUG_CHANNEL(dinput);
++
++enum { TITLE_PAD_AXES = 5, TITLE_PAD_BUTTONS = 10, TITLE_PAD_READ_MS = 4 };
++
++/* {6f1d2b61-0c14-4f2b-9a3d-5053355f5000}, the player's index in the last byte */
++static const GUID title_pad_guid = { 0x6f1d2b61, 0x0c14, 0x4f2b, { 0x9a, 0x3d, 0x50, 0x53, 0x35, 0x5f, 0x50, 0x00 } };
++static const WCHAR title_pad_name[] = L"Controller (XBOX 360 For Windows)";
++
++static const struct dinput_device_vtbl title_pad_vtbl;
++
++struct title_pad
++{
++    struct dinput_device base;
++    UINT32 index;              /* XInput's: the player, 0 to 3 */
++    WCHAR path[MAX_PATH];
++};
++
++static inline struct title_pad *impl_from_IDirectInputDevice8W( IDirectInputDevice8W *iface )
++{
++    return CONTAINING_RECORD( CONTAINING_RECORD( iface, struct dinput_device, IDirectInputDevice8W_iface ), struct title_pad, base );
++}
++
++static unixlib_handle_t title_pads;
++
++static BOOL WINAPI find_title( INIT_ONCE *once, void *param, void **context )
++{
++    UNICODE_STRING name = RTL_CONSTANT_STRING( L"xinput1_3" );
++    unixlib_module_t module;
++    unixlib_handle_t handle;
++    NTSTATUS status;
++
++    if ((status = __wine_load_unix_lib( &name, &module, &handle )))
++    {
++        TRACE( "no Unix library, status %#lx\n", status );
++        return TRUE;
++    }
++    if ((status = __wine_unix_call( handle, unix_pad_init, NULL )))
++    {
++        TRACE( "no title, status %#lx\n", status );
++        __wine_unload_unix_lib( module );
++        return TRUE;
++    }
++    TRACE( "the title's controllers are joysticks\n" );
++    title_pads = handle;
++    return TRUE;
++}
++
++/* TRUE and player index's controller while it is connected. */
++static BOOL read_title_pad( UINT32 index, struct xinput_pad_state *pad )
++{
++    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
++    struct xinput_pad_state_params params = {.index = index};
++
++    memset( pad, 0, sizeof(*pad) );
++    InitOnceExecuteOnce( &once, find_title, NULL, NULL );
++    if (!title_pads || index >= XUSER_MAX_COUNT) return FALSE;
++    if (__wine_unix_call( title_pads, unix_pad_state_at, &params ) || !params.state.connected) return FALSE;
++    *pad = params.state;
++    return TRUE;
++}
++
++static BOOL title_pad_index( const GUID *guid, UINT32 *index )
++{
++    GUID base = *guid;
++
++    base.Data4[7] = 0;
++    if (!IsEqualGUID( &base, &title_pad_guid ) || guid->Data4[7] >= XUSER_MAX_COUNT) return FALSE;
++    *index = guid->Data4[7];
++    return TRUE;
++}
++
++HRESULT title_pad_enum_device( DWORD type, DWORD flags, DIDEVICEINSTANCEW *instance, DWORD version, int index )
++{
++    struct xinput_pad_state pad;
++    DWORD size;
++
++    TRACE( "type %#lx, flags %#lx, instance %p, version %#lx, index %d.\n", type, flags, instance, version, index );
++
++    if (index < 0 || !read_title_pad( index, &pad )) return DIERR_DEVICENOTREG;
++
++    size = instance->dwSize;
++    memset( instance, 0, size );
++    instance->dwSize = size;
++    instance->guidInstance = title_pad_guid;
++    instance->guidInstance.Data4[7] = index;
++    instance->guidProduct = dinput_pidvid_guid;
++    instance->guidProduct.Data1 = MAKELONG( 0x045e, 0x028e );
++    if (version >= 0x0800) instance->dwDevType = DI8DEVTYPE_GAMEPAD | (DI8DEVTYPEGAMEPAD_STANDARD << 8) | DIDEVTYPE_HID;
++    else instance->dwDevType = DIDEVTYPE_JOYSTICK | (DIDEVTYPEJOYSTICK_GAMEPAD << 8) | DIDEVTYPE_HID;
++    lstrcpynW( instance->tszInstanceName, title_pad_name, MAX_PATH );
++    lstrcpynW( instance->tszProductName, title_pad_name, MAX_PATH );
++    instance->wUsagePage = 0x01;   /* generic desktop */
++    instance->wUsage = 0x05;       /* gamepad */
++    return DI_OK;
++}
++
++static BOOL try_enum_object( struct dinput_device *impl, const DIPROPHEADER *filter, DWORD flags, enum_object_callback callback,
++                             UINT index, DIDEVICEOBJECTINSTANCEW *instance, void *data )
++{
++    if (flags != DIDFT_ALL && !(flags & DIDFT_GETTYPE( instance->dwType ))) return DIENUM_CONTINUE;
++
++    switch (filter->dwHow)
++    {
++    case DIPH_DEVICE:
++        return callback( impl, index, NULL, instance, data );
++    case DIPH_BYOFFSET:
++        if (filter->dwObj != instance->dwOfs) return DIENUM_CONTINUE;
++        return callback( impl, index, NULL, instance, data );
++    case DIPH_BYID:
++        if ((filter->dwObj & 0x00ffffff) != (instance->dwType & 0x00ffffff)) return DIENUM_CONTINUE;
++        return callback( impl, index, NULL, instance, data );
++    case DIPH_BYUSAGE:
++        if (HIWORD( filter->dwObj ) != instance->wUsagePage || LOWORD( filter->dwObj ) != instance->wUsage)
++            return DIENUM_CONTINUE;
++        return callback( impl, index, NULL, instance, data );
++    }
++
++    return DIENUM_CONTINUE;
++}
++
++/* The objects in the order Windows lists an Xbox 360 controller's: the five
++ * axes, the hat, the ten buttons. */
++static HRESULT title_pad_enum_objects( IDirectInputDevice8W *iface, const DIPROPHEADER *filter,
++                                       DWORD flags, enum_object_callback callback, void *context )
++{
++    static const struct { const GUID *type; DWORD offset; WORD usage; const WCHAR *name; } axes[TITLE_PAD_AXES] =
++    {
++        { &GUID_XAxis, DIJOFS_X, 0x30, L"X Axis" },
++        { &GUID_YAxis, DIJOFS_Y, 0x31, L"Y Axis" },
++        { &GUID_ZAxis, DIJOFS_Z, 0x32, L"Z Axis" },
++        { &GUID_RxAxis, DIJOFS_RX, 0x33, L"X Rotation" },
++        { &GUID_RyAxis, DIJOFS_RY, 0x34, L"Y Rotation" },
++    };
++    struct title_pad *impl = impl_from_IDirectInputDevice8W( iface );
++    DIDEVICEOBJECTINSTANCEW instance = {.dwSize = sizeof(instance)};
++    UINT index = 0, i;
++    BOOL ret;
++
++    for (i = 0; i < TITLE_PAD_AXES; i++)
++    {
++        instance.guidType = *axes[i].type;
++        instance.dwOfs = axes[i].offset;
++        instance.dwType = DIDFT_ABSAXIS | DIDFT_MAKEINSTANCE( i );
++        instance.dwFlags = DIDOI_ASPECTPOSITION;
++        instance.wUsagePage = 0x01;
++        instance.wUsage = axes[i].usage;
++        lstrcpynW( instance.tszName, axes[i].name, MAX_PATH );
++        ret = try_enum_object( &impl->base, filter, flags, callback, index++, &instance, context );
++        if (ret != DIENUM_CONTINUE) return DIENUM_STOP;
++    }
++
++    instance.guidType = GUID_POV;
++    instance.dwOfs = DIJOFS_POV( 0 );
++    instance.dwType = DIDFT_POV | DIDFT_MAKEINSTANCE( 0 );
++    instance.dwFlags = 0;
++    instance.wUsagePage = 0x01;
++    instance.wUsage = 0x39;   /* hat switch */
++    lstrcpynW( instance.tszName, L"Hat Switch", MAX_PATH );
++    ret = try_enum_object( &impl->base, filter, flags, callback, index++, &instance, context );
++    if (ret != DIENUM_CONTINUE) return DIENUM_STOP;
++
++    for (i = 0; i < TITLE_PAD_BUTTONS; i++)
++    {
++        instance.guidType = GUID_Button;
++        instance.dwOfs = DIJOFS_BUTTON( i );
++        instance.dwType = DIDFT_PSHBUTTON | DIDFT_MAKEINSTANCE( i );
++        instance.dwFlags = 0;
++        instance.wUsagePage = 0x09;   /* buttons */
++        instance.wUsage = i + 1;
++        swprintf( instance.tszName, MAX_PATH, L"Button %u", i );
++        ret = try_enum_object( &impl->base, filter, flags, callback, index++, &instance, context );
++        if (ret != DIENUM_CONTINUE) return DIENUM_STOP;
++    }
++
++    return DIENUM_CONTINUE;
++}
++
++/* What an axis reports before the game sets its range: 0 to 65535, centred. */
++static BOOL init_object_properties( struct dinput_device *device, UINT index, struct hid_value_caps *caps,
++                                    const DIDEVICEOBJECTINSTANCEW *instance, void *data )
++{
++    struct object_properties *properties;
++
++    if (index == -1) return DIENUM_STOP;
++    properties = device->object_properties + index;
++    properties->bit_size = 16;
++    properties->logical_min = properties->physical_min = 0;
++    properties->logical_max = properties->physical_max = 65535;
++    properties->range_min = 0;
++    properties->range_max = instance->dwType & DIDFT_AXIS ? 65535 : 35900;
++    properties->saturation = 10000;
++    properties->granularity = 1;
++    return DIENUM_CONTINUE;
++}
++
++/* An axis from 0..65535 to the game's range, with its dead zone and
++ * saturation, as joystick_hid.c scales a HID axis. */
++static LONG scale_axis( LONG value, const struct object_properties *properties )
++{
++    LONG log_ctr = 32767, log_min = 0, log_max = 65535, phy_min = properties->range_min, phy_max = properties->range_max, phy_ctr;
++
++    phy_ctr = phy_min + (phy_max - phy_min) / 2;
++    value -= log_ctr;
++    if (value <= 0)
++    {
++        log_max = MulDiv( log_min - log_ctr, properties->deadzone, 10000 );
++        log_min = MulDiv( log_min - log_ctr, properties->saturation, 10000 );
++        phy_max = phy_ctr;
++    }
++    else
++    {
++        log_min = MulDiv( log_max - log_ctr, properties->deadzone, 10000 );
++        log_max = MulDiv( log_max - log_ctr, properties->saturation, 10000 );
++        phy_min = phy_ctr;
++    }
++
++    if (value <= log_min) return phy_min;
++    if (value >= log_max) return phy_max;
++    return phy_min + MulDiv( value - log_min, phy_max - phy_min, log_max - log_min );
++}
++
++/* The D-pad as a hat: hundredths of a degree clockwise from up, -1 centred. */
++static DWORD hat_position( WORD buttons )
++{
++    BOOL up = buttons & XINPUT_GAMEPAD_DPAD_UP, down = buttons & XINPUT_GAMEPAD_DPAD_DOWN;
++    BOOL left = buttons & XINPUT_GAMEPAD_DPAD_LEFT, right = buttons & XINPUT_GAMEPAD_DPAD_RIGHT;
++
++    if (up && down) up = down = FALSE;
++    if (left && right) left = right = FALSE;
++    if (up) return right ? 4500 : left ? 31500 : 0;
++    if (down) return right ? 13500 : left ? 22500 : 18000;
++    if (right) return 9000;
++    if (left) return 27000;
++    return (DWORD)-1;
++}
++
++/* The controller's state into the device's, an event for each object that
++ * changed. Holds the base's critical section. */
++static HRESULT title_pad_update( struct title_pad *impl )
++{
++    static const WORD buttons[TITLE_PAD_BUTTONS] =
++    {
++        XINPUT_GAMEPAD_A, XINPUT_GAMEPAD_B, XINPUT_GAMEPAD_X, XINPUT_GAMEPAD_Y,
++        XINPUT_GAMEPAD_LEFT_SHOULDER, XINPUT_GAMEPAD_RIGHT_SHOULDER,
++        XINPUT_GAMEPAD_BACK, XINPUT_GAMEPAD_START,
++        XINPUT_GAMEPAD_LEFT_THUMB, XINPUT_GAMEPAD_RIGHT_THUMB,
++    };
++    IDirectInputDevice8W *iface = &impl->base.IDirectInputDevice8W_iface;
++    struct xinput_pad_state pad;
++    LONG raw[TITLE_PAD_AXES], value, old;
++    DWORD time, seq, hat;
++    BOOL changed = FALSE;
++    UINT i, index = 0;
++    BYTE *state = impl->base.device_state;
++
++    if (!read_title_pad( impl->index, &pad ))
++    {
++        if (impl->base.status == STATUS_ACQUIRED) impl->base.status = STATUS_UNPLUGGED;
++        return DIERR_INPUTLOST;
++    }
++
++    time = GetCurrentTime();
++    seq = impl->base.dinput->evsequence++;
++    raw[0] = pad.thumb_lx + 32768;
++    raw[1] = 32767 - pad.thumb_ly;
++    raw[2] = 0x8000 + (pad.left_trigger - pad.right_trigger) * 128;
++    raw[3] = pad.thumb_rx + 32768;
++    raw[4] = 32767 - pad.thumb_ry;
++    for (i = 0; i < TITLE_PAD_AXES; i++, index++)
++    {
++        static const DWORD offsets[TITLE_PAD_AXES] = { DIJOFS_X, DIJOFS_Y, DIJOFS_Z, DIJOFS_RX, DIJOFS_RY };
++        value = scale_axis( max( 0, min( 65535, raw[i] ) ), impl->base.object_properties + index );
++        old = *(LONG *)(state + offsets[i]);
++        *(LONG *)(state + offsets[i]) = value;
++        if (old != value)
++        {
++            queue_event( iface, index, value, time, seq );
++            changed = TRUE;
++        }
++    }
++
++    hat = hat_position( pad.buttons );
++    old = *(LONG *)(state + DIJOFS_POV( 0 ));
++    *(DWORD *)(state + DIJOFS_POV( 0 )) = hat;
++    if ((DWORD)old != hat)
++    {
++        queue_event( iface, index, hat, time, seq );
++        changed = TRUE;
++    }
++    index++;
++
++    for (i = 0; i < TITLE_PAD_BUTTONS; i++, index++)
++    {
++        BYTE pressed = pad.buttons & buttons[i] ? 0x80 : 0;
++        if (state[DIJOFS_BUTTON( i )] == pressed) continue;
++        state[DIJOFS_BUTTON( i )] = pressed;
++        queue_event( iface, index, pressed, time, seq );
++        changed = TRUE;
++    }
++
++    if (changed && impl->base.hEvent) SetEvent( impl->base.hEvent );
++    return DI_OK;
++}
++
++static HRESULT title_pad_poll( IDirectInputDevice8W *iface )
++{
++    struct title_pad *impl = impl_from_IDirectInputDevice8W( iface );
++    HRESULT hr;
++
++    EnterCriticalSection( &impl->base.crit );
++    hr = title_pad_update( impl );
++    LeaveCriticalSection( &impl->base.crit );
++    return hr;
++}
++
++/* The input thread, each time the device's timer fires while it is acquired. */
++static HRESULT title_pad_read( IDirectInputDevice8W *iface )
++{
++    struct title_pad *impl = impl_from_IDirectInputDevice8W( iface );
++    HRESULT hr;
++
++    EnterCriticalSection( &impl->base.crit );
++    hr = title_pad_update( impl );
++    if (FAILED(hr)) CancelWaitableTimer( impl->base.read_event );
++    LeaveCriticalSection( &impl->base.crit );
++    return hr;
++}
++
