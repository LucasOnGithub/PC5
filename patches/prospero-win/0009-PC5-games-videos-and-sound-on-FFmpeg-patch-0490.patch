++/* ---- Input: the frontend's read thread answers the demuxer's reads ------------------ */
++
++/* Demuxer thread (or connect's): no debug channels. */
++static int io_read(void *opaque, uint8_t *data, int size)
++{
++    struct wg_parser *parser = opaque;
++    int ret;
++
++    if (size <= 0)
++        return 0;
++
++    pthread_mutex_lock(&parser->mutex);
++    if (parser->position >= parser->file_size)
++    {
++        pthread_mutex_unlock(&parser->mutex);
++        return AVERROR_EOF;
++    }
++    if (parser->position + size > parser->file_size)
++        size = parser->file_size - parser->position;
++
++    parser->read.data = data;
++    parser->read.offset = parser->position;
++    parser->read.size = size;
++    parser->read.done = parser->read.error = false;
++    parser->read.done_size = 0;
++    pthread_cond_broadcast(&parser->read_cond);
++
++    while (!parser->read.done && !parser->stopping)
++        pthread_cond_wait(&parser->read_done_cond, &parser->mutex);
++
++    if (!parser->read.done)
++        ret = AVERROR_EXIT;
++    else if (parser->read.error)
++        ret = AVERROR(EIO);
++    else if (!parser->read.done_size)
++        ret = AVERROR_EOF;
++    else
++    {
++        ret = parser->read.done_size;
++        parser->position += ret;
++    }
++    parser->read.size = 0;
++    parser->read.data = NULL;
++    pthread_mutex_unlock(&parser->mutex);
++    return ret;
++}
++
++static int64_t io_seek(void *opaque, int64_t offset, int whence)
++{
++    struct wg_parser *parser = opaque;
++    int64_t position;
++
++    switch (whence & ~AVSEEK_FORCE)
++    {
++    case AVSEEK_SIZE: return parser->file_size;
++    case SEEK_SET:    position = offset; break;
++    case SEEK_CUR:    position = parser->position + offset; break;
++    case SEEK_END:    position = parser->file_size + offset; break;
++    default:          return AVERROR(EINVAL);
++    }
++    if (position < 0)
++        return AVERROR(EINVAL);
++    parser->position = position;
++    return position;
++}
