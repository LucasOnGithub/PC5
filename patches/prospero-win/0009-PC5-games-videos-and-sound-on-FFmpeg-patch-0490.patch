diff --git a/tools/build_ffmpeg_ps5.sh b/tools/build_ffmpeg_ps5.sh
new file mode 100755
index 0000000..4ead733
--- /dev/null
+++ b/tools/build_ffmpeg_ps5.sh
@@ -0,0 +1,65 @@
+#!/bin/sh
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# FFmpeg for Wine's media on the PS5: static libraries, built with the payload
+# SDK, that the console's winedmo.prx (demuxing) and winegstreamer.prx
+# (decoding, conversion) link. Only FFmpeg's LGPL parts: the build stops if
+# its configuration turns on anything under the GPL or nonfree.
+#
+#   tools/build_ffmpeg_ps5.sh --source DIR --sdk DIR --out DIR [--jobs N]
+#
+# --source is an FFmpeg checkout at FFMPEG_COMMIT; --out receives include/
+# and lib/ (libavformat, libavcodec, libswscale, libswresample, libavutil).
+set -eu
+
+FFMPEG_VERSION=8.1.3
+FFMPEG_COMMIT=1041abdc962f4cc4f394aa8de9dc5236c0c3b9e7
+FFMPEG_URL=https://github.com/FFmpeg/FFmpeg.git
+# What Wine plays: every demuxer, decoder, parser and bitstream filter, the
+# scaler and the resampler. No encoders, muxers, protocols, filters, devices or
+# programs; nothing found on the build machine.
+FFMPEG_CONFIGURE="--enable-cross-compile --target-os=freebsd --arch=x86_64
+ --enable-static --disable-shared --enable-pic --enable-pthreads
+ --disable-autodetect --disable-programs --disable-doc --disable-debug
+ --disable-network --disable-avdevice --disable-avfilter
+ --disable-everything --enable-demuxers --enable-decoders --enable-parsers --enable-bsfs
+ --enable-swscale --enable-swresample"
+
+fail() { echo "build_ffmpeg_ps5: $*" >&2; exit 1; }
+source_dir= sdk= out= jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
+while [ $# -gt 0 ]; do
+    case $1 in
+    --source) source_dir=$2; shift ;;
+    --sdk) sdk=$2; shift ;;
+    --out) out=$2; shift ;;
+    --jobs) jobs=$2; shift ;;
+    --print-commit) echo "$FFMPEG_COMMIT"; exit 0 ;;
+    *) fail "unknown argument $1" ;;
+    esac
+    shift
+done
+[ -n "$source_dir" ] && [ -n "$sdk" ] && [ -n "$out" ] || fail "usage: --source DIR --sdk DIR --out DIR"
+[ -x "$sdk/bin/prospero-clang" ] || fail "no PS5 payload SDK at $sdk"
+[ "$(git -C "$source_dir" rev-parse HEAD 2>/dev/null)" = "$FFMPEG_COMMIT" ] ||
+    fail "$source_dir is not FFmpeg $FFMPEG_VERSION ($FFMPEG_COMMIT)"
+command -v nasm >/dev/null || fail "nasm is needed for FFmpeg's x86 assembly"
+
+stamp=$(printf '%s\n' "$FFMPEG_COMMIT" "$FFMPEG_CONFIGURE" | sha256sum | cut -c1-64)
+[ "$(cat "$out/.prospero-stamp" 2>/dev/null)" != "$stamp" ] || { echo "ffmpeg: up to date in $out"; exit 0; }
+rm -rf "$out"
+mkdir -p "$out/build"
+# An out-of-tree build keeps the checkout clean for the source bundle.
+# shellcheck disable=SC2086
+(cd "$out/build" && "$source_dir/configure" --prefix="$out" $FFMPEG_CONFIGURE \
+    --cc="$sdk/bin/prospero-clang" --ar="$sdk/bin/llvm-ar" --ranlib="$sdk/bin/llvm-ranlib" \
+    --nm="$sdk/bin/llvm-nm" --strip="$sdk/bin/llvm-strip" \
+    --extra-cflags="-ffunction-sections -fdata-sections" > "$out/configure.log" 2>&1) ||
+    fail "configure failed; see $out/configure.log"
+config=$out/build/config.h
+for licence in GPL NONFREE VERSION3; do
+    grep -q "^#define CONFIG_$licence 0$" "$config" || fail "CONFIG_$licence is on: FFmpeg would not be LGPL 2.1"
+done
+make -C "$out/build" -j"$jobs" > "$out/make.log" 2>&1 || fail "the build failed; see $out/make.log"
+make -C "$out/build" install > "$out/install.log" 2>&1 || fail "the install failed; see $out/install.log"
+cp "$source_dir/COPYING.LGPLv2.1" "$source_dir/LICENSE.md" "$out/"
+echo "$stamp" > "$out/.prospero-stamp"
+echo "ffmpeg $FFMPEG_VERSION: $(ls "$out/lib"/*.a | wc -l) libraries in $out/lib"
