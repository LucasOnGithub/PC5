++
++BYTE *wg_audio_convert(struct wg_audio_converter *converter, const AVFrame *frame,
++        wg_audio_format format, UINT32 channels, UINT32 channel_mask, UINT32 rate, size_t *size)
++{
++    enum AVSampleFormat dst_fmt = wg_audio_format_to_av(format);
++    int samples, count, bytes = av_get_bytes_per_sample(dst_fmt);
++    BYTE *buffer;
++
++    *size = 0;
++    if (dst_fmt == AV_SAMPLE_FMT_NONE || !channels || !rate)
++        return NULL;
++
++    if (frame && (!converter->swr || converter->src_fmt != frame->format || converter->src_rate != frame->sample_rate
++            || av_channel_layout_compare(&converter->src_layout, &frame->ch_layout)
++            || converter->dst_format != format || converter->dst_channels != channels
++            || converter->dst_mask != channel_mask || converter->dst_rate != rate))
++    {
++        AVChannelLayout dst_layout = {0};
++
++        swr_free(&converter->swr);
++        wg_channel_layout_from_mask(&dst_layout, channels, channel_mask);
++        if (swr_alloc_set_opts2(&converter->swr, &dst_layout, dst_fmt, rate, &frame->ch_layout,
++                frame->format, frame->sample_rate, 0, NULL) < 0 || swr_init(converter->swr) < 0)
++        {
++            ERR("Cannot convert %s at %d Hz to %s at %u Hz.\n", av_get_sample_fmt_name(frame->format),
++                    frame->sample_rate, av_get_sample_fmt_name(dst_fmt), rate);
++            swr_free(&converter->swr);
++            av_channel_layout_uninit(&dst_layout);
++            return NULL;
++        }
++        av_channel_layout_uninit(&dst_layout);
++        converter->src_fmt = frame->format;
++        converter->src_rate = frame->sample_rate;
++        av_channel_layout_uninit(&converter->src_layout);
++        av_channel_layout_copy(&converter->src_layout, &frame->ch_layout);
++        converter->dst_format = format;
++        converter->dst_channels = channels;
++        converter->dst_mask = channel_mask;
++        converter->dst_rate = rate;
++    }
++    if (!converter->swr)
++        return NULL;
++
++    if ((samples = swr_get_out_samples(converter->swr, frame ? frame->nb_samples : 0)) <= 0)
++        return NULL;
++    if (!(buffer = malloc((size_t)samples * channels * bytes)))
++        return NULL;
++    if ((count = swr_convert(converter->swr, &buffer, samples,
++            frame ? (const uint8_t **)frame->extended_data : NULL, frame ? frame->nb_samples : 0)) <= 0)
++    {
++        free(buffer);
++        return NULL;
++    }
++
++    if (format == WG_AUDIO_FORMAT_S24LE)
++    {
++        /* The top three bytes of each 32-bit sample. */
++        size_t i, total = (size_t)count * channels;
++        for (i = 0; i < total; ++i)
++            memmove(buffer + i * 3, buffer + i * 4 + 1, 3);
++        bytes = 3;
++    }
++
++    *size = (size_t)count * channels * bytes;
++    return buffer;
++}
