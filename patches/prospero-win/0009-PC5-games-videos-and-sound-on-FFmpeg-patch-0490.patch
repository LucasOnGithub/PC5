++/* A pushed sample as a packet to decode, or as a frame when it is raw; the
++ * sample is let go of either way. */
++static void *take_sample(struct wg_transform *transform, struct wg_sample *sample)
++{
++    void *item = NULL;
++
++    if (transform->codec)
++    {
++        AVPacket *packet;
++
++        if ((packet = av_packet_alloc()) && av_new_packet(packet, sample->size) >= 0)
++        {
++            memcpy(packet->data, (BYTE *)(UINT_PTR)sample->data, sample->size);
++            if (sample->flags & WG_SAMPLE_FLAG_HAS_PTS)
++                packet->pts = sample->pts;
++            if (sample->flags & WG_SAMPLE_FLAG_HAS_DURATION)
++                packet->duration = sample->duration;
++            if (sample->flags & WG_SAMPLE_FLAG_SYNC_POINT)
++                packet->flags |= AV_PKT_FLAG_KEY;
++            packet->time_base = WG_TIME_BASE;
++            item = packet;
++        }
++        else
++            av_packet_free(&packet);
++    }
++    else
++    {
++        AVFrame *frame = transform->kind == AVMEDIA_TYPE_VIDEO ? frame_from_raw_video(transform, sample)
++                : frame_from_raw_audio(transform, sample);
++
++        if (frame)
++        {
++            frame->pts = sample->flags & WG_SAMPLE_FLAG_HAS_PTS ? sample->pts : AV_NOPTS_VALUE;
++            frame->duration = sample->flags & WG_SAMPLE_FLAG_HAS_DURATION ? sample->duration : 0;
++            item = frame;
++        }
++    }
++    InterlockedDecrement(&sample->refcount);
++    return item;
++}
++
++static void push_parsed(struct wg_transform *transform, const uint8_t *data, int size)
++{
++    AVPacket *frame;
++
++    if (!size)
++        return;
++    if ((frame = av_packet_alloc()) && av_new_packet(frame, size) >= 0)
++    {
++        memcpy(frame->data, data, size);
++        frame->pts = transform->parser->pts;
++        frame->time_base = WG_TIME_BASE;
++        if (transform->parser->key_frame == 1)
++            frame->flags |= AV_PKT_FLAG_KEY;
++        if (fifo_push(&transform->packets, frame))
++            return;
++    }
++    av_packet_free(&frame);
++}
++
++/* Splits one pushed packet into the decoder's frames; NULL takes what the
++ * parser still holds, at the end of the stream. */
++static void parse_packet(struct wg_transform *transform, AVPacket *packet)
++{
++    const uint8_t *data;
++    uint8_t *out;
++    int size, out_size, used;
++    INT64 pts;
++
++    if (!packet)
++    {
++        av_parser_parse2(transform->parser, transform->decoder, &out, &out_size, NULL, 0,
++                AV_NOPTS_VALUE, AV_NOPTS_VALUE, 0);
++        push_parsed(transform, out, out_size);
++        return;
++    }
++
++    data = packet->data;
++    size = packet->size;
++    pts = packet->pts;
++    while (size > 0)
++    {
++        if ((used = av_parser_parse2(transform->parser, transform->decoder, &out, &out_size, data, size,
++                pts, AV_NOPTS_VALUE, 0)) < 0)
++            break;
++        data += used;
++        size -= used;
++        push_parsed(transform, out, out_size);
++        /* The packet's time belongs to its start; the rest continues it. */
++        pts = AV_NOPTS_VALUE;
++        if (!used && !out_size)
++            break;
++    }
++}
++
++static void complete_drain(struct wg_transform *transform)
++{
++    if (transform->decoder)
++        avcodec_flush_buffers(transform->decoder);
++    if (transform->parser)
++    {
++        av_parser_close(transform->parser);
++        transform->parser = av_parser_init(transform->codec->codec_id);
++    }
++    transform->eof_sent = false;
++    transform->draining = false;
++}
++
++/* Moves decoded frames to the frame fifo; true when there is one to read.
++ * With all, it goes on until the decoder needs more input or has drained. */
++static bool decode_frames(struct wg_transform *transform, bool all)
++{
++    AVFrame *frame;
++    int ret;
++
++    if (!transform->codec)
++    {
++        struct wg_sample *sample;
++
++        while ((sample = fifo_pop(&transform->input)))
++            if ((frame = take_sample(transform, sample)) && !fifo_push(&transform->frames, frame))
++                av_frame_free(&frame);
++        if (transform->draining)
++            complete_drain(transform);
++        return transform->frames.count > 0;
++    }
++
++    if (!transform->decoder && transform->input.count
++            && !(transform->decoder = wg_decoder_open(transform->codec, WG_TIME_BASE, transform->attrs.low_latency)))
++    {
++        /* Nothing can be made of the samples. */
++        ERR("Cannot open the %s decoder.\n", avcodec_get_name(transform->codec->codec_id));
++        clear_input(transform);
++        transform->draining = false;
++        return false;
++    }
++    if (!transform->decoder)
++    {
++        transform->draining = false;
++        return false;
++    }
++
++    for (;;)
++    {
++        AVPacket *packet;
++
++        if (!(frame = av_frame_alloc()))
++            return transform->frames.count > 0;
++        ret = avcodec_receive_frame(transform->decoder, frame);
++        if (!ret)
++        {
++            if (!fifo_push(&transform->frames, frame))
++                av_frame_free(&frame);
++            continue;
++        }
++        av_frame_free(&frame);
++
++        if (ret == AVERROR_EOF)
++        {
++            complete_drain(transform);
++            return transform->frames.count > 0;
++        }
++        if (ret != AVERROR(EAGAIN))
++            WARN("Decoder error %d.\n", ret);
++        if (transform->frames.count && !all)
++            return true;
++
++        if ((packet = fifo_peek(&transform->packets)))
++        {
++            ret = avcodec_send_packet(transform->decoder, packet);
++            if (ret == AVERROR(EAGAIN))
++                continue;
++            if (ret < 0)
++                WARN("Decoder refused a packet of %d bytes, error %d.\n", packet->size, ret);
++            fifo_pop(&transform->packets);
++            av_packet_free(&packet);
++            continue;
++        }
++
++        if (transform->input.count)
++        {
++            if (!(packet = take_sample(transform, fifo_pop(&transform->input))))
++                continue;
++            if (transform->parser)
++            {
++                parse_packet(transform, packet);
++                av_packet_free(&packet);
++            }
++            else if (!fifo_push(&transform->packets, packet))
++                av_packet_free(&packet);
++            continue;
++        }
++
++        if (transform->draining && !transform->eof_sent)
++        {
++            if (transform->parser)
++                parse_packet(transform, NULL);
++            if (transform->packets.count)
++                continue;
++            avcodec_send_packet(transform->decoder, NULL);
++            transform->eof_sent = true;
++            continue;
++        }
++
++        return transform->frames.count > 0;
++    }
++}
