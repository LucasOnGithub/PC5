++    pthread_mutex_unlock(&parser->mutex);
++    return S_OK;
++}
++
++NTSTATUS wg_parser_stream_get_codec_format(void *args)
++{
++    struct wg_parser_stream_get_codec_format_params *params = args;
++    struct wg_parser_stream *stream = get_stream(params->stream);
++
++    *params->format = stream->has_codec_format ? stream->codec_format : stream->current_format;
++    return S_OK;
++}
++
++NTSTATUS wg_parser_stream_enable(void *args)
++{
++    const struct wg_parser_stream_enable_params *params = args;
++    struct wg_parser_stream *stream = get_stream(params->stream);
++    struct wg_parser *parser = stream->parser;
++
++    pthread_mutex_lock(&parser->mutex);
++    stream->desired_format = *params->format;
++    stream->has_desired = true;
++    stream->enabled = true;
++    /* A unit not yet given out is converted again, to the new format. */
++    if (stream->buffer && !stream->get_buffer_called && !stream->decoding)
++    {
++        if (stream->buffer_owned)
++            free(stream->buffer);
++        stream->buffer = NULL;
++        stream->buffer_owned = false;
++    }
++    pthread_cond_broadcast(&parser->cond);
++    pthread_mutex_unlock(&parser->mutex);
++    return S_OK;
++}
++
++NTSTATUS wg_parser_stream_disable(void *args)
++{
++    struct wg_parser_stream *stream = get_stream(*(wg_parser_stream_t *)args);
++    struct wg_parser *parser = stream->parser;
++
++    pthread_mutex_lock(&parser->mutex);
++    stream->enabled = false;
++    stream->has_desired = false;
++    stream->generation++;
++    clear_packets(stream);
++    if (!stream->decoding)
++        drop_unit(stream);
++    pthread_cond_broadcast(&parser->cond);
++    pthread_mutex_unlock(&parser->mutex);
++    return S_OK;
++}
++
++/* ---- The demuxer thread ------------------------------------------------------------ */
++
++static bool queues_full(struct wg_parser *parser)
++{
++    bool over = false, waited = false;
++    unsigned int i;
++
++    for (i = 0; i < parser->stream_count; ++i)
++    {
++        struct wg_parser_stream *stream = parser->streams[i];
++
++        if (!stream->enabled)
++            continue;
++        if (stream->packets.count >= HARD_PACKETS || stream->packet_bytes >= HARD_BYTES)
++            return true;
++        if (stream->packets.count >= SOFT_PACKETS || stream->packet_bytes >= SOFT_BYTES)
++            over = true;
++        if (stream->waiters && !stream->packets.count)
++            waited = true;
++    }
++    return over && !waited;
++}
++
++static void queue_packet(struct wg_parser *parser, AVPacket *packet)
++{
++    struct wg_parser_stream *stream = NULL;
++    AVPacket *copy;
++
++    if ((unsigned int)packet->stream_index < parser->index_count)
++        stream = parser->by_index[packet->stream_index];
++    if (!stream || !stream->enabled || !(copy = av_packet_alloc()))
++    {
++        av_packet_unref(packet);
++        return;
++    }
++    av_packet_move_ref(copy, packet);
++    if (!fifo_push(&stream->packets, copy))
++    {
++        av_packet_free(&copy);
++        return;
++    }
++    stream->packet_bytes += copy->size;
++    pthread_cond_broadcast(&parser->cond);
++}
++
++static void seek_demuxer(struct wg_parser *parser, INT64 target)
++{
++    INT64 time = av_rescale_q(max(target, 0) + parser->start_offset, WG_TIME_BASE, AV_TIME_BASE_Q);
++
++    /* The key frame at or before the time; the decoders skip to it exactly. */
++    if (avformat_seek_file(parser->format, -1, INT64_MIN, time, time, 0) < 0
++            && av_seek_frame(parser->format, -1, time, AVSEEK_FLAG_BACKWARD) < 0
++            && av_seek_frame(parser->format, -1, time, AVSEEK_FLAG_BACKWARD | AVSEEK_FLAG_ANY) < 0
++            && !target)
++        avio_seek(parser->format->pb, 0, SEEK_SET);
++}
++
++/* No debug channels in here. */
++static void *demuxer_thread(void *arg)
++{
++    struct wg_parser *parser = arg;
++    AVPacket *packet = av_packet_alloc();
++    unsigned int retries = 0;
++    int ret;
++
++    pthread_mutex_lock(&parser->mutex);
++    while (!parser->stopping && packet)
++    {
++        if (parser->seek_pending)
++        {
++            INT64 target = parser->seek_target;
++
++            parser->seek_pending = false;
++            pthread_mutex_unlock(&parser->mutex);
++            seek_demuxer(parser, target);
++            pthread_mutex_lock(&parser->mutex);
++            if (!parser->seek_pending)
++                parser->eof = false;
++            continue;
++        }
++        if (!parser->started || parser->eof || queues_full(parser))
++        {
++            pthread_cond_wait(&parser->cond, &parser->mutex);
++            continue;
++        }
++
++        pthread_mutex_unlock(&parser->mutex);
++        ret = av_read_frame(parser->format, packet);
++        pthread_mutex_lock(&parser->mutex);
++
++        if (parser->stopping || parser->seek_pending)
++        {
++            av_packet_unref(packet);
++            continue;
++        }
++        if (ret == AVERROR(EAGAIN) && ++retries < 1000)
++            continue;
++        retries = 0;
++        if (ret < 0)
++        {
++            unsigned int i;
++
++            parser->eof = true;
++            for (i = 0; i < parser->stream_count; ++i)
++                parser->streams[i]->packets_eos = true;
++            pthread_cond_broadcast(&parser->cond);
++            continue;
++        }
++        queue_packet(parser, packet);
++    }
++    pthread_mutex_unlock(&parser->mutex);
++    av_packet_free(&packet);
++    return NULL;
++}
++
++/* ---- Units: what the frontends read --------------------------------------------- */
++
++static void set_unit_times(struct wg_parser *parser, struct wg_parser_stream *stream,
++        bool has_pts, INT64 pts, bool has_duration, UINT64 duration, bool delta)
++{
++    stream->unit_has_pts = has_pts;
++    stream->unit_pts = pts;
++    stream->unit_has_duration = has_duration;
++    stream->unit_duration = duration;
++    stream->unit_delta = delta;
++    stream->unit_discontinuity = stream->discontinuity;
++    stream->discontinuity = false;
++
++    /* The earliest first time of the streams, for the frontends that start at zero. */
++    if (!stream->has_buffer)
++    {
++        stream->has_buffer = true;
++        if (has_pts && (!parser->has_base_pts || pts < parser->base_pts))
++        {
++            parser->base_pts = pts;
++            parser->has_base_pts = true;
++        }
++    }
++}
++
++/* Takes the next packet of a stream given as is; false when it must wait. */
++static bool next_packet(struct wg_parser *parser, struct wg_parser_stream *stream)
++{
++    AVPacket *packet;
++    INT64 time, pts = 0;
++
++    if (!(packet = fifo_pop(&stream->packets)))
++    {
++        if (!stream->packets_eos)
++            return false;
++        stream->eos = true;
++        return true;
++    }
++    stream->packet_bytes -= packet->size;
++    pthread_cond_broadcast(&parser->cond);
++
++    if (stream->bsf)
++    {
++        AVPacket *filtered = av_packet_alloc();
++
++        if (filtered && av_bsf_send_packet(stream->bsf, packet) >= 0
++                && av_bsf_receive_packet(stream->bsf, filtered) >= 0)
++        {
++            av_packet_free(&packet);
++            packet = filtered;
++        }
++        else
++        {
++            av_packet_free(&filtered);
++            av_packet_free(&packet);
++            return true;
++        }
++    }
++
++    time = packet->pts != AV_NOPTS_VALUE ? packet->pts : packet->dts;
++    if (time != AV_NOPTS_VALUE)
++        pts = to_wg_time(parser, time, stream->av->time_base);
++    if (time != AV_NOPTS_VALUE && pts >= parser->stop_pos)
++    {
++        av_packet_free(&packet);
++        clear_packets(stream);
++        stream->eos = true;
++        return true;
++    }
++    set_unit_times(parser, stream, time != AV_NOPTS_VALUE, pts, packet->duration > 0,
++            packet->duration > 0 ? av_rescale_q(packet->duration, stream->av->time_base, WG_TIME_BASE) : 0,
++            !(packet->flags & AV_PKT_FLAG_KEY));
++    stream->packet = packet;
++    return true;
++}
++
++/* A decoded frame: its times, and whether it is wanted at all. */
++static bool accept_frame(struct wg_parser *parser, struct wg_parser_stream *stream, AVFrame *frame)
++{
++    INT64 time = frame->best_effort_timestamp != AV_NOPTS_VALUE ? frame->best_effort_timestamp : frame->pts;
++    bool has_pts = time != AV_NOPTS_VALUE, has_duration = true;
++    INT64 pts = has_pts ? to_wg_time(parser, time, stream->av->time_base) : 0;
++    UINT64 duration = 0;
++
++    if (frame->duration > 0)
++        duration = av_rescale_q(frame->duration, stream->av->time_base, WG_TIME_BASE);
++    else if (stream->decoder->codec_type == AVMEDIA_TYPE_AUDIO && frame->sample_rate > 0)
++        duration = av_rescale(frame->nb_samples, 10000000, frame->sample_rate);
++    else if (stream->current_format.u.video.fps_n)
++        duration = av_rescale(10000000, stream->current_format.u.video.fps_d, stream->current_format.u.video.fps_n);
++    else
++        has_duration = false;
++
++    if (stream->decoder->codec_type == AVMEDIA_TYPE_AUDIO)
++    {
++        /* Audio frames without a time follow the one before. */
++        if (!has_pts && stream->next_audio_pts_valid)
++        {
++            pts = stream->next_audio_pts;
++            has_pts = true;
++        }
++        stream->next_audio_pts = pts + duration;
++        stream->next_audio_pts_valid = has_pts;
++    }
++
++    if (has_pts && stream->skip_until != INT64_MIN)
++    {
++        if (pts + (INT64)duration <= stream->skip_until)
++            return false;
++        stream->skip_until = INT64_MIN;
++    }
++    if (has_pts && pts >= parser->stop_pos)
++    {
++        stream->eos = true;
++        return false;
++    }
++
++    set_unit_times(parser, stream, has_pts, pts, has_duration, duration,
++            stream->decoder->codec_type == AVMEDIA_TYPE_VIDEO && !(frame->flags & AV_FRAME_FLAG_KEY));
++    return true;
++}
++
++/* Decodes the next frame of a stream; called with the lock, which it drops
++ * around FFmpeg's work. */
++static void decode_next(struct wg_parser *parser, struct wg_parser_stream *stream)
++{
++    unsigned int generation = stream->generation;
++    AVFrame *frame;
++    AVPacket *packet;
++    int ret;
++
++    stream->decoding = true;
++    if (stream->decoder_generation != generation)
++    {
++        pthread_mutex_unlock(&parser->mutex);
++        avcodec_flush_buffers(stream->decoder);
++        wg_audio_converter_reset(&stream->audio_converter);
++        pthread_mutex_lock(&parser->mutex);
++        stream->decoder_generation = generation;
++        stream->eof_sent = false;
++        stream->next_audio_pts_valid = false;
++    }
++
++    if (!(frame = av_frame_alloc()))
++        goto done;
++
++    for (;;)
++    {
++        pthread_mutex_unlock(&parser->mutex);
++        ret = avcodec_receive_frame(stream->decoder, frame);
++        pthread_mutex_lock(&parser->mutex);
++
++        if (generation != stream->generation || parser->stopping || !stream->enabled)
++            break;
++        if (!ret)
++        {
++            if (accept_frame(parser, stream, frame))
++            {
++                stream->frame = frame;
++                frame = NULL;
++                break;
++            }
++            av_frame_unref(frame);
++            if (stream->eos)
++                break;
++            continue;
++        }
++        if (ret == AVERROR_EOF)
++        {
++            stream->eos = true;
++            break;
++        }
++
++        if ((packet = fifo_pop(&stream->packets)))
++        {
++            stream->packet_bytes -= packet->size;
++            pthread_cond_broadcast(&parser->cond);
++            pthread_mutex_unlock(&parser->mutex);
++            if ((ret = avcodec_send_packet(stream->decoder, packet)) < 0 && ret != AVERROR(EAGAIN))
++                wg_flush_log();
++            av_packet_free(&packet);
++            pthread_mutex_lock(&parser->mutex);
++            continue;
++        }
++        if (stream->packets_eos)
++        {
++            if (stream->eof_sent)
++            {
++                stream->eos = true;
++                break;
++            }
++            pthread_mutex_unlock(&parser->mutex);
++            avcodec_send_packet(stream->decoder, NULL);
++            pthread_mutex_lock(&parser->mutex);
++            stream->eof_sent = true;
++            continue;
++        }
++
++        /* Wait for the demuxer. */
++        stream->waiters++;
++        pthread_cond_broadcast(&parser->cond);
++        pthread_cond_wait(&parser->cond, &parser->mutex);
++        stream->waiters--;
++        if (generation != stream->generation || parser->stopping || !stream->enabled)
++            break;
++    }
++    av_frame_free(&frame);
++
++done:
++    stream->decoding = false;
++    if (generation != stream->generation)
++        drop_unit(stream);
++    pthread_cond_broadcast(&parser->cond);
++}
++
++/* Makes the stream's next unit ready, or finds that there is none. */
++static void prepare_stream(struct wg_parser *parser, struct wg_parser_stream *stream)
++{
++    while (stream->enabled && !has_unit(stream) && !stream->eos && !parser->stopping)
++    {
++        if (stream->decoding)
++            pthread_cond_wait(&parser->cond, &parser->mutex);
++        else if (stream->compressed)
++        {
++            if (!next_packet(parser, stream))
++            {
++                stream->waiters++;
++                pthread_cond_broadcast(&parser->cond);
++                pthread_cond_wait(&parser->cond, &parser->mutex);
++                stream->waiters--;
++            }
++        }
++        else
++            decode_next(parser, stream);
++    }
++}
++
++/* The unit in the frontend's format; false when it was dropped meanwhile. */
++static bool make_buffer(struct wg_parser *parser, struct wg_parser_stream *stream)
++{
++    unsigned int generation = stream->generation;
++    struct wg_format format;
++    BYTE *buffer = NULL;
++    size_t size = 0;
++
++    if (stream->buffer)
++        return true;
++    if (stream->packet)
++    {
++        stream->buffer = stream->packet->data;
++        stream->buffer_size = stream->packet->size;
++        stream->buffer_owned = false;
++        return true;
++    }
++
++    format = stream->has_desired ? stream->desired_format : stream->current_format;
++    stream->decoding = true;
++    pthread_mutex_unlock(&parser->mutex);
++
++    if (format.major_type == WG_MAJOR_TYPE_VIDEO)
++    {
++        const AVFrame *frame = stream->frame;
++        struct wg_video_layout layout;
++        int width = format.u.video.width ? format.u.video.width : frame->width;
++        int height = format.u.video.height ? abs(format.u.video.height) : frame->height;
++
++        if (format.u.video.format == WG_VIDEO_FORMAT_UNKNOWN)
++            format.u.video.format = wg_video_format_from_av(frame->format);
++        if (wg_video_layout_default(&layout, format.u.video.format, width, height, format.u.video.height < 0)
++                && (buffer = malloc(layout.size)))
++        {
++            if (wg_video_convert(&stream->video_converter, frame, buffer, &layout))
++                size = layout.size;
++            else
++            {
++                free(buffer);
++                buffer = NULL;
++            }
++        }
++    }
++    else if (format.major_type == WG_MAJOR_TYPE_AUDIO)
++    {
++        const AVFrame *frame = stream->frame;
++
++        buffer = wg_audio_convert(&stream->audio_converter, frame,
++                format.u.audio.format ? format.u.audio.format : wg_audio_format_from_av(frame->format),
++                format.u.audio.channels ? format.u.audio.channels : frame->ch_layout.nb_channels,
++                format.u.audio.channels ? format.u.audio.channel_mask : wg_channel_mask_from_layout(&frame->ch_layout),
++                format.u.audio.rate ? format.u.audio.rate : frame->sample_rate, &size);
++    }
++    else
++        ERR("Stream %u has no raw format.\n", stream->number);
++
++    pthread_mutex_lock(&parser->mutex);
++    stream->decoding = false;
++    pthread_cond_broadcast(&parser->cond);
++    if (generation != stream->generation || !buffer)
++    {
++        free(buffer);
++        drop_unit(stream);
++        return false;
++    }
++    stream->buffer = buffer;
++    stream->buffer_size = size;
++    stream->buffer_owned = true;
++    return true;
++}
++
++static INT64 unit_order(const struct wg_parser_stream *stream)
++{
++    return stream->unit_has_pts ? stream->unit_pts : INT64_MAX;
++}
++
++NTSTATUS wg_parser_stream_get_buffer(void *args)
++{
++    const struct wg_parser_stream_get_buffer_params *params = args;
++    struct wg_parser_buffer *wg_buffer = params->buffer;
++    struct wg_parser_stream *stream = get_stream(params->stream);
++    struct wg_parser *parser = get_parser(params->parser);
++    struct wg_parser_stream *chosen;
++    unsigned int i;
++    INT64 pts;
++
++    pthread_mutex_lock(&parser->mutex);
++    if (!parser->started)
++    {
++        parser->started = true;
++        pthread_cond_broadcast(&parser->cond);
++    }
++
++    for (;;)
++    {
++        chosen = NULL;
++        if (stream)
++        {
++            prepare_stream(parser, stream);
++            if (stream->enabled && has_unit(stream))
++                chosen = stream;
++        }
++        else
++        {
++            /* The earliest unit of all streams: each stream's frames come at their own pace. */
++            for (i = 0; i < parser->stream_count; ++i)
++            {
++                struct wg_parser_stream *other = parser->streams[i];
++
++                if (!other->enabled)
++                    continue;
++                prepare_stream(parser, other);
++                if (other->enabled && has_unit(other) && (!chosen || unit_order(other) < unit_order(chosen)))
++                    chosen = other;
++            }
++        }
++        if (!chosen || parser->stopping)
++        {
++            pthread_mutex_unlock(&parser->mutex);
++            wg_flush_log();
++            return S_FALSE;
++        }
++        if (make_buffer(parser, chosen))
++            break;
++    }
++
++    pts = chosen->unit_pts;
++    if (parser->pts_rebased && parser->has_base_pts)
++        pts -= parser->base_pts;
++    wg_buffer->has_pts = chosen->unit_has_pts;
++    wg_buffer->pts = max(pts, 0);
++    wg_buffer->has_duration = chosen->unit_has_duration;
++    wg_buffer->duration = chosen->unit_duration;
++    wg_buffer->discontinuity = chosen->unit_discontinuity;
++    wg_buffer->preroll = 0;
++    wg_buffer->delta = chosen->unit_delta;
++    wg_buffer->size = chosen->buffer_size;
++    wg_buffer->stream = chosen->number;
++    chosen->get_buffer_called = true;
++
++    pthread_mutex_unlock(&parser->mutex);
++    wg_flush_log();
++    return S_OK;
++}
++
++NTSTATUS wg_parser_stream_copy_buffer(void *args)
++{
++    const struct wg_parser_stream_copy_buffer_params *params = args;
++    struct wg_parser_stream *stream = get_stream(params->stream);
++    struct wg_parser *parser = stream->parser;
++
++    pthread_mutex_lock(&parser->mutex);
++    if (!stream->buffer || !stream->get_buffer_called)
++    {
++        pthread_mutex_unlock(&parser->mutex);
++        return VFW_E_WRONG_STATE;
++    }
++    if (params->offset >= stream->buffer_size || params->size > stream->buffer_size - params->offset)
++    {
++        pthread_mutex_unlock(&parser->mutex);
++        ERR("Copying %u bytes at %u of a %zu byte buffer.\n", params->size, params->offset, stream->buffer_size);
++        return STATUS_INVALID_PARAMETER;
++    }
++    memcpy(params->data, stream->buffer + params->offset, params->size);
++    pthread_mutex_unlock(&parser->mutex);
