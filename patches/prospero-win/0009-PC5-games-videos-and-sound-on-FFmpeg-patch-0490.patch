++NTSTATUS wg_media_type_from_raw_video(struct wg_media_type *media_type, wg_video_format format,
++        int width, int height, AVRational fps, AVRational par, UINT32 plane_align)
++{
++    const GUID *subtype = wg_video_format_subtype(format);
++    UINT32 capacity = media_type->format_size;
++    MFVIDEOFORMAT *video = media_type->u.video;
++
++    media_type->major = MFMediaType_Video;
++    media_type->format_size = sizeof(*video);
++    if (!subtype)
++        return STATUS_UNSUCCESSFUL;
++    if (capacity < sizeof(*video) || !video)
++        return STATUS_BUFFER_TOO_SMALL;
++
++    memset(video, 0, sizeof(*video));
++    video->dwSize = sizeof(*video);
++    video->guidFormat = *subtype;
++    video->videoInfo.dwWidth = (width + plane_align) & ~plane_align;
++    video->videoInfo.dwHeight = (height + plane_align) & ~plane_align;
++    if (video->videoInfo.dwWidth != width || video->videoInfo.dwHeight != height)
++    {
++        video->videoInfo.MinimumDisplayAperture.Area.cx = width;
++        video->videoInfo.MinimumDisplayAperture.Area.cy = height;
++    }
++    video->videoInfo.GeometricAperture = video->videoInfo.MinimumDisplayAperture;
++    video->videoInfo.PanScanAperture = video->videoInfo.MinimumDisplayAperture;
++    if (par.num > 0 && par.den > 0)
++    {
++        video->videoInfo.PixelAspectRatio.Numerator = par.num;
++        video->videoInfo.PixelAspectRatio.Denominator = par.den;
++    }
++    else
++    {
++        video->videoInfo.PixelAspectRatio.Numerator = 1;
++        video->videoInfo.PixelAspectRatio.Denominator = 1;
++    }
++    if (fps.num > 0 && fps.den > 0)
++    {
++        video->videoInfo.FramesPerSecond.Numerator = fps.num;
++        video->videoInfo.FramesPerSecond.Denominator = fps.den;
++    }
++    return STATUS_SUCCESS;
++}
