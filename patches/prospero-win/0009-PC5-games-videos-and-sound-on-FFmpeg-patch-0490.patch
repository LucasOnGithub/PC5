++/* ---- Connection ----------------------------------------------------------------- */
++
++static void close_input(struct wg_parser *parser)
++{
++    unsigned int i;
++
++    for (i = 0; i < parser->stream_count; ++i)
++        free_stream(parser->streams[i]);
++    free(parser->streams);
++    parser->streams = NULL;
++    parser->stream_count = 0;
