+-    if (!gst_structure_get_int(structure, "channels", &channels))
+-    {
+-        GST_WARNING("Missing \"channels\" value in %" GST_PTR_FORMAT ".", caps);
+-        return;
+-    }
+-    if (!gst_structure_get_int(structure, "rate", &rate))
+-    {
