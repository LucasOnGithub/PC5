++    if (size > sample->max_size)
++    {
++        size = sample->max_size - sample->max_size % block;
++        sample->flags |= WG_SAMPLE_FLAG_INCOMPLETE;
++    }
++    memcpy((BYTE *)(UINT_PTR)sample->data, transform->audio + transform->audio_offset, size);
++    sample->size = size;
++    sample->flags |= WG_SAMPLE_FLAG_SYNC_POINT;
++    if (transform->audio_has_pts)
++    {
++        sample->flags |= WG_SAMPLE_FLAG_HAS_PTS;
++        sample->pts = transform->audio_pts + av_rescale(transform->audio_offset / block, 10000000,
++                transform->output_rate);
++        if (transform->attrs.preserve_timestamps)
++            sample->flags |= WG_SAMPLE_FLAG_PRESERVE_TIMESTAMPS;
++    }
++    sample->flags |= WG_SAMPLE_FLAG_HAS_DURATION;
++    sample->duration = av_rescale(size / block, 10000000, transform->output_rate);
++
++    transform->audio_offset += size;
++    if (transform->audio_offset >= transform->audio_size)
++        clear_audio(transform);
++}
