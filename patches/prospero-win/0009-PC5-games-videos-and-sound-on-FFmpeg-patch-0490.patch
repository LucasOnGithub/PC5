++static bool convert_audio(struct wg_transform *transform, AVFrame *frame)
++{
++    INT64 pts = frame_time(frame);
++
++    clear_audio(transform);
++    if (!(transform->audio = wg_audio_convert(&transform->audio_converter, frame, transform->output_audio_format,
++            transform->output_channels, transform->output_mask, transform->output_rate, &transform->audio_size)))
++        return false;
++    transform->audio_offset = 0;
++
++    /* Frames without a time follow the last one that had one. */
++    if (pts != AV_NOPTS_VALUE)
++        transform->audio_pts = pts;
++    else
++        transform->audio_pts = transform->next_audio_pts;
++    transform->audio_has_pts = pts != AV_NOPTS_VALUE || transform->next_audio_pts_valid;
++    transform->next_audio_pts = transform->audio_pts + av_rescale(transform->audio_size
++            / (wg_audio_format_bytes(transform->output_audio_format) * transform->output_channels),
++            10000000, transform->output_rate);
++    transform->next_audio_pts_valid = transform->audio_has_pts;
++    return true;
++}
++
++static void read_audio(struct wg_transform *transform, struct wg_sample *sample)
++{
++    UINT32 block = wg_audio_format_bytes(transform->output_audio_format) * transform->output_channels;
++    size_t left = transform->audio_size - transform->audio_offset;
++    size_t size = left;
