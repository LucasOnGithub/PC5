++    TRACE("transform %p.\n", transform);
++    clear_input(transform);
++    clear_packets(&transform->packets);
++    clear_frames(&transform->frames);
++    clear_audio(transform);
++    wg_audio_converter_reset(&transform->audio_converter);
++    transform->next_audio_pts = transform->next_video_pts = 0;
++    transform->next_audio_pts_valid = true;
++    complete_drain(transform);
++    return STATUS_SUCCESS;
++}
