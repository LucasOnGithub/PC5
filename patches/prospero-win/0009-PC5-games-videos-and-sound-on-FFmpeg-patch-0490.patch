++AVCodecContext *wg_decoder_open(const AVCodecParameters *par, AVRational time_base, bool low_latency)
++{
++    const AVCodec *codec;
++    AVCodecContext *context;
++    int ret;
++
++    if (!(codec = avcodec_find_decoder(par->codec_id)))
++    {
++        WARN("No decoder for %s.\n", avcodec_get_name(par->codec_id));
++        return NULL;
++    }
++    if (!(context = avcodec_alloc_context3(codec)))
++        return NULL;
++    if (avcodec_parameters_to_context(context, par) < 0)
++    {
++        avcodec_free_context(&context);
++        return NULL;
++    }
++    context->pkt_timebase = time_base;
++    if (par->codec_type == AVMEDIA_TYPE_VIDEO)
++    {
++        context->thread_count = wg_thread_count();
++        context->thread_type = low_latency ? FF_THREAD_SLICE : FF_THREAD_FRAME | FF_THREAD_SLICE;
++        if (low_latency)
++            context->flags |= AV_CODEC_FLAG_LOW_DELAY;
++    }
++    else
++        context->thread_count = 1;
++
++    if ((ret = avcodec_open2(context, codec, NULL)) < 0)
++    {
++        wg_flush_log();
++        WARN("Cannot open the %s decoder, error %d.\n", codec->name, ret);
++        avcodec_free_context(&context);
++        return NULL;
++    }
++    return context;
++}
