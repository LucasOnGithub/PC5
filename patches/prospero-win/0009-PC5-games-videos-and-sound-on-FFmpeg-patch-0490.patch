++    struct wg_parser_stream *stream = get_stream(params->stream);
++    struct wg_parser *parser = stream->parser;
++    bool exact = !(params->start_flags & AM_SEEKING_SeekToKeyFrame);
++    unsigned int i;
++
++    TRACE("stream %u, rate %.16e, start %llu, stop %llu, flags %#x/%#x.\n", stream->number, params->rate,
++            (unsigned long long)params->start_pos, (unsigned long long)params->stop_pos,
++            (unsigned int)params->start_flags, (unsigned int)params->stop_flags);
