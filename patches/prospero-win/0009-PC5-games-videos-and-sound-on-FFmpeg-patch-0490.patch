++static bool pix_fmt_is_yuv(enum AVPixelFormat pix_fmt)
++{
++    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(pix_fmt);
++    return desc && !(desc->flags & (AV_PIX_FMT_FLAG_RGB | AV_PIX_FMT_FLAG_PAL)) && desc->nb_components >= 3;
++}
++
++static void flip_rows(BYTE *data, int stride, int rows, int bytes)
++{
++    BYTE row[16384], *top = data, *bottom = data + (ptrdiff_t)(rows - 1) * stride;
++    int done, chunk;
++
++    while (top < bottom)
++    {
++        for (done = 0; done < bytes; done += chunk)
++        {
++            chunk = min((int)sizeof(row), bytes - done);
++            memcpy(row, top + done, chunk);
++            memcpy(top + done, bottom + done, chunk);
++            memcpy(bottom + done, row, chunk);
++        }
++        top += stride;
++        bottom -= stride;
++    }
++}
++
++bool wg_video_convert(struct wg_video_converter *converter, const AVFrame *frame,
++        BYTE *data, const struct wg_video_layout *layout)
++{
++    uint8_t *planes[4] = {0};
++    int strides[4] = {0}, linesizes[4], i;
++
++    if (!converter->sws || converter->src_fmt != frame->format || converter->src_width != frame->width
++            || converter->src_height != frame->height || converter->dst_fmt != layout->pix_fmt
++            || converter->dst_width != layout->width || converter->dst_height != layout->height)
++    {
++        int src_range = frame->color_range == AVCOL_RANGE_JPEG || frame->format == AV_PIX_FMT_YUVJ420P
++                || frame->format == AV_PIX_FMT_YUVJ422P || frame->format == AV_PIX_FMT_YUVJ444P;
++        int colorspace = frame->colorspace;
++
++        sws_freeContext(converter->sws);
++        if (!(converter->sws = sws_getContext(frame->width, frame->height, frame->format,
++                layout->width, layout->height, layout->pix_fmt, SWS_BILINEAR, NULL, NULL, NULL)))
++        {
++            ERR("Cannot convert %s %dx%d to %s %dx%d.\n", av_get_pix_fmt_name(frame->format), frame->width,
++                    frame->height, av_get_pix_fmt_name(layout->pix_fmt), layout->width, layout->height);
++            converter->src_fmt = AV_PIX_FMT_NONE;
++            return false;
++        }
++        converter->src_fmt = frame->format;
++        converter->src_width = frame->width;
++        converter->src_height = frame->height;
++        converter->dst_fmt = layout->pix_fmt;
++        converter->dst_width = layout->width;
++        converter->dst_height = layout->height;
++
++        /* YUV to RGB with the frame's matrix: BT.709 for HD when it says none. */
++        if (pix_fmt_is_yuv(frame->format) && !pix_fmt_is_yuv(layout->pix_fmt))
++        {
++            if (colorspace == AVCOL_SPC_UNSPECIFIED || colorspace == AVCOL_SPC_RESERVED)
++                colorspace = frame->height >= 720 ? AVCOL_SPC_BT709 : AVCOL_SPC_BT470BG;
++            sws_setColorspaceDetails(converter->sws, sws_getCoefficients(colorspace), src_range,
++                    sws_getCoefficients(SWS_CS_DEFAULT), 1, 0, 1 << 16, 1 << 16);
++        }
++        else if (pix_fmt_is_yuv(frame->format) && src_range)
++        {
++            sws_setColorspaceDetails(converter->sws, sws_getCoefficients(SWS_CS_DEFAULT), 1,
++                    sws_getCoefficients(SWS_CS_DEFAULT), 0, 0, 1 << 16, 1 << 16);
++        }
++    }
++
++    for (i = 0; i < layout->planes; ++i)
++    {
++        strides[i] = abs(layout->stride[i]);
++        planes[i] = data + layout->offset[i];
++        if (layout->stride[i] < 0)
++            planes[i] += (ptrdiff_t)(layout->plane_height[i] - 1) * layout->stride[i];
++    }
++
++    if (sws_scale(converter->sws, (const uint8_t *const *)frame->data, frame->linesize, 0,
++            frame->height, planes, strides) <= 0)
++        return false;
++
++    if (av_image_fill_linesizes(linesizes, layout->pix_fmt, layout->width) < 0)
++        return true;
++    for (i = 0; i < layout->planes; ++i)
++        if (layout->stride[i] < 0)
++            flip_rows(planes[i], strides[i], layout->plane_height[i], linesizes[i]);
++    return true;
++}
++
++void wg_channel_layout_from_mask(AVChannelLayout *layout, UINT32 channels, UINT32 mask)
++{
++    av_channel_layout_uninit(layout);
++    /* The first 18 speaker bits of WAVEFORMATEXTENSIBLE are FFmpeg's. */
++    mask &= 0x3ffff;
++    if (mask && av_popcount(mask) == channels && !av_channel_layout_from_mask(layout, mask))
++        return;
++    av_channel_layout_default(layout, channels);
++}
++
++UINT32 wg_channel_mask_from_layout(const AVChannelLayout *layout)
++{
++    AVChannelLayout fallback = {0};
++    UINT32 mask;
++
++    if (layout->order == AV_CHANNEL_ORDER_NATIVE)
++        return layout->u.mask & 0x3ffff;
++    av_channel_layout_default(&fallback, layout->nb_channels);
++    mask = fallback.order == AV_CHANNEL_ORDER_NATIVE ? fallback.u.mask & 0x3ffff : 0;
++    av_channel_layout_uninit(&fallback);
++    return mask;
++}
