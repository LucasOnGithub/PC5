++static NTSTATUS read_video(struct wg_transform *transform, struct wg_sample *sample, AVFrame *frame)
++{
++    struct wg_video_layout layout;
++    INT64 pts = frame_time(frame);
++
++    if (!wg_video_layout_mf(&layout, transform->output_video_format, transform->output_width,
++            transform->output_height, transform->attrs.output_plane_align, sample->stride, &transform->output_info))
++    {
++        ERR("Cannot lay out a %dx%d frame.\n", transform->output_width, transform->output_height);
++        return STATUS_UNSUCCESSFUL;
++    }
++    if (sample->max_size < layout.size)
++    {
++        ERR("Output buffer of %u bytes is smaller than a frame of %zu.\n", sample->max_size, layout.size);
++        return STATUS_BUFFER_TOO_SMALL;
++    }
++    if (!wg_video_convert(&transform->video_converter, frame, (BYTE *)(UINT_PTR)sample->data, &layout))
++        return STATUS_UNSUCCESSFUL;
++
++    sample->size = layout.size;
++    /* A decoded frame stands on its own. */
++    sample->flags |= WG_SAMPLE_FLAG_SYNC_POINT;
++    /* Like GStreamer's decoders: the input's times, or times counted from
++     * zero for input without them; the input's duration, or none (zero). */
++    sample->flags |= WG_SAMPLE_FLAG_HAS_PTS | WG_SAMPLE_FLAG_HAS_DURATION;
++    if (pts != AV_NOPTS_VALUE)
++    {
++        sample->pts = pts;
++        if (transform->attrs.preserve_timestamps)
++            sample->flags |= WG_SAMPLE_FLAG_PRESERVE_TIMESTAMPS;
++    }
++    else
