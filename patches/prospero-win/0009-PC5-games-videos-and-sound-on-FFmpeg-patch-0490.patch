++static bool copy_codec_data(unsigned char *dst, uint32_t *len, size_t capacity, const BYTE *data, size_t size)
++{
++    if (size > capacity)
++    {
++        WARN("Codec data of %zu bytes does not fit.\n", size);
++        return false;
++    }
++    if (size)
++        memcpy(dst, data, size);
++    *len = size;
++    return true;
++}
