++    parser->seek_target = params->start_pos;
++    parser->seek_pending = true;
++    parser->started = true;
++    parser->eof = false;
++    for (i = 0; i < parser->stream_count; ++i)
++    {
++        struct wg_parser_stream *other = parser->streams[i];
++
++        clear_packets(other);
++        other->generation++;
++        other->eos = other->packets_eos = false;
++        other->discontinuity = true;
++        other->skip_until = exact && !other->compressed ? (INT64)params->start_pos : INT64_MIN;
++        if (other->bsf)
++            av_bsf_flush(other->bsf);
++        if (!other->decoding)
++            drop_unit(other);
++    }
++    pthread_cond_broadcast(&parser->cond);
++    pthread_mutex_unlock(&parser->mutex);
++    return S_OK;
++}
