++NTSTATUS wg_media_type_from_raw_audio(struct wg_media_type *media_type, wg_audio_format format,
++        UINT32 channels, UINT32 channel_mask, UINT32 rate)
++{
++    UINT32 capacity = media_type->format_size, depth = wg_audio_format_bytes(format) * 8;
++    bool is_float = format == WG_AUDIO_FORMAT_F32LE || format == WG_AUDIO_FORMAT_F64LE;
++    WAVEFORMATEXTENSIBLE *ext = (WAVEFORMATEXTENSIBLE *)media_type->u.audio;
++    bool extensible = !!channel_mask;
++
++    media_type->major = MFMediaType_Audio;
++    media_type->format_size = extensible ? sizeof(*ext) : sizeof(WAVEFORMATEX);
++    if (!depth)
++        return STATUS_UNSUCCESSFUL;
++    if (capacity < media_type->format_size || !ext)
++        return STATUS_BUFFER_TOO_SMALL;
++
++    memset(ext, 0, media_type->format_size);
++    ext->Format.wFormatTag = is_float ? WAVE_FORMAT_IEEE_FLOAT : WAVE_FORMAT_PCM;
++    ext->Format.nChannels = channels;
++    ext->Format.nSamplesPerSec = rate;
++    ext->Format.wBitsPerSample = depth;
++    ext->Format.nBlockAlign = depth * channels / 8;
++    ext->Format.nAvgBytesPerSec = rate * ext->Format.nBlockAlign;
++    if (extensible)
++    {
++        ext->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
++        ext->Format.cbSize = sizeof(*ext) - sizeof(WAVEFORMATEX);
++        ext->Samples.wValidBitsPerSample = 0;
++        ext->dwChannelMask = channel_mask;
++        ext->SubFormat = is_float ? MFAudioFormat_Float : MFAudioFormat_PCM;
++    }
++    return STATUS_SUCCESS;
++}
