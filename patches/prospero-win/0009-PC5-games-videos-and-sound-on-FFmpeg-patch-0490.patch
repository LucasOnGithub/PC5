+-        return;
+-    }
+-
+-    format->major_type = WG_MAJOR_TYPE_AUDIO_MPEG1;
+-    format->u.audio.layer = layer;
+-    format->u.audio.channels = channels;
+-    format->u.audio.rate = rate;
+-}
