++static AVFrame *frame_from_raw_video(struct wg_transform *transform, struct wg_sample *sample)
++{
++    struct wg_video_layout layout;
++    int linesizes[4], i;
++    AVFrame *frame;
++
++    if (!wg_video_layout_mf(&layout, transform->input_video_format, transform->input_width,
++            transform->input_height, 0, sample->stride, &transform->input_info))
++        return NULL;
++    if (layout.size > (sample->stride ? sample->max_size : sample->size))
++    {
++        ERR("Sample of %u bytes is smaller than a frame of %zu.\n", sample->size, layout.size);
++        return NULL;
++    }
++    if (!(frame = av_frame_alloc()))
++        return NULL;
++    frame->format = layout.pix_fmt;
++    frame->width = layout.width;
++    frame->height = layout.height;
++    if (av_frame_get_buffer(frame, 0) < 0 || av_image_fill_linesizes(linesizes, layout.pix_fmt, layout.width) < 0)
++    {
++        av_frame_free(&frame);
++        return NULL;
++    }
++    for (i = 0; i < layout.planes; ++i)
++        av_image_copy_plane(frame->data[i], frame->linesize[i], (BYTE *)(UINT_PTR)sample->data + layout.offset[i],
++                layout.stride[i], linesizes[i], layout.plane_height[i]);
++    return frame;
++}
++
++static AVFrame *frame_from_raw_audio(struct wg_transform *transform, struct wg_sample *sample)
++{
++    UINT32 bytes = wg_audio_format_bytes(transform->input_audio_format);
++    const BYTE *data = (const BYTE *)(UINT_PTR)sample->data;
++    UINT32 samples = sample->size / (bytes * transform->input_channels), i, total;
++    AVFrame *frame;
++
++    if (!samples || !(frame = av_frame_alloc()))
++        return NULL;
++    frame->format = wg_audio_format_to_av(transform->input_audio_format);
++    frame->sample_rate = transform->input_rate;
++    frame->nb_samples = samples;
++    wg_channel_layout_from_mask(&frame->ch_layout, transform->input_channels, transform->input_mask);
++    if (av_frame_get_buffer(frame, 0) < 0)
++    {
++        av_frame_free(&frame);
++        return NULL;
++    }
++    total = samples * transform->input_channels;
++    if (transform->input_audio_format == WG_AUDIO_FORMAT_S24LE)
++    {
++        int32_t *out = (int32_t *)frame->data[0];
++        for (i = 0; i < total; ++i)
++            out[i] = (int32_t)((UINT32)data[i * 3] << 8 | (UINT32)data[i * 3 + 1] << 16 | (UINT32)data[i * 3 + 2] << 24);
++    }
++    else
++        memcpy(frame->data[0], data, (size_t)total * bytes);
++    return frame;
++}
++
++NTSTATUS wg_transform_push_data(void *args)
++{
++    struct wg_transform_push_data_params *params = args;
++    struct wg_transform *transform = get_transform(params->transform);
++    struct wg_sample *sample = params->sample;
++
++    if (transform->draining)
++    {
++        TRACE("Refusing %u bytes, the transform is draining.\n", sample->size);
++        params->result = MF_E_NOTACCEPTING;
++        return STATUS_SUCCESS;
++    }
++    if (transform->input.count >= transform->attrs.input_queue_length + 1)
++    {
++        TRACE("Refusing %u bytes, %u samples already queued.\n", sample->size, transform->input.count);
++        params->result = MF_E_NOTACCEPTING;
++        return STATUS_SUCCESS;
++    }
++
++    /* Like a GStreamer buffer wrapping it, the sample stays the caller's
++     * until it is decoded (or converted): it is held until then. */
++    InterlockedIncrement(&sample->refcount);
++    if (!fifo_push(&transform->input, sample))
++    {
++        InterlockedDecrement(&sample->refcount);
++        return STATUS_NO_MEMORY;
++    }
