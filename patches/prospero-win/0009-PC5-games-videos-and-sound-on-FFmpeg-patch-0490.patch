++        layout->stride[0] = ALIGN(width * 3, 4);
++        layout->size = (size_t)layout->stride[0] * height;
++        return true;
++    case WG_VIDEO_FORMAT_RGB15:
++    case WG_VIDEO_FORMAT_RGB16:
++    case WG_VIDEO_FORMAT_UYVY:
++    case WG_VIDEO_FORMAT_YUY2:
++    case WG_VIDEO_FORMAT_YVYU:
++        layout->stride[0] = ALIGN(width * 2, 4);
++        layout->size = (size_t)layout->stride[0] * height;
++        return true;
++    case WG_VIDEO_FORMAT_I420:
++    case WG_VIDEO_FORMAT_YV12:
++        layout->planes = 3;
++        layout->stride[0] = ALIGN(width, 4);
++        layout->stride[1] = layout->stride[2] = ALIGN(ALIGN(width, 2) / 2, 4);
++        layout->offset[1] = (ptrdiff_t)layout->stride[0] * rows;
++        layout->offset[2] = layout->offset[1] + (ptrdiff_t)layout->stride[1] * (rows / 2);
++        layout->size = layout->offset[2] + (size_t)layout->stride[2] * (rows / 2);
++        return true;
++    case WG_VIDEO_FORMAT_NV12:
++        layout->planes = 2;
++        layout->stride[0] = layout->stride[1] = ALIGN(width, 4);
++        layout->offset[1] = (ptrdiff_t)layout->stride[0] * rows;
++        layout->size = layout->offset[1] + (size_t)layout->stride[1] * (rows / 2);
++        return true;
++    case WG_VIDEO_FORMAT_P010_10LE:
++        layout->planes = 2;
++        layout->stride[0] = layout->stride[1] = ALIGN(width * 2, 4);
++        layout->offset[1] = (ptrdiff_t)layout->stride[0] * rows;
++        layout->size = layout->offset[1] + (size_t)layout->stride[1] * (rows / 2);
++        return true;
++    default:
++        return false;
++    }
++}
++
++static int plane_pixel_bytes(wg_video_format format, int plane)
++{
++    switch (format)
++    {
++    case WG_VIDEO_FORMAT_BGRA:
++    case WG_VIDEO_FORMAT_BGRx:
++    case WG_VIDEO_FORMAT_RGBA:
++    case WG_VIDEO_FORMAT_AYUV:      return 4;
++    case WG_VIDEO_FORMAT_BGR:       return 3;
++    case WG_VIDEO_FORMAT_RGB15:
++    case WG_VIDEO_FORMAT_RGB16:
++    case WG_VIDEO_FORMAT_UYVY:
++    case WG_VIDEO_FORMAT_YUY2:
++    case WG_VIDEO_FORMAT_YVYU:      return 2;
++    case WG_VIDEO_FORMAT_NV12:      return plane ? 2 : 1;
++    case WG_VIDEO_FORMAT_P010_10LE: return plane ? 4 : 2;
++    default:                        return 1;
++    }
++}
++
++static void finish_layout(struct wg_video_layout *layout, wg_video_format format, int width, int height,
++        bool bottom_up)
++{
++    ptrdiff_t offset;
++    int i;
++
++    layout->pix_fmt = wg_video_format_to_av(format, &layout->swap_uv);
++    layout->width = width;
++    layout->height = height;
++    for (i = 0; i < 4; ++i)
++        layout->plane_height[i] = (i && format_is_420(format)) ? (height + 1) / 2 : (i < layout->planes ? height : 0);
++
++    /* YV12 is V before U: give FFmpeg's U the third plane. */
++    if (layout->swap_uv)
++    {
++        offset = layout->offset[1];
++        layout->offset[1] = layout->offset[2];
++        layout->offset[2] = offset;
++    }
++
++    if (bottom_up)
++    {
++        for (i = 0; i < layout->planes; ++i)
++        {
++            layout->offset[i] += (ptrdiff_t)(layout->plane_height[i] - 1) * layout->stride[i];
++            layout->stride[i] = -layout->stride[i];
++        }
++    }
++}
++
++bool wg_video_layout_default(struct wg_video_layout *layout, wg_video_format format,
++        int width, int height, bool bottom_up)
++{
++    if (width <= 0 || height <= 0 || !fill_planes(layout, format, width, height))
++        return false;
++    finish_layout(layout, format, width, height, bottom_up);
++    return true;
++}
++
++bool wg_video_layout_mf(struct wg_video_layout *layout, wg_video_format format, int width, int height,
++        UINT32 plane_align, INT32 stride, const MFVideoInfo *info)
++{
++    const MFVideoArea *aperture = &info->MinimumDisplayAperture;
++    bool fix_nv12 = !plane_align && format == WG_VIDEO_FORMAT_NV12 && (width & 3) && (width & 3) != 3;
++    bool bottom_up = !!(info->VideoFlags & MFVideoFlag_BottomUpLinearRep);
++    int left = 0, top = 0, right, bottom, padded_width, padded_height, i, tmp;
++
++    if (width <= 0 || height <= 0)
++        return false;
++
++    right = ((plane_align + 1) - (width & plane_align)) & plane_align;
++    bottom = ((plane_align + 1) - (height & plane_align)) & plane_align;
++
++    if (aperture->OffsetX.value || aperture->OffsetY.value || aperture->Area.cx || aperture->Area.cy)
++    {
++        right = max(right, (int)info->dwWidth - aperture->OffsetX.value - (int)aperture->Area.cx);
++        bottom = max(bottom, (int)info->dwHeight - aperture->OffsetY.value - (int)aperture->Area.cy);
++        left = max(0, aperture->OffsetX.value);
++        top = max(0, aperture->OffsetY.value);
++    }
++
++    if (stride)
++    {
++        /* A 2D buffer: its pitch is the plane's stride. */
++        int pixel = plane_pixel_bytes(format, 0), pitch = abs(stride);
++
++        bottom_up = stride < 0;
++        if (pitch % pixel)
++            WARN("Stride %d is not a whole number of pixels.\n", pitch);
++        pitch /= pixel;
++        if (pitch < left + width + right)
++            WARN("Stride %d is smaller than the frame.\n", stride);
++        else
++            right += pitch - (left + width + right);
++    }
++
++    if (bottom_up)
++    {
++        tmp = top;
++        top = bottom;
++        bottom = tmp;
++    }
++
++    if (fix_nv12 && !left && !top && !right && !bottom)
++    {
++        /* NV12's rows need only be 2-aligned, as Windows has them. */
++        int rows = ALIGN(height, 2);
++
++        memset(layout->offset, 0, sizeof(layout->offset));
++        memset(layout->stride, 0, sizeof(layout->stride));
++        layout->planes = 2;
++        layout->stride[0] = layout->stride[1] = ALIGN(width, 2);
++        layout->offset[1] = (ptrdiff_t)layout->stride[0] * rows;
++        layout->size = layout->offset[1] + (size_t)layout->stride[0] * rows / 2;
++        finish_layout(layout, format, width, height, bottom_up);
++        return true;
++    }
++
++    padded_width = left + width + right;
++    padded_height = top + height + bottom;
++    if (!fill_planes(layout, format, padded_width, padded_height))
++        return false;
++    /* The first plane's rows are aligned to plane_align + 1 bytes. */
++    while (plane_align && (layout->stride[0] & plane_align))
++        fill_planes(layout, format, ++padded_width, padded_height);
++
++    for (i = 0; i < layout->planes; ++i)
++    {
++        bool chroma = i && format_is_420(format);
++        int rows = chroma ? top / 2 : top;
++        int columns = (i && format_is_420(format)) ? left / 2 : left;
++
++        layout->offset[i] += (ptrdiff_t)rows * layout->stride[i] + columns * plane_pixel_bytes(format, i);
++    }
++
++    finish_layout(layout, format, width, height, bottom_up);
++    return true;
++}
