+-    if (stream->buffer)
+-    {
+-        gst_buffer_unmap(stream->buffer, &stream->map_info);
+-        gst_buffer_unref(stream->buffer);
+-        stream->buffer = NULL;
+-    }
+-
+-    stream->get_buffer_called = false;
+-
+-    pthread_mutex_unlock(&parser->mutex);
+-    pthread_cond_signal(&stream->event_empty_cond);
+-
+-    return S_OK;
+-}
