+-    wg_format_from_caps(&format, caps);
+-
+-    return format.major_type != WG_MAJOR_TYPE_UNKNOWN
+-            && format.major_type != WG_MAJOR_TYPE_VIDEO
+-            && format.major_type != WG_MAJOR_TYPE_AUDIO;
+-}
