++static bool extradata_is_annexb(const AVCodecParameters *par)
++{
++    return par->extradata_size >= 4 && !par->extradata[0] && !par->extradata[1]
++            && (par->extradata[2] == 1 || (!par->extradata[2] && par->extradata[3] == 1));
++}
++
++bool wg_format_from_codec(struct wg_format *format, const AVCodecParameters *par, AVRational fps)
++{
++    memset(format, 0, sizeof(*format));
++
++    if (par->codec_type == AVMEDIA_TYPE_AUDIO)
++    {
++        format->u.audio.channels = par->ch_layout.nb_channels;
++        format->u.audio.rate = par->sample_rate;
++
++        switch (par->codec_id)
++        {
++        case AV_CODEC_ID_MP1:
++        case AV_CODEC_ID_MP2:
++        case AV_CODEC_ID_MP3:
++            format->major_type = WG_MAJOR_TYPE_AUDIO_MPEG1;
++            format->u.audio.layer = par->codec_id == AV_CODEC_ID_MP1 ? 1 : par->codec_id == AV_CODEC_ID_MP2 ? 2 : 3;
++            return true;
++        case AV_CODEC_ID_AAC:
++        {
++            static const size_t info_size = sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX);
++            HEAACWAVEINFO info = {0};
++
++            /* Raw frames with their AudioSpecificConfig, as the frontends describe them. */
++            if (!par->extradata_size || par->extradata_size + info_size > sizeof(format->u.audio.codec_data))
++                return false;
++            format->major_type = WG_MAJOR_TYPE_AUDIO_MPEG4;
++            format->u.audio.payload_type = 0;
++            memcpy(format->u.audio.codec_data, &info.wPayloadType, info_size);
++            memcpy(format->u.audio.codec_data + info_size, par->extradata, par->extradata_size);
++            format->u.audio.codec_data_len = info_size + par->extradata_size;
++            return true;
++        }
++        case AV_CODEC_ID_WMAV1:
++        case AV_CODEC_ID_WMAV2:
++        case AV_CODEC_ID_WMAPRO:
++        case AV_CODEC_ID_WMALOSSLESS:
++            format->major_type = WG_MAJOR_TYPE_AUDIO_WMA;
++            format->u.audio.version = par->codec_id == AV_CODEC_ID_WMAV1 ? 1 : par->codec_id == AV_CODEC_ID_WMAV2 ? 2
++                    : par->codec_id == AV_CODEC_ID_WMAPRO ? 3 : 4;
++            format->u.audio.bitrate = par->bit_rate;
++            format->u.audio.depth = par->bits_per_coded_sample ? par->bits_per_coded_sample : 16;
++            format->u.audio.block_align = par->block_align;
++            return copy_codec_data(format->u.audio.codec_data, &format->u.audio.codec_data_len,
++                    sizeof(format->u.audio.codec_data), par->extradata, par->extradata_size);
++        default:
++            return false;
++        }
++    }
++
++    if (par->codec_type == AVMEDIA_TYPE_VIDEO)
++    {
++        format->u.video.width = par->width;
++        format->u.video.height = par->height;
++        format->u.video.fps_n = fps.num > 0 && fps.den > 0 ? fps.num : 0;
++        format->u.video.fps_d = fps.num > 0 && fps.den > 0 ? fps.den : 1;
++
++        switch (par->codec_id)
++        {
++        case AV_CODEC_ID_H264:
++            format->major_type = WG_MAJOR_TYPE_VIDEO_H264;
++            switch (par->profile)
++            {
++            case AV_PROFILE_H264_BASELINE:
++            case AV_PROFILE_H264_CONSTRAINED_BASELINE: format->u.video.profile = eAVEncH264VProfile_Base; break;
++            case AV_PROFILE_H264_MAIN:     format->u.video.profile = eAVEncH264VProfile_Main; break;
++            case AV_PROFILE_H264_EXTENDED: format->u.video.profile = eAVEncH264VProfile_Extended; break;
++            case AV_PROFILE_H264_HIGH_444:
++            case AV_PROFILE_H264_HIGH_444_PREDICTIVE: format->u.video.profile = eAVEncH264VProfile_444; break;
++            default:                       format->u.video.profile = eAVEncH264VProfile_High; break;
++            }
++            format->u.video.level = par->level > 0 ? par->level : eAVEncH264VLevel4;
++            /* The stream is given as a byte stream; its own headers are only kept when they are one. */
++            if (extradata_is_annexb(par))
++                copy_codec_data(format->u.video.codec_data, &format->u.video.codec_data_len,
++                        sizeof(format->u.video.codec_data), par->extradata, par->extradata_size);
++            return true;
++        case AV_CODEC_ID_WMV1:
++        case AV_CODEC_ID_WMV2:
++        case AV_CODEC_ID_WMV3:
++        case AV_CODEC_ID_VC1:
++            format->major_type = WG_MAJOR_TYPE_VIDEO_WMV;
++            if (par->codec_id == AV_CODEC_ID_WMV1) format->u.video.format = WG_VIDEO_FORMAT_WMV1;
++            else if (par->codec_id == AV_CODEC_ID_WMV2) format->u.video.format = WG_VIDEO_FORMAT_WMV2;
++            else if (par->codec_id == AV_CODEC_ID_WMV3) format->u.video.format = WG_VIDEO_FORMAT_WMV3;
++            else if (par->codec_tag == MAKEFOURCC('W','M','V','A')) format->u.video.format = WG_VIDEO_FORMAT_WMVA;
++            else format->u.video.format = WG_VIDEO_FORMAT_WVC1;
++            return copy_codec_data(format->u.video.codec_data, &format->u.video.codec_data_len,
++                    sizeof(format->u.video.codec_data), par->extradata, par->extradata_size);
++        case AV_CODEC_ID_MPEG1VIDEO:
++            if (!par->extradata_size)
++                return false;
++            format->major_type = WG_MAJOR_TYPE_VIDEO_MPEG1;
++            copy_codec_data(format->u.video.codec_data, &format->u.video.codec_data_len,
++                    sizeof(format->u.video.codec_data), par->extradata,
++                    min(par->extradata_size, sizeof(format->u.video.codec_data)));
++            return true;
++        case AV_CODEC_ID_CINEPAK:
++            format->major_type = WG_MAJOR_TYPE_VIDEO_CINEPAK;
++            return true;
++        case AV_CODEC_ID_INDEO5:
++            format->major_type = WG_MAJOR_TYPE_VIDEO_INDEO;
++            format->u.video.version = 5;
++            return true;
++        default:
++            return false;
++        }
++    }
++
++    return false;
++}
