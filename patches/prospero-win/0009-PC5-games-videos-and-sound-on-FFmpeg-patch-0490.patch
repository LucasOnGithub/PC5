++/* FFmpeg logs from its own threads too, which have no Wine TEB and so cannot
++ * use Wine's debug channels: its messages wait here until a Wine thread
++ * calls in (wg_flush_log). */
++static pthread_mutex_t log_lock = PTHREAD_MUTEX_INITIALIZER;
++static char log_lines[8][256];
++static unsigned int log_count, log_dropped;
++static int log_level = AV_LOG_ERROR;
++
++static void log_callback(void *ctx, int level, const char *format, va_list args)
++{
++    char line[256];
++    size_t length;
++
++    if (level > log_level)
++        return;
++    vsnprintf(line, sizeof(line), format, args);
++    if ((length = strlen(line)) && line[length - 1] == '\n')
++        line[length - 1] = 0;
++    if (!line[0])
++        return;
++
++    pthread_mutex_lock(&log_lock);
++    if (log_count < ARRAY_SIZE(log_lines))
++        strcpy(log_lines[log_count++], line);
++    else
++        log_dropped++;
++    pthread_mutex_unlock(&log_lock);
++}
++
++void wg_flush_log(void)
++{
++    char lines[ARRAY_SIZE(log_lines)][256];
++    unsigned int count, dropped, i;
++
++    if (!log_count)
++        return;
++    pthread_mutex_lock(&log_lock);
++    count = log_count;
++    dropped = log_dropped;
++    memcpy(lines, log_lines, count * sizeof(lines[0]));
++    log_count = log_dropped = 0;
++    pthread_mutex_unlock(&log_lock);
++
++    for (i = 0; i < count; ++i)
++        WARN("FFmpeg: %s\n", lines[i]);
++    if (dropped)
++        WARN("FFmpeg: %u more messages.\n", dropped);
++}
