++            || frame->width != transform->output_width || frame->height != transform->output_height))
++    {
++        /* The decoder has told the frames' size: the caller reads the new type first. */
++        TRACE("Frames are %dx%d.\n", frame->width, frame->height);
++        transform->output_width = frame->width;
++        transform->output_height = frame->height;
++        if (frame->sample_aspect_ratio.num > 0 && frame->sample_aspect_ratio.den > 0)
++            transform->aspect = frame->sample_aspect_ratio;
++        transform->frame_seen = true;
++        transform->format_changed = false;
++        sample->size = 0;
++        params->result = MF_E_TRANSFORM_STREAM_CHANGE;
++        return STATUS_SUCCESS;
++    }
++    transform->frame_seen = true;
++
++    if ((status = read_video(transform, sample, frame)))
++    {
++        sample->size = 0;
++        return status;
++    }
++    fifo_pop(&transform->frames);
++    av_frame_free(&frame);
++    params->result = S_OK;
++    return STATUS_SUCCESS;
++}
++
++NTSTATUS wg_transform_get_status(void *args)
++{
++    struct wg_transform_get_status_params *params = args;
++    struct wg_transform *transform = get_transform(params->transform);
++
++    params->accepts_input = transform->input.count < transform->attrs.input_queue_length + 1;
++    return STATUS_SUCCESS;
++}
++
++NTSTATUS wg_transform_drain(void *args)
++{
++    struct wg_transform *transform = get_transform(*(wg_transform_t *)args);
++
++    TRACE("transform %p, draining %u samples.\n", transform, transform->input.count);
++    transform->draining = true;
++    /* With nothing queued, what the decoder holds becomes readable now. */
++    if (!transform->input.count)
++        decode_frames(transform, true);
++    return STATUS_SUCCESS;
++}
++
++NTSTATUS wg_transform_flush(void *args)
++{
++    struct wg_transform *transform = get_transform(*(wg_transform_t *)args);
