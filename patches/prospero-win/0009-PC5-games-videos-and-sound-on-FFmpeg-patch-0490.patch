++/* ---- Media Foundation types ----------------------------------------------------- */
++
++static bool wave_format_tag(const WAVEFORMATEX *wfx, UINT32 format_size, UINT32 *tag, UINT32 *mask,
++        const BYTE **extra, UINT32 *extra_size)
++{
++    if (format_size < sizeof(WAVEFORMATEX))
++        return false;
++    *mask = 0;
++    *tag = wfx->wFormatTag;
++    *extra = (const BYTE *)(wfx + 1);
++    *extra_size = min(wfx->cbSize, format_size - sizeof(WAVEFORMATEX));
++    if (wfx->wFormatTag == WAVE_FORMAT_EXTENSIBLE)
++    {
++        const WAVEFORMATEXTENSIBLE *ext = (const WAVEFORMATEXTENSIBLE *)wfx;
++        UINT32 size = sizeof(WAVEFORMATEX) + wfx->cbSize;
++
++        if (size < sizeof(*ext) || format_size < sizeof(*ext))
++            return false;
++        *tag = ext->SubFormat.Data1;
++        *mask = ext->dwChannelMask;
++        *extra = (const BYTE *)(ext + 1);
++        *extra_size = min(size, format_size) - sizeof(*ext);
++    }
++    return true;
++}
++
++bool wg_media_type_is_raw(const struct wg_media_type *media_type)
++{
++    if (IsEqualGUID(&media_type->major, &MFMediaType_Audio))
++    {
++        const BYTE *extra;
++        UINT32 tag, mask, size;
++
++        return wave_format_tag(media_type->u.audio, media_type->format_size, &tag, &mask, &extra, &size)
++                && (tag == WAVE_FORMAT_PCM || tag == WAVE_FORMAT_IEEE_FLOAT);
++    }
++    if (IsEqualGUID(&media_type->major, &MFMediaType_Video))
++        return media_type->format_size >= sizeof(MFVIDEOFORMAT)
++                && wg_video_format_from_subtype(&media_type->u.video->guidFormat) != WG_VIDEO_FORMAT_UNKNOWN;
++    return false;
++}
