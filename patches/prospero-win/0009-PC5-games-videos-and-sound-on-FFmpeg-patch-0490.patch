++static bool audio_from_type(const struct wg_media_type *type, wg_audio_format *format,
++        UINT32 *channels, UINT32 *mask, UINT32 *rate)
++{
++    const WAVEFORMATEX *wfx = type->u.audio;
++    bool is_float;
++    UINT32 tag;
++
++    if (type->format_size < sizeof(*wfx))
++        return false;
++    tag = wfx->wFormatTag;
++    *mask = 0;
++    if (tag == WAVE_FORMAT_EXTENSIBLE && type->format_size >= sizeof(WAVEFORMATEXTENSIBLE))
++    {
++        const WAVEFORMATEXTENSIBLE *ext = (const WAVEFORMATEXTENSIBLE *)wfx;
++        tag = ext->SubFormat.Data1;
++        *mask = ext->dwChannelMask;
++    }
++    is_float = tag == WAVE_FORMAT_IEEE_FLOAT;
++    if (tag != WAVE_FORMAT_PCM && !is_float)
++        return false;
++
++    switch (wfx->wBitsPerSample)
++    {
++    case 8:  *format = is_float ? WG_AUDIO_FORMAT_UNKNOWN : WG_AUDIO_FORMAT_U8; break;
++    case 16: *format = is_float ? WG_AUDIO_FORMAT_UNKNOWN : WG_AUDIO_FORMAT_S16LE; break;
++    case 24: *format = is_float ? WG_AUDIO_FORMAT_UNKNOWN : WG_AUDIO_FORMAT_S24LE; break;
++    case 32: *format = is_float ? WG_AUDIO_FORMAT_F32LE : WG_AUDIO_FORMAT_S32LE; break;
++    case 64: *format = is_float ? WG_AUDIO_FORMAT_F64LE : WG_AUDIO_FORMAT_UNKNOWN; break;
++    default: *format = WG_AUDIO_FORMAT_UNKNOWN; break;
++    }
++    *channels = wfx->nChannels;
++    *rate = wfx->nSamplesPerSec;
++    return *format != WG_AUDIO_FORMAT_UNKNOWN && *channels && *rate;
++}
