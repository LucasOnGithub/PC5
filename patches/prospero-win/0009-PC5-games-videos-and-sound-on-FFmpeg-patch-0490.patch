++    par->codec_type = AVMEDIA_TYPE_VIDEO;
++    par->width = format->videoInfo.dwWidth;
++    par->height = format->videoInfo.dwHeight;
++    if (format->videoInfo.MinimumDisplayAperture.Area.cx && format->videoInfo.MinimumDisplayAperture.Area.cy)
++    {
++        par->width = format->videoInfo.MinimumDisplayAperture.Area.cx;
++        par->height = format->videoInfo.MinimumDisplayAperture.Area.cy;
++    }
++    if (format->videoInfo.FramesPerSecond.Numerator && format->videoInfo.FramesPerSecond.Denominator)
++        par->framerate = (AVRational){format->videoInfo.FramesPerSecond.Numerator,
++                format->videoInfo.FramesPerSecond.Denominator};
++    if (format->videoInfo.PixelAspectRatio.Numerator && format->videoInfo.PixelAspectRatio.Denominator)
++        par->sample_aspect_ratio = (AVRational){format->videoInfo.PixelAspectRatio.Numerator,
++                format->videoInfo.PixelAspectRatio.Denominator};
++
++    if (IsEqualGUID(subtype, &MEDIASUBTYPE_MPEG1Payload) || IsEqualGUID(subtype, &MEDIASUBTYPE_MPEG1Packet)
++            || IsEqualGUID(subtype, &MEDIASUBTYPE_MPEG2_VIDEO))
++    {
++        const struct mpeg_video_format *mpeg = (const struct mpeg_video_format *)format;
++
++        par->codec_id = IsEqualGUID(subtype, &MEDIASUBTYPE_MPEG2_VIDEO) ? AV_CODEC_ID_MPEG2VIDEO : AV_CODEC_ID_MPEG1VIDEO;
++        if (format_size < sizeof(*mpeg) || format_size - sizeof(*mpeg) < mpeg->sequence_header_count)
++            return set_extradata(par, NULL, 0);
++        return set_extradata(par, mpeg->sequence_header, mpeg->sequence_header_count);
++    }
++    if (IsEqualGUID(subtype, &MFVideoFormat_H264_ES))
++        fourcc = MAKEFOURCC('H','2','6','4');
++    else
