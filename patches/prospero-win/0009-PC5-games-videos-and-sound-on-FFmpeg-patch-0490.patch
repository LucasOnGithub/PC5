++/* A first-in first-out list of pointers. */
++struct fifo
++{
++    void **items;
++    unsigned int head, count, capacity;
++};
++
++static inline bool fifo_push(struct fifo *fifo, void *item)
++{
++    if (fifo->count == fifo->capacity)
++    {
++        unsigned int capacity = max(8, fifo->capacity * 2), i;
++        void **items;
++
++        if (!(items = malloc(capacity * sizeof(*items))))
++            return false;
++        for (i = 0; i < fifo->count; ++i)
++            items[i] = fifo->items[(fifo->head + i) % fifo->capacity];
++        free(fifo->items);
++        fifo->items = items;
++        fifo->head = 0;
++        fifo->capacity = capacity;
++    }
++    fifo->items[(fifo->head + fifo->count++) % fifo->capacity] = item;
++    return true;
++}
++
++static inline void *fifo_peek(struct fifo *fifo)
++{
++    return fifo->count ? fifo->items[fifo->head] : NULL;
++}
++
++static inline void *fifo_pop(struct fifo *fifo)
++{
++    void *item;
++
++    if (!fifo->count)
++        return NULL;
++    item = fifo->items[fifo->head];
++    fifo->head = (fifo->head + 1) % fifo->capacity;
++    fifo->count--;
++    return item;
++}
