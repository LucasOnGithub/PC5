++    parser->stop_pos = INT64_MAX;
++    parser->has_base_pts = false;
++    pthread_mutex_unlock(&parser->mutex);
++
++    if (!(io_buffer = av_malloc(IO_BUFFER_SIZE)))
++        goto fail;
++    if (!(parser->io = avio_alloc_context(io_buffer, IO_BUFFER_SIZE, 0, parser, io_read, NULL, io_seek)))
++    {
++        av_free(io_buffer);
++        goto fail;
++    }
++    if (!(parser->format = avformat_alloc_context()))
++        goto fail;
++    parser->format->pb = parser->io;
++
++    if ((ret = avformat_open_input(&parser->format, parser->uri ? parser->uri : "", NULL, NULL)) < 0)
++    {
++        wg_flush_log();
++        WARN("No demuxer for %s, error %d.\n", debugstr_a(parser->uri), ret);
++        goto fail;
++    }
++    if ((ret = avformat_find_stream_info(parser->format, NULL)) < 0)
++        WARN("Could not read the streams' parameters, error %d.\n", ret);
++    TRACE("Demuxing %s (%s).\n", parser->format->iformat->name, debugstr_a(parser->uri));
++
++    if (parser->format->start_time != AV_NOPTS_VALUE && parser->format->start_time > 0)
++        parser->start_offset = av_rescale_q(parser->format->start_time, AV_TIME_BASE_Q, WG_TIME_BASE);
++    else
++        parser->start_offset = 0;
++
++    /* One duration for every stream, as GStreamer's demuxers answered: the
++     * longest stream's, or the file's when no stream has one. */
++    parser->duration = 0;
++    for (i = 0; i < parser->format->nb_streams; ++i)
++    {
++        AVStream *av = parser->format->streams[i];
++
++        if ((av->codecpar->codec_type == AVMEDIA_TYPE_VIDEO || av->codecpar->codec_type == AVMEDIA_TYPE_AUDIO)
++                && av->duration != AV_NOPTS_VALUE && av->duration > 0)
++            parser->duration = max(parser->duration, (UINT64)av_rescale_q(av->duration, av->time_base, WG_TIME_BASE));
++    }
++    if (!parser->duration && parser->format->duration != AV_NOPTS_VALUE && parser->format->duration > 0)
++        parser->duration = av_rescale_q(parser->format->duration, AV_TIME_BASE_Q, WG_TIME_BASE);
++
++    if (!(parser->by_index = calloc(parser->format->nb_streams, sizeof(*parser->by_index)))
++            || !(parser->streams = calloc(parser->format->nb_streams, sizeof(*parser->streams))))
++        goto fail;
++    parser->index_count = parser->format->nb_streams;
++    for (i = 0; i < parser->format->nb_streams; ++i)
++    {
++        AVStream *av = parser->format->streams[i];
++        struct wg_parser_stream *stream;
++
++        if ((av->codecpar->codec_type != AVMEDIA_TYPE_VIDEO && av->codecpar->codec_type != AVMEDIA_TYPE_AUDIO)
++                || (av->disposition & AV_DISPOSITION_ATTACHED_PIC) || !(stream = create_stream(parser, av)))
++        {
++            av->discard = AVDISCARD_ALL;
++            continue;
++        }
++        parser->by_index[i] = stream;
++        parser->streams[parser->stream_count++] = stream;
++    }
++    wg_flush_log();
++    if (!parser->stream_count)
++    {
++        WARN("No stream can be played.\n");
++        goto fail;
++    }
++
++    pthread_attr_init(&attr);
++    pthread_attr_setstacksize(&attr, 1 << 20);
++    ret = pthread_create(&parser->thread, &attr, demuxer_thread, parser);
++    pthread_attr_destroy(&attr);
++    if (ret)
++        goto fail;
++    parser->thread_running = true;
++    return S_OK;
++
++fail:
++    close_input(parser);
++    pthread_mutex_lock(&parser->mutex);
++    parser->sink_connected = false;
++    pthread_cond_broadcast(&parser->read_cond);
++    pthread_mutex_unlock(&parser->mutex);
++    return E_FAIL;
++}
