++static bool video_size_from_info(const MFVideoInfo *info, int *width, int *height)
++{
++    const MFVideoArea *aperture = &info->MinimumDisplayAperture;
++
++    if (aperture->Area.cx && aperture->Area.cy)
++    {
++        *width = aperture->Area.cx;
++        *height = aperture->Area.cy;
++    }
++    else
++    {
++        *width = info->dwWidth;
++        *height = info->dwHeight;
++    }
++    return *width > 0 && *height > 0;
++}
