++static bool set_extradata(AVCodecParameters *par, const BYTE *data, size_t size)
++{
++    av_freep(&par->extradata);
++    par->extradata_size = 0;
++    if (!size)
++        return true;
++    if (!(par->extradata = av_mallocz(size + AV_INPUT_BUFFER_PADDING_SIZE)))
++        return false;
++    memcpy(par->extradata, data, size);
++    par->extradata_size = size;
++    return true;
++}
++
++static bool audio_type_to_codec(const WAVEFORMATEX *wfx, UINT32 format_size, AVCodecParameters *par)
++{
++    const BYTE *extra;
++    UINT32 tag, mask, extra_size;
++
++    if (!wave_format_tag(wfx, format_size, &tag, &mask, &extra, &extra_size))
++        return false;
++
++    par->codec_type = AVMEDIA_TYPE_AUDIO;
++    par->codec_tag = tag;
++    par->sample_rate = wfx->nSamplesPerSec;
++    par->block_align = wfx->nBlockAlign;
++    par->bit_rate = (int64_t)wfx->nAvgBytesPerSec * 8;
++    par->bits_per_coded_sample = wfx->wBitsPerSample;
++    wg_channel_layout_from_mask(&par->ch_layout, wfx->nChannels ? wfx->nChannels : 2, mask);
++
++    switch (tag)
++    {
++    case WAVE_FORMAT_MPEG:
++    {
++        const MPEG1WAVEFORMAT *mpeg = (const MPEG1WAVEFORMAT *)wfx;
++        par->codec_id = format_size >= sizeof(*mpeg) && mpeg->fwHeadLayer == ACM_MPEG_LAYER3
++                ? AV_CODEC_ID_MP3 : AV_CODEC_ID_MP2;
++        return true;
++    }
++    case WAVE_FORMAT_MPEGLAYER3:
++        par->codec_id = AV_CODEC_ID_MP3;
++        return true;
++    case WAVE_FORMAT_MPEG_HEAAC:
++    {
++        const HEAACWAVEINFO *info = (const HEAACWAVEINFO *)wfx;
++        UINT32 size = sizeof(WAVEFORMATEX) + wfx->cbSize;
++
++        if (format_size < sizeof(*info) || size < sizeof(*info))
++            return false;
++        size = min(size, format_size) - sizeof(*info);
++        /* Raw frames need the AudioSpecificConfig; ADTS and LOAS carry their own. */
++        par->codec_id = info->wPayloadType == 3 ? AV_CODEC_ID_AAC_LATM : AV_CODEC_ID_AAC;
++        return set_extradata(par, (const BYTE *)(info + 1), info->wPayloadType ? 0 : size);
++    }
++    case WAVE_FORMAT_RAW_AAC1:
++        par->codec_id = AV_CODEC_ID_AAC;
++        return set_extradata(par, extra, extra_size);
++    case WAVE_FORMAT_MSAUDIO1:
++        par->codec_id = AV_CODEC_ID_WMAV1;
++        return set_extradata(par, extra, extra_size);
++    case WAVE_FORMAT_WMAUDIO2:
++        par->codec_id = AV_CODEC_ID_WMAV2;
++        return set_extradata(par, extra, extra_size);
++    case WAVE_FORMAT_WMAUDIO3:
++        par->codec_id = AV_CODEC_ID_WMAPRO;
++        return set_extradata(par, extra, extra_size);
++    case WAVE_FORMAT_WMAUDIO_LOSSLESS:
++        par->codec_id = AV_CODEC_ID_WMALOSSLESS;
++        return set_extradata(par, extra, extra_size);
++    default:
++        /* Any other tag a RIFF file can carry, as FFmpeg's own table knows it. */
++        if ((par->codec_id = av_codec_get_id((const struct AVCodecTag *const[]){avformat_get_riff_audio_tags(), 0},
++                tag)) == AV_CODEC_ID_NONE)
++            return false;
++        return set_extradata(par, extra, extra_size);
++    }
++}
++
++static bool video_type_to_codec(const MFVIDEOFORMAT *format, UINT32 format_size, AVCodecParameters *par)
++{
++    const GUID *subtype = &format->guidFormat;
++    const BYTE *extra = (const BYTE *)(format + 1);
++    size_t extra_size = format_size > sizeof(*format) ? format_size - sizeof(*format) : 0;
++    GUID base = *subtype;
++    UINT32 fourcc = subtype->Data1;
