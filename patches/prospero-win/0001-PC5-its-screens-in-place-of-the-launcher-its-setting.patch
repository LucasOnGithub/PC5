+/* libvulkan.prx's frame counter and screen colour (wine/ps5/pw_vulkan_radv.c),
+ * looked for once Vulkan has the display, every second until found. */
+static struct {
+    void (*hud)(int on, int corner);
+    void (*hud_tick)(void);
+    uint32_t (*screen_color)(void);
+    int hud_set;
+    uint64_t looked_at;
+} pc5_vulkan;
+static uint32_t pc5_gdi_color;
+static uint64_t pc5_light_at, pc5_gdi_at, pc5_pulse_until;
+
+static void pc5_vulkan_find(const PwPrxDescriptor *ntdll, uint64_t ms)
+{
+    void *(*wine_dlsym)(void *, const char *);
+
+    if (pc5_vulkan.hud || (pc5_vulkan.looked_at && ms - pc5_vulkan.looked_at < 1000)) return;
+    pc5_vulkan.looked_at = ms;
+    wine_dlsym = (void *(*)(void *, const char *))(uintptr_t)pw_prx_lookup(ntdll, "dlsym");
+    if (!wine_dlsym) return;
+    pc5_vulkan.hud = (void (*)(int, int))(uintptr_t)wine_dlsym(NULL, "pw_pc5_hud");
+    pc5_vulkan.hud_tick = (void (*)(void))(uintptr_t)wine_dlsym(NULL, "pw_pc5_hud_tick");
+    pc5_vulkan.screen_color = (uint32_t (*)(void))(uintptr_t)wine_dlsym(NULL, "pw_pc5_screen_color");
+    if (pc5_vulkan.hud)
+        PS5LOG_LOG("PW_WINE64 pc5 vulkan hud=%d tick=%d color=%d", pc5_vulkan.hud != NULL, pc5_vulkan.hud_tick != NULL,
+                   pc5_vulkan.screen_color != NULL);
+}
+
+/* Every tick of the game's loop: the controller, and the frame counter once
+ * the game shows something (over Vulkan's frames by libvulkan, over the
+ * title's own by the title). */
+static void pc5_game_tick(const PwPrxDescriptor *ntdll, PwPadPs5 *pad, int pad_ok, PwVideoOutPs5 *video,
+                          int video_ok, uint64_t shown, int content, uint64_t now)
+{
+    uint64_t ms = now / 1000000u;
+    int vulkan = __atomic_load_n(&display_closed, __ATOMIC_ACQUIRE);
+
+    if (!pc5_game_on) return;
+    if (vulkan) pc5_vulkan_find(ntdll, ms);
+    if (pad_ok) {
+        uint32_t screen = 0;
+        if (pc5_game.settings.light_bar == PC5_LIGHT_SCREEN && ms - pc5_light_at >= 100) {
+            pc5_light_at = ms;
+            screen = vulkan ? (pc5_vulkan.screen_color ? pc5_vulkan.screen_color() : 0) : pc5_gdi_color;
+        }
+        pc5_game_pad(&pc5_game, pad->pad_handle, ms, screen);
+        if (pc5_pulse_until && ms >= pc5_pulse_until) {
+            pc5_pulse_until = 0;
+            (void)pw_pad_ps5_vibrate(pad, 0, 0);
+        }
+    }
+    if (!content) return;
+    if (vulkan) {
+        if (pc5_vulkan.hud && !pc5_vulkan.hud_set) {
+            pc5_vulkan.hud(pc5_game.settings.fps, (int)pc5_game.settings.fps_corner);
+            pc5_vulkan.hud_set = 1;
+        }
+        if (pc5_vulkan.hud_tick && pc5_game.settings.fps) pc5_vulkan.hud_tick();
+    } else if (video_ok) {
+        pc5_game_hud(&pc5_game, video->handle, shown, ms);
+    }
+}
+
+/* A frame the title shows itself: its colour, for the light bar, ten times a second. */
+static void pc5_game_frame(const PwPresentView *view, uint64_t now)
+{
+    uint64_t ms = now / 1000000u;
+    uint32_t samples[32 * 32];
+
+    if (!pc5_game_on || pc5_game.settings.light_bar != PC5_LIGHT_SCREEN || ms - pc5_gdi_at < 100 || !view->width ||
+        !view->height)
+        return;
+    pc5_gdi_at = ms;
+    for (uint32_t y = 0; y < 32; y++)
+        for (uint32_t x = 0; x < 32; x++)
+            memcpy(&samples[y * 32 + x], view->pixels + (size_t)(view->height * (2 * y + 1) / 64) * view->stride +
+                                             (size_t)(view->width * (2 * x + 1) / 64) * 4, 4);
+    pc5_gdi_color = pw_pc5_screen_tint(samples, 32 * 32, 1);
+}
