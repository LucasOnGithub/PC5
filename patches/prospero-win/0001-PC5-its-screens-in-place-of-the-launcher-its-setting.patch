+/* The sandbox instance whose app0 holds the runtime, once /data is granted. */
+static void find_sandbox_app0(void)
+{
+    for (unsigned i = 0; i < 16; i++) {
+        char candidate[sizeof(sandbox_app0)], ntdll[sizeof(sandbox_app0) + 64];
+        struct stat st;
+
+        snprintf(candidate, sizeof(candidate), "/mnt/sandbox/" PW_TITLE_ID "_%03u/app0", i);
+        snprintf(ntdll, sizeof(ntdll), "%s" PW_WINE64_RUNTIME "/ntdll.prx", candidate);
+        if (stat(ntdll, &st) == 0) {
+            if (strcmp(candidate, sandbox_app0)) PS5LOG_LOG("PW_WINE64 sandbox app0=%s", candidate);
+            memcpy(sandbox_app0, candidate, sizeof(sandbox_app0));
+            return;
+        }
+    }
