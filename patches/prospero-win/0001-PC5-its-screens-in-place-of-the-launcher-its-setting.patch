 }
 
+/* --- PC5: the frame counter and the screen's colour --------------------------
+ * RADV's VideoOut calls are wrapped too (tools/link_radv_prx.sh). Each flip
+ * counts towards the frame counter, which the display's second hardware
+ * cursor shows, updated once a second, while PC5 asks for it (pw_pc5_hud).
+ * The framebuffers RADV registers are remembered, so the colour of the one
+ * on screen can be read for the controller's light bar (pw_pc5_screen_color):
+ * texels spread over it, which the display's tiling only puts in another
+ * order, so their average is the picture's. */
+struct pc5_videoout_buffer {
+    void *data;
+    void *metadata;
+    void *reserved[2];
+};
+extern void __real_sceVideoOutSetBufferAttribute2(void *attribute, uint64_t pixel_format, uint32_t tiling,
+                                                  uint32_t width, uint32_t height, uint64_t reserved1,
+                                                  uint32_t reserved2, uint64_t reserved3);
+extern int __real_sceVideoOutRegisterBuffers2(int32_t handle, int32_t set, int32_t start,
+                                              struct pc5_videoout_buffer *buffers, int32_t count, void *attribute,
+                                              int32_t reserved, void *option);
+extern int __real_sceVideoOutUnregisterBuffers(int32_t handle, int32_t set);
+extern int __real_sceVideoOutSubmitFlip(int32_t handle, int32_t buffer_index, uint32_t mode, int64_t argument);
+
+enum { PC5_BUFFERS = 64, PC5_SAMPLES = 1024, PC5_HUD_IMAGE = 2 };
+
+static struct {
+    int lock;
+    uint32_t width, height;                 /* the attribute being registered */
+    struct { const uint32_t *texels; uint32_t width, height; int set; } buffer[PC5_BUFFERS];
+    int shown;                              /* the buffer flipped last; -1 none */
+    int hud_on, hud_corner, hud_enabled, hud_current;
+    uint64_t flips, second_flips, second_at;
+} pc5 = { .shown = -1 };
+
+static void pc5_lock(void)
+{
+    while (__atomic_exchange_n(&pc5.lock, 1, __ATOMIC_ACQUIRE)) __builtin_ia32_pause();
+}
+
+static void pc5_unlock(void)
+{
+    __atomic_store_n(&pc5.lock, 0, __ATOMIC_RELEASE);
+}
+
+static uint64_t pc5_now_ns(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000000000u + (uint64_t)now.tv_nsec;
+}
+
+void __wrap_sceVideoOutSetBufferAttribute2(void *attribute, uint64_t pixel_format, uint32_t tiling, uint32_t width,
+                                           uint32_t height, uint64_t reserved1, uint32_t reserved2, uint64_t reserved3);
+void __wrap_sceVideoOutSetBufferAttribute2(void *attribute, uint64_t pixel_format, uint32_t tiling, uint32_t width,
+                                           uint32_t height, uint64_t reserved1, uint32_t reserved2, uint64_t reserved3)
+{
+    pc5_lock();
+    pc5.width = width;
+    pc5.height = height;
+    pc5_unlock();
+    __real_sceVideoOutSetBufferAttribute2(attribute, pixel_format, tiling, width, height, reserved1, reserved2,
+                                          reserved3);
+}
+
+int __wrap_sceVideoOutRegisterBuffers2(int32_t handle, int32_t set, int32_t start, struct pc5_videoout_buffer *buffers,
+                                       int32_t count, void *attribute, int32_t reserved, void *option);
+int __wrap_sceVideoOutRegisterBuffers2(int32_t handle, int32_t set, int32_t start, struct pc5_videoout_buffer *buffers,
+                                       int32_t count, void *attribute, int32_t reserved, void *option)
+{
+    int result = __real_sceVideoOutRegisterBuffers2(handle, set, start, buffers, count, attribute, reserved, option);
+
+    if (result == 0) {
+        pc5_lock();
+        for (int32_t i = 0; i < count; i++)
+            if (start + i >= 0 && start + i < PC5_BUFFERS) {
+                pc5.buffer[start + i].texels = buffers[i].data;
+                pc5.buffer[start + i].width = pc5.width;
+                pc5.buffer[start + i].height = pc5.height;
+                pc5.buffer[start + i].set = set;
+            }
+        pc5_unlock();
+    }
+    return result;
+}
+
+/* Forgotten before the memory can go. */
+int __wrap_sceVideoOutUnregisterBuffers(int32_t handle, int32_t set);
+int __wrap_sceVideoOutUnregisterBuffers(int32_t handle, int32_t set)
+{
+    pc5_lock();
+    for (int i = 0; i < PC5_BUFFERS; i++)
+        if (pc5.buffer[i].texels && pc5.buffer[i].set == set) {
+            pc5.buffer[i].texels = NULL;
+            if (pc5.shown == i) pc5.shown = -1;
+        }
+    pc5_unlock();
+    return __real_sceVideoOutUnregisterBuffers(handle, set);
+}
+
+/* Under the cursor's lock: the counter's image, shown or moved. */
+static void pc5_hud_show_locked(int handle, unsigned fps)
+{
+    uint32_t image[PW_PC5_HUD_SIDE * PW_PC5_HUD_SIDE], x, y;
+    uint32_t *next;
+    VkRect2D rect;
+    VkExtent2D frame = { 1920, 1080 };
+    int rc;
+
+    if (cursor_setup()) return;
+    pw_pc5_hud_draw(image, fps);
+    /* Images 2 and 3 of the cursor's memory, in turn (0 and 1 are the game's cursor's). */
+    next = cursor.images + (PC5_HUD_IMAGE + (pc5.hud_enabled ? (pc5.hud_current ^ 1) : pc5.hud_current)) * CURSOR_PIXELS;
+    memcpy(next, image, sizeof(image));
+#if defined(__PROSPERO__)
+    for (size_t at = 0; at < sizeof(image); at += 64) _mm_clflush((const uint8_t *)next + at);
+    _mm_mfence();
+#endif
+    rc = pc5.hud_enabled ? sceVideoOutCursorSetImageAddress(handle, 1, next) : sceVideoOutCursorEnable(handle, 1, next);
+    if (rc != 0) return;
+    pc5.hud_current = (int)((next - cursor.images) / CURSOR_PIXELS) - PC5_HUD_IMAGE;
+    pc5.hud_enabled = 1;
+    if (!wsi_videoout_present_rect(&rect, &frame) || !frame.width || !frame.height) frame = (VkExtent2D){ 1920, 1080 };
+    pw_pc5_hud_place(pc5.hud_corner, frame.width, frame.height, &x, &y);
+    sceVideoOutCursorSetPosition(handle, 1, x, y);
+}
+
+/* RADV flips with its output's lock held, so only the count is kept here:
+ * the counter is drawn from the title's loop (pw_pc5_hud_tick), which takes
+ * the cursor's lock before RADV's, as pw_videoout_cursor does. */
+int __wrap_sceVideoOutSubmitFlip(int32_t handle, int32_t buffer_index, uint32_t mode, int64_t argument);
+int __wrap_sceVideoOutSubmitFlip(int32_t handle, int32_t buffer_index, uint32_t mode, int64_t argument)
+{
+    int result = __real_sceVideoOutSubmitFlip(handle, buffer_index, mode, argument);
+
+    if (result == 0) {
+        pc5_lock();
+        pc5.shown = buffer_index;
+        pc5.flips++;
+        pc5_unlock();
+    }
+    return result;
+}
+
+/* PC5 turns the counter on, in a corner (pw_pc5_hud.h), or off. */
+void pw_pc5_hud(int on, int corner);
+void pw_pc5_hud(int on, int corner)
+{
+    int handle = __atomic_load_n(&videoout_handle, __ATOMIC_ACQUIRE);
+
+    pc5_lock();
+    pc5.hud_corner = corner;
+    pc5.second_at = 0;
+    pc5.hud_on = on;
+    pc5_unlock();
+    if (!on && handle >= 0) {
+        cursor_lock();
+        if (pc5.hud_enabled) sceVideoOutCursorDisable(handle, 1);
+        pc5.hud_enabled = 0;
+        cursor_unlock();
+    }
+}
+
+/* From the title's loop: the counter, once a second, with the frames shown
+ * since. */
+void pw_pc5_hud_tick(void);
+void pw_pc5_hud_tick(void)
+{
+    int handle = __atomic_load_n(&videoout_handle, __ATOMIC_ACQUIRE), show = 0;
+    unsigned fps = 0;
+    uint64_t now = pc5_now_ns();
+
+    if (handle < 0) return;
+    pc5_lock();
+    if (pc5.hud_on) {
+        if (!pc5.second_at) {
+            pc5.second_at = now;
+            pc5.second_flips = pc5.flips;
+            show = !pc5.hud_enabled;
+        } else if (now - pc5.second_at >= 1000000000u) {
+            fps = (unsigned)(((pc5.flips - pc5.second_flips) * 1000000000u + (now - pc5.second_at) / 2) /
+                             (now - pc5.second_at));
+            pc5.second_at = now;
+            pc5.second_flips = pc5.flips;
+            show = 1;
+        }
+    }
+    pc5_unlock();
+    if (show) {
+        cursor_lock();
+        pc5_hud_show_locked(handle, fps);
+        cursor_unlock();
+    }
+}
+
+/* The colour of the frame on screen as 0xffRRGGBB for the light bar, or 0
+ * when there is none to read. */
+uint32_t pw_pc5_screen_color(void);
+uint32_t pw_pc5_screen_color(void)
+{
+    uint32_t color = 0;
+
+    pc5_lock();
+    if (pc5.shown >= 0 && pc5.shown < PC5_BUFFERS && pc5.buffer[pc5.shown].texels) {
+        const uint32_t *texels = pc5.buffer[pc5.shown].texels;
+        uint64_t count = (uint64_t)pc5.buffer[pc5.shown].width * pc5.buffer[pc5.shown].height;
+        unsigned step = count >= PC5_SAMPLES ? (unsigned)(count / PC5_SAMPLES) : 1;
+        unsigned samples = count >= PC5_SAMPLES ? PC5_SAMPLES : (unsigned)count;
+#if defined(__PROSPERO__)
+        /* The GPU wrote them to memory: no stale lines from the CPU's cache. */
+        for (unsigned i = 0; i < samples; i++) _mm_clflush(texels + (uint64_t)i * step);
+        _mm_mfence();
+#endif
+        color = pw_pc5_screen_tint(texels, samples, step);
+    }
+    pc5_unlock();
+    return color;
+}
