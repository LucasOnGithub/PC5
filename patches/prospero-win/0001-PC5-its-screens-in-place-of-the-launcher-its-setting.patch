diff --git a/wine/ps5/pw_pc5_hud.h b/wine/ps5/pw_pc5_hud.h
new file mode 100644
index 0000000..4bf1af2
--- /dev/null
+++ b/wine/ps5/pw_pc5_hud.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* PC5's frame counter (PW_PC5): a 64x64 straight-alpha ARGB image for
+ * VideoOut's second hardware cursor, which the display composes over
+ * whatever it shows, so the counter looks the same over every game,
+ * whatever it draws with, and costs the game nothing. Drawn by
+ * pw_vulkan_radv.c over a swapchain's frames and by the title over the
+ * frames it shows itself. */
+#ifndef PW_PC5_HUD_H
+#define PW_PC5_HUD_H
+#include <stdint.h>
+#include <string.h>
+
+enum { PW_PC5_HUD_SIDE = 64, PW_PC5_HUD_BOX_HEIGHT = 40, PW_PC5_HUD_MARGIN = 24 };
+/* Corners, as PC5's settings number them (pc5_settings.h). */
+enum { PW_PC5_HUD_TOP_LEFT, PW_PC5_HUD_TOP_RIGHT, PW_PC5_HUD_BOTTOM_LEFT, PW_PC5_HUD_BOTTOM_RIGHT };
+
+/* 5x7 glyphs, a row a byte (bit 4 the left column): 0-9, F, P, S. */
+static const uint8_t pw_pc5_hud_glyphs[13][7] = {
+    { 0x0e, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0e }, { 0x04, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x0e },
+    { 0x0e, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1f }, { 0x1e, 0x01, 0x01, 0x0e, 0x01, 0x01, 0x1e },
+    { 0x02, 0x06, 0x0a, 0x12, 0x1f, 0x02, 0x02 }, { 0x1f, 0x10, 0x1e, 0x01, 0x01, 0x11, 0x0e },
+    { 0x06, 0x08, 0x10, 0x1e, 0x11, 0x11, 0x0e }, { 0x1f, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 },
+    { 0x0e, 0x11, 0x11, 0x0e, 0x11, 0x11, 0x0e }, { 0x0e, 0x11, 0x11, 0x0f, 0x01, 0x02, 0x0c },
+    { 0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x10 }, { 0x1e, 0x11, 0x11, 0x1e, 0x10, 0x10, 0x10 },
+    { 0x0f, 0x10, 0x10, 0x0e, 0x01, 0x01, 0x1e },
+};
+
+static inline void pw_pc5_hud_glyph(uint32_t *image, int x, int y, int glyph, int scale, uint32_t color)
+{
+    for (int row = 0; row < 7; row++)
+        for (int column = 0; column < 5; column++)
+            if (pw_pc5_hud_glyphs[glyph][row] & (0x10 >> column))
+                for (int dy = 0; dy < scale; dy++)
+                    for (int dx = 0; dx < scale; dx++) {
+                        int px = x + column * scale + dx, py = y + row * scale + dy;
+                        if (px >= 0 && px < PW_PC5_HUD_SIDE && py >= 0 && py < PW_PC5_HUD_SIDE)
+                            image[py * PW_PC5_HUD_SIDE + px] = color;
+                    }
+}
+
+/* fps (0 to 999) in large digits over "FPS", on a dark rounded box at the
+ * top of the image. */
+static inline void pw_pc5_hud_draw(uint32_t *image, unsigned fps)
+{
+    char digits[4];
+    int count = 0, width;
+
+    memset(image, 0, PW_PC5_HUD_SIDE * PW_PC5_HUD_SIDE * 4);
+    for (int y = 0; y < PW_PC5_HUD_BOX_HEIGHT; y++)
+        for (int x = 0; x < PW_PC5_HUD_SIDE; x++) {
+            /* corners rounded to a radius of 8 */
+            int cx = x < 8 ? 8 - x : x > PW_PC5_HUD_SIDE - 9 ? x - (PW_PC5_HUD_SIDE - 9) : 0;
+            int cy = y < 8 ? 8 - y : y > PW_PC5_HUD_BOX_HEIGHT - 9 ? y - (PW_PC5_HUD_BOX_HEIGHT - 9) : 0;
+            if (cx * cx + cy * cy <= 64) image[y * PW_PC5_HUD_SIDE + x] = 0xc0101216u;
+        }
+    if (fps > 999) fps = 999;
+    do { digits[count++] = (char)(fps % 10); fps /= 10; } while (fps && count < 3);
+    width = count * 15 + (count - 1) * 3;
+    for (int i = 0; i < count; i++)
+        pw_pc5_hud_glyph(image, (PW_PC5_HUD_SIDE - width) / 2 + i * 18, 4, digits[count - 1 - i], 3, 0xffffffffu);
+    for (int i = 0; i < 3; i++)
+        pw_pc5_hud_glyph(image, (PW_PC5_HUD_SIDE - 17) / 2 + i * 6, 29, 10 + i, 1, 0xff9aa3afu);
+}
+
+/* The image's top-left corner in a frame_width x frame_height frame. */
+static inline void pw_pc5_hud_place(int corner, uint32_t frame_width, uint32_t frame_height, uint32_t *x, uint32_t *y)
+{
+    int right = corner == PW_PC5_HUD_TOP_RIGHT || corner == PW_PC5_HUD_BOTTOM_RIGHT;
+    int bottom = corner == PW_PC5_HUD_BOTTOM_LEFT || corner == PW_PC5_HUD_BOTTOM_RIGHT;
+    *x = right && frame_width > PW_PC5_HUD_SIDE + PW_PC5_HUD_MARGIN ? frame_width - PW_PC5_HUD_SIDE - PW_PC5_HUD_MARGIN
+                                                                    : PW_PC5_HUD_MARGIN;
+    *y = bottom && frame_height > PW_PC5_HUD_BOX_HEIGHT + PW_PC5_HUD_MARGIN
+             ? frame_height - PW_PC5_HUD_BOX_HEIGHT - PW_PC5_HUD_MARGIN : PW_PC5_HUD_MARGIN;
+}
+
+/* The colour of a frame for the controller's light bar, from B,G,R,X
+ * texels: their average, the saturated ones weighing more, brought to a
+ * light bar's brightness. Black stays black. */
+static inline uint32_t pw_pc5_screen_tint(const uint32_t *texels, unsigned count, unsigned step)
+{
+    uint64_t r = 0, g = 0, b = 0, weight = 0;
+    for (unsigned i = 0; i < count; i++) {
+        uint32_t c = texels[(uint64_t)i * step];
+        unsigned cr = (c >> 16) & 255, cg = (c >> 8) & 255, cb = c & 255;
+        unsigned hi = cr > cg ? (cr > cb ? cr : cb) : (cg > cb ? cg : cb);
+        unsigned lo = cr < cg ? (cr < cb ? cr : cb) : (cg < cb ? cg : cb);
+        unsigned w = 8 + (hi - lo);          /* saturation weighs */
+        r += (uint64_t)cr * w; g += (uint64_t)cg * w; b += (uint64_t)cb * w; weight += w;
+    }
+    if (!weight) return 0;
+    r /= weight; g /= weight; b /= weight;
+    uint64_t hi = r > g ? (r > b ? r : b) : (g > b ? g : b);
+    if (hi < 12) return 0;
+    /* the strongest channel to 230, the others alike */
+    r = r * 230 / hi; g = g * 230 / hi; b = b * 230 / hi;
+    return 0xff000000u | (uint32_t)r << 16 | (uint32_t)g << 8 | (uint32_t)b;
+}
+#endif
