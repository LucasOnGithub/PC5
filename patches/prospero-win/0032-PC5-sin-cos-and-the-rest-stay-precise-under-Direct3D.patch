@@ -0,0 +1,38 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 25 Oct 2026 19:30:00 +0000
+Subject: [PATCH] musl: Compute in SSE2 on i386, whatever the x87's precision.
+
+A 32-bit program can lower the x87's precision: Direct3D 9 sets it to
+24 bits when it creates a device, unless the program asks it to preserve
+it, and DXVK does the same. The musl functions msvcrt uses were built for
+the x87, so sin, cos, tan and the rest lost most of their precision with
+it: sin(1e8) gave 0.0000004, not 0.93. A large argument also sent
+__rem_pio2_large() past its arrays, overwriting the caller's stack, and
+the program crashed in sin(). Build them for SSE2, which the x87's
+precision doesn't touch.
+---
+ libs/musl/src/internal/libm.h |    9 +++++++++
+ 1 file changed, 9 insertions(+)
+
+diff --git a/libs/musl/src/internal/libm.h b/libs/musl/src/internal/libm.h
+--- a/libs/musl/src/internal/libm.h
++++ b/libs/musl/src/internal/libm.h
+@@ -1,6 +1,15 @@
+ #ifndef _LIBM_H
+ #define _LIBM_H
+ 
++#if defined(__i386__) && defined(__GNUC__) && !defined(__clang__)
++/* Double arithmetic in SSE2, not on the x87: a program can lower the x87's
++ * precision (Direct3D 9 sets 24 bits unless the device preserves it), and
++ * these functions need full double precision. With 24 bits, sin(1e8) gave
++ * 0.0000004, and a large argument sent __rem_pio2_large() past its arrays,
++ * overwriting the caller's stack. */
++#pragma GCC target("sse2,fpmath=sse")
++#endif
++
+ #include <stdint.h>
+ #include <float.h>
+ #include <math.h>
+-- 
+2.43.0
