+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Fri, 23 Oct 2026 19:30:00 +0100
+Subject: [PATCH] xaudio2: Keep an effect alive while a voice holds it.
+
+Samurai Warriors 4 DX crashed about ten minutes into a stage in
+XAPOFXParams_GetParameters, called from a voice's GetEffectParameters,
+through an effect that had already been freed.
+
+FAPOBase's reference count, which every Wine XAPO effect (reverb,
+volume meter, the XAPOFX effects) shares between the game's references
+and those its voices hold, changed with a plain += and -= while Release
+read it back afterwards. A game that attaches one effect to voices it
+creates and destroys on more than one thread loses updates between them,
+and the count reaches zero while a voice still holds the effect. It now
+changes atomically, as XAPOBase's does on Windows (InterlockedIncrement).
+
+A source or submix voice that FAudio failed to create kept the effect
+chain it had freed, and a mastering voice refused because one is in use
+leaked its chain: the chain is cleared, and freed, in both.
+---
+ dlls/xaudio2_7/xaudio_dll.c |  7 +++++--
+ libs/faudio/src/FAPOBase.c  | 15 +++++++++------
+ 2 files changed, 14 insertions(+), 8 deletions(-)
+
+diff --git a/dlls/xaudio2_7/xaudio_dll.c b/dlls/xaudio2_7/xaudio_dll.c
+index 2c42a99..cea309e 100644
+--- a/dlls/xaudio2_7/xaudio_dll.c
++++ b/dlls/xaudio2_7/xaudio_dll.c
+@@ -1655,8 +1655,9 @@ static HRESULT WINAPI IXAudio2Impl_CreateSourceVoice(IXAudio2 *iface,
+             src->effect_chain);
+     free_voice_sends(faudio_sends);
+     if(FAILED(hr)){
+-        LeaveCriticalSection(&src->lock);
+         free_effect_chain(src->effect_chain);
++        src->effect_chain = NULL;
++        LeaveCriticalSection(&src->lock);
+         return hr;
+     }
+     src->in_use = TRUE;
+@@ -1717,8 +1718,9 @@ static HRESULT WINAPI IXAudio2Impl_CreateSubmixVoice(IXAudio2 *iface,
+             sub->effect_chain);
+     free_voice_sends(faudio_sends);
+     if(FAILED(hr)){
+-        LeaveCriticalSection(&sub->lock);
+         free_effect_chain(sub->effect_chain);
++        sub->effect_chain = NULL;
++        LeaveCriticalSection(&sub->lock);
+         return hr;
+     }
+     sub->in_use = TRUE;
+@@ -1767,6 +1769,7 @@ static HRESULT WINAPI IXAudio2Impl_CreateMasteringVoice(IXAudio2 *iface,
+     if(This->mst.in_use){
+         LeaveCriticalSection(&This->mst.lock);
+         LeaveCriticalSection(&This->lock);
++        free_effect_chain(chain);
+         return COMPAT_E_INVALID_CALL;
+     }
+ 
+diff --git a/libs/faudio/src/FAPOBase.c b/libs/faudio/src/FAPOBase.c
+index 27a98e1..289445b 100644
+--- a/libs/faudio/src/FAPOBase.c
++++ b/libs/faudio/src/FAPOBase.c
+@@ -104,21 +104,24 @@ void CreateFAPOBaseWithCustomAllocatorEXT(
+ 	fapo->m_lReferenceCount = 1;
+ }
+ 
++/* The count changes atomically, as XAPOBase's does with InterlockedIncrement:
++ * a game can attach one effect to voices it creates and destroys on several
++ * threads, and an update lost between them frees the effect while a voice
++ * still holds it.
++ */
+ int32_t FAPOBase_AddRef(FAPOBase *fapo)
+ {
+-	fapo->m_lReferenceCount += 1;
+-	return fapo->m_lReferenceCount;
++	return __atomic_add_fetch(&fapo->m_lReferenceCount, 1, __ATOMIC_SEQ_CST);
+ }
+ 
+ int32_t FAPOBase_Release(FAPOBase *fapo)
+ {
+-	fapo->m_lReferenceCount -= 1;
+-	if (fapo->m_lReferenceCount == 0)
++	int32_t ref = __atomic_sub_fetch(&fapo->m_lReferenceCount, 1, __ATOMIC_SEQ_CST);
++	if (ref == 0)
+ 	{
+ 		fapo->Destructor(fapo);
+-		return 0;
+ 	}
+-	return fapo->m_lReferenceCount;
++	return ref;
+ }
+ 
+ uint32_t FAPOBase_GetRegistrationProperties(
