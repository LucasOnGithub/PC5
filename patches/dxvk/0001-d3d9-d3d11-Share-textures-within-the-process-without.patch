+  Rc<DxvkDevice> D3D9InterfaceEx::ShareD3D11Device(
+    const Rc<DxvkAdapter>&  Adapter,
+          DWORD             BehaviorFlags) {
+    // Only where textures cannot be shared through memory handles, for a
+    // D3D9Ex device, the kind that shares textures with D3D11.
+    if (!m_extended || Adapter->features().khrExternalMemoryWin32
+     || !m_instance->config().getOption<bool>("d3d9.shareD3D11Device", true))
+      return nullptr;
+
+    Rc<DxvkDevice> device = local_share::findDevice(Adapter->devicePropertiesExt().vk11.deviceUUID);
+
+    if (device == nullptr)
+      return nullptr;
+
+    // What D3D9 needs and D3D11 may not have enabled
+    const DxvkDeviceFeatures& features = device->features();
+    bool usable = features.core.features.geometryShader
+               && features.core.features.robustBufferAccess
+               && features.core.features.imageCubeArray
+               && features.core.features.depthClamp
+               && features.core.features.depthBiasClamp
+               && features.core.features.fillModeNonSolid
+               && features.core.features.sampleRateShading
+               && features.core.features.shaderClipDistance
+               && features.core.features.shaderCullDistance
+               && features.core.features.textureCompressionBC
+               && features.core.features.occlusionQueryPrecise
+               && features.core.features.multiViewport
+               && features.core.features.independentBlend
+               && features.core.features.fullDrawIndexUint32
+               && features.vk12.samplerMirrorClampToEdge
+               && features.vk13.shaderDemoteToHelperInvocation;
+
+    // Software vertex processing runs on the GPU: it needs these two
+    if (BehaviorFlags & (D3DCREATE_SOFTWARE_VERTEXPROCESSING | D3DCREATE_MIXED_VERTEXPROCESSING))
+      usable &= features.core.features.vertexPipelineStoresAndAtomics && features.vk12.shaderInt8;
+
+    if (!usable) {
+      Logger::info("D3D9: The Direct3D 11 device lacks features Direct3D 9 needs; not sharing it");
+      return nullptr;
+    }
+
+    // Objects made by either DLL live on in the other's device
+    local_share::pinModule(reinterpret_cast<const void*>(&local_share::pinModule));
+    local_share::pinModule(reinterpret_cast<const void*>(local_share::proc<local_share::PfnOpen>("DXVKLocalShareOpen")));
+
+    Logger::info("D3D9: Sharing the Direct3D 11 device's Vulkan device, for textures shared within the process");
+    return device;
+  }
+
