diff --git a/src/d3d11/d3d11_local_share.cpp b/src/d3d11/d3d11_local_share.cpp
new file mode 100644
index 0000000..a8824fa
--- /dev/null
+++ b/src/d3d11/d3d11_local_share.cpp
@@ -0,0 +1,120 @@
+#include <cstring>
+#include <vector>
+
+#include "d3d11_local_share.h"
+
+#include "../util/thread.h"
+
+namespace dxvk {
+
+  /* The list of util_local_share.h: live D3D11 devices' DxvkDevices, and
+   * textures shared within the process. Never freed, so that it outlives
+   * every object that refers to it, at process exit too. */
+  struct LocalShareList {
+    dxvk::mutex                      mutex;
+    std::vector<DxvkDevice*>         devices;
+    struct Image {
+      HANDLE                         handle;
+      DxvkDevice*                    device;
+      Rc<DxvkImage>                  image;
+      DxvkSharedTextureMetadata      metadata;
+    };
+    std::vector<Image>               images;
+    uint32_t                         next = 0;
+  };
+
+  static LocalShareList& list() {
+    static LocalShareList* list = new LocalShareList();
+    return *list;
+  }
+
+
+  void LocalShareAddDevice(DxvkDevice* device) {
+    std::lock_guard lock(list().mutex);
+    list().devices.push_back(device);
+  }
+
+
+  void LocalShareRemoveDevice(DxvkDevice* device) {
+    std::lock_guard lock(list().mutex);
+    auto& devices = list().devices;
+
+    for (auto i = devices.begin(); i != devices.end(); i++) {
+      if (*i == device) {
+        devices.erase(i);
+        break;
+      }
+    }
+  }
+
+}
+
+using namespace dxvk;
+
+extern "C" {
+
+  bool __cdecl DXVKLocalShareFindDevice(const uint8_t* uuid, Rc<DxvkDevice>* device) {
+    std::lock_guard lock(list().mutex);
+    auto& devices = list().devices;
+
+    for (auto i = devices.rbegin(); i != devices.rend(); i++) {
+      if (!std::memcmp((*i)->adapter()->devicePropertiesExt().vk11.deviceUUID, uuid, VK_UUID_SIZE)) {
+        *device = *i;
+        return true;
+      }
+    }
+
+    return false;
+  }
+
+
+  HANDLE __cdecl DXVKLocalShareAdd(DxvkDevice* device, const Rc<DxvkImage>* image, const DxvkSharedTextureMetadata* metadata) {
+    std::lock_guard lock(list().mutex);
+    auto& shared = list();
+
+    // Handles of their own, as D3D9 hands out (KMT handles are 32-bit), which
+    // no handle a game gets elsewhere looks like.
+    HANDLE handle = reinterpret_cast<HANDLE>(uintptr_t(0x7d900000u + 4u * (++shared.next & 0x3ffffu)));
+    shared.images.push_back({ handle, device, *image, *metadata });
+    return handle;
+  }
+
+
+  bool __cdecl DXVKLocalShareOpen(HANDLE handle, DxvkDevice* device, DxvkSharedTextureMetadata* metadata, Rc<DxvkImage>* image) {
+    std::lock_guard lock(list().mutex);
+
+    for (const auto& entry : list().images) {
+      if (entry.handle == handle) {
+        if (entry.device != device)
+          return false;
+
+        if (metadata)
+          *metadata = entry.metadata;
+
+        *image = entry.image;
+        return true;
+      }
+    }
+
+    return false;
+  }
+
+
+  void __cdecl DXVKLocalShareRemove(HANDLE handle) {
+    Rc<DxvkImage> image;
+
+    { std::lock_guard lock(list().mutex);
+      auto& images = list().images;
+
+      for (auto i = images.begin(); i != images.end(); i++) {
+        if (i->handle == handle) {
+          // Released outside the lock: the last reference frees the image.
+          image = std::move(i->image);
+          images.erase(i);
+          break;
+        }
+      }
+    }
+  }
+
+}
