diff --git a/src/util/util_local_share.h b/src/util/util_local_share.h
new file mode 100644
index 0000000..90b4031
--- /dev/null
+++ b/src/util/util_local_share.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include "util_shared_res.h"
+
+#include "../dxvk/dxvk_device.h"
+#include "../dxvk/dxvk_image.h"
+
+namespace dxvk::local_share {
+
+  /*
+   * Shared textures within one process (PC5).
+   *
+   * Without VK_KHR_external_memory_win32 (Wine on the PS5) a texture cannot
+   * be shared through a memory handle, and a game whose Direct3D 9Ex device
+   * hands a texture to its Direct3D 11 device (a movie player decoding with
+   * DXVA2) never sees it. Both devices are in the same process, so they can
+   * share the Vulkan image itself instead, once they share a Vulkan device:
+   * a D3D9Ex device made while a D3D11 device lives runs on that device's
+   * DxvkDevice (d3d9_interface.cpp), its shared textures are listed here
+   * under a handle of their own, and D3D11's OpenSharedResource takes the
+   * image from the list.
+   *
+   * The list lives in d3d11.dll, which exports these calls: d3d9.dll finds
+   * them with GetProcAddress, so both use one list, and objects pass between
+   * the two DLLs as DXGI and D3D11 already pass them (one DXVK build).
+   */
+
+  using PfnFindDevice = bool (__cdecl *)(const uint8_t* uuid, Rc<DxvkDevice>* device);
+  using PfnAdd        = HANDLE (__cdecl *)(DxvkDevice* device, const Rc<DxvkImage>* image, const DxvkSharedTextureMetadata* metadata);
+  using PfnOpen       = bool (__cdecl *)(HANDLE handle, DxvkDevice* device, DxvkSharedTextureMetadata* metadata, Rc<DxvkImage>* image);
+  using PfnRemove     = void (__cdecl *)(HANDLE handle);
+
+  template<typename Fn>
+  Fn proc(const char* name) {
+#ifdef _WIN32
+    HMODULE module = ::GetModuleHandleA("d3d11.dll");
+    return module ? reinterpret_cast<Fn>(reinterpret_cast<void*>(::GetProcAddress(module, name))) : nullptr;
+#else
+    return nullptr;
+#endif
+  }
+
+  /** The newest live D3D11 device's DxvkDevice on the adapter with this UUID, or null. */
+  inline Rc<DxvkDevice> findDevice(const uint8_t* uuid) {
+    Rc<DxvkDevice> device;
+    auto fn = proc<PfnFindDevice>("DXVKLocalShareFindDevice");
+    return fn && fn(uuid, &device) ? device : nullptr;
+  }
+
+  /** Lists device's image: its handle, or null. */
+  inline HANDLE add(DxvkDevice* device, const Rc<DxvkImage>& image, const DxvkSharedTextureMetadata& metadata) {
+    auto fn = proc<PfnAdd>("DXVKLocalShareAdd");
+    return fn ? fn(device, &image, &metadata) : nullptr;
+  }
+
+  /** The image listed under handle, when it is device's; null otherwise. */
+  inline Rc<DxvkImage> open(HANDLE handle, DxvkDevice* device, DxvkSharedTextureMetadata* metadata) {
+    Rc<DxvkImage> image;
+    auto fn = proc<PfnOpen>("DXVKLocalShareOpen");
+    return fn && fn(handle, device, metadata, &image) ? image : nullptr;
+  }
+
+  /** Takes an image off the list; those who opened it keep it. */
+  inline void remove(HANDLE handle) {
+    auto fn = proc<PfnRemove>("DXVKLocalShareRemove");
+    if (fn && handle)
+      fn(handle);
+  }
+
+  /** Keeps the module holding address loaded until the process ends: its
+   *  objects live on in the other DLL's device. */
+  inline void pinModule(const void* address) {
+#ifdef _WIN32
+    HMODULE module = nullptr;
+    ::GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+      reinterpret_cast<LPCSTR>(address), &module);
+#endif
+  }
+
+}
